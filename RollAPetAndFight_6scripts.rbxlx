PetData.Count = #PetData.Pets

-- Boss names for display in the index
PetData.BossHint = {
	["Slime King"] = "Dropped by the Slime King (boss waves)",
	["Bone Colossus"] = "Dropped by the Bone Colossus (boss waves)",
	["Inferno Drake"] = "Dropped by the Inferno Drake (boss waves)",
	["Void Titan"] = "Dropped by the Void Titan (boss waves)",
}

function PetData.Score(id)
	local p = PetData.Pets[id]
	return p.Income * 2 + p.Damage * 0.5
end

-- Returns { {Name=, Percent=, Color=}, ... } for the given luck multiplier
function PetData.Odds(luck)
	luck = math.clamp(luck or 1, 1, Config.MaxLuck)
	local total = 0
	local w = {}
	for i, r in ipairs(Config.Rarities) do
		w[i] = r.Weight * (i >= 3 and luck or 1)
		total += w[i]
	end
	local out = {}
	for i, r in ipairs(Config.Rarities) do
		out[i] = { Name = r.Name, Percent = w[i] / total * 100, Color = r.Color }
	end
	return out
end

-- Server uses this. mode = "coins" or "boss"
function PetData.Roll(rng, luck, mode)
	luck = math.clamp(luck or 1, 1, Config.MaxLuck)
	local names, weights, total = {}, {}, 0
	if mode == "boss" then
		for _, r in ipairs(Config.Rarities) do
			local bw = Config.BossRollWeights[r.Name]
			if bw then
				table.insert(names, r.Name)
				table.insert(weights, bw)
				total += bw
			end
		end
	else
		for i, r in ipairs(Config.Rarities) do
			local w = r.Weight * (i >= 3 and luck or 1)
			table.insert(names, r.Name)
			table.insert(weights, w)
			total += w
		end
	end
	local pick = rng:NextNumber() * total
	local chosen = names[#names]
	for i, w in ipairs(weights) do
		pick -= w
		if pick <= 0 then
			chosen = names[i]
			break
		end
	end
	local pool = PetData.RollPool[chosen]
	return pool[rng:NextInteger(1, #pool)]
end

return PetData
end

----------------------------------------------------------------------
-- module: PetBuilder
----------------------------------------------------------------------
Defs.PetBuilder = function()
-- Low level helpers that assemble pet models out of simple parts + accessories.

local PetBuilder = {}
PetBuilder.__index = PetBuilder

local V3, CF = Vector3.new, CFrame.new
local rad = math.rad
local BALL, BLOCK, CYL = Enum.PartType.Ball, Enum.PartType.Block, Enum.PartType.Cylinder
local SMOOTH, NEON, METAL = Enum.Material.SmoothPlastic, Enum.Material.Neon, Enum.Material.Metal
local EYE = Color3.fromRGB(28, 28, 40)
local WHITE = Color3.fromRGB(255, 255, 255)
local GOLD = Color3.fromRGB(255, 205, 70)

local function rotCF(r)
	if not r then
		return CFrame.new()
	end
	return CFrame.Angles(rad(r.X), rad(r.Y), rad(r.Z))
end

local function lighten(c, a)
	return c:Lerp(WHITE, a or 0.5)
end

function PetBuilder.new(scale, c1, c2, c3, opt, acc)
	local self = setmetatable({}, PetBuilder)
	self.s = scale
	self.c1, self.c2, self.c3 = c1, c2, c3
	self.opt = opt or {}
	self.acc = acc or ""
	self.mat = SMOOTH
	if self.opt.neon then
		self.mat = NEON
	elseif self.opt.metal then
		self.mat = METAL
	end
	self.trans = self.opt.ghostly and 0.45 or 0
	self.anims = {}
	local model = Instance.new("Model")
	model.Name = "Pet"
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = V3(0.4, 0.4, 0.4)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CastShadow = false
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root
	self.model, self.root = model, root
	return self
end

function PetBuilder:has(name)
	return string.find(self.acc, name, 1, true) ~= nil
end

-- core part creator. cf is in unscaled "pet units" relative to the root.
function PetBuilder:part(shape, size, cf, color, mat, trans, anim, className)
	local s = self.s
	local p = Instance.new(className or "Part")
	if not className then
		p.Shape = shape
	end
	p.Size = V3(math.max(size.X * s, 0.05), math.max(size.Y * s, 0.05), math.max(size.Z * s, 0.05))
	p.Color = color or self.c1
	p.Material = mat or self.mat
	p.Transparency = trans or self.trans
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local c = CF(cf.Position * s) * cf.Rotation
	p.CFrame = c
	local w = Instance.new("Weld")
	w.Part0 = self.root
	w.Part1 = p
	w.C0 = c
	w.Parent = p
	p.Parent = self.model
	if anim then
		table.insert(self.anims, {
			w = w,
			p = p,
			base = c,
			kind = anim.kind,
			amp = anim.amp or 0.4,
			speed = anim.speed or 4,
			phase = anim.phase or 0,
			hp = (anim.hp or V3(0, 0, 0)) * s,
		})
	end
	return p
end

function PetBuilder:ball(d, pos, color, mat, trans, anim)
	return self:part(BALL, V3(d, d, d), CF(pos), color, mat, trans, anim)
end

function PetBuilder:ovalCF(size, cf, color, mat, trans, anim)
	local p = self:part(BLOCK, size, cf, color, mat, trans, anim)
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	return p
end

function PetBuilder:oval(size, pos, color, rot, mat, trans, anim)
	return self:ovalCF(size, CF(pos) * rotCF(rot), color, mat, trans, anim)
end

function PetBuilder:box(size, pos, color, rot, mat, trans, anim)
	return self:part(BLOCK, size, CF(pos) * rotCF(rot), color, mat, trans, anim)
end

-- upright cylinder (axis = local Y)
function PetBuilder:cyl(h, d, pos, color, rot, mat, trans, anim)
	return self:part(CYL, V3(h, d, d), CF(pos) * rotCF(rot) * CFrame.Angles(0, 0, math.pi / 2), color, mat, trans, anim)
end

function PetBuilder:wedge(size, pos, color, rot, mat, trans)
	return self:part(nil, size, CF(pos) * rotCF(rot), color, mat, trans, nil, "WedgePart")
end

-- cone made of stacked cylinders, base at pos pointing along local +Y (rotated by rot)
function PetBuilder:cone(r, h, pos, color, rot, mat, trans, anim, n)
	n = n or 3
	local R = rotCF(rot)
	local seg = h / n
	for i = 1, n do
		local t = (i - 1) / n
		local d = math.max(r * 2 * (1 - t), 0.06)
		local cf = CF(pos) * R * CF(0, seg * (i - 0.5), 0) * CFrame.Angles(0, 0, math.pi / 2)
		self:part(CYL, V3(seg + 0.02, d, d), cf, color, mat, trans, anim)
	end
end

function PetBuilder:eyes(y, z, x, d, color)
	d = d or 0.26
	for _, s in ipairs({ -1, 1 }) do
		self:ball(d, V3(s * x, y, z), color or EYE, SMOOTH, 0)
		self:ball(d * 0.38, V3(s * x + s * d * 0.05, y + d * 0.22, z - d * 0.38), WHITE, SMOOTH, 0)
	end
end

----------------------------------------------------------------------
-- Accessories. info = {head, hr, top, back, br, bodyC, spine={y,z0,z1}, eyeX, eyeY, eyeZ}
----------------------------------------------------------------------
local Acc = {}

function Acc.horns(b, info)
	local hr = info.hr
	for _, s in ipairs({ -1, 1 }) do
		b:cone(hr * 0.17, hr * 0.75, info.top + V3(s * hr * 0.5, -hr * 0.22, 0), lighten(b.c3, 0.35), V3(0, 0, -s * 25), nil, 0)
	end
end

function Acc.crown(b, info)
	local hr = info.hr
	local top = info.top + V3(0, -0.02, 0)
	b:cyl(0.2, hr * 0.95, top, GOLD, nil, METAL, 0)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		b:cone(0.08, 0.34, top + V3(math.cos(a) * hr * 0.4, 0.08, math.sin(a) * hr * 0.4), GOLD, nil, METAL, 0, nil, 2)
	end
	b:ball(0.16, top + V3(0, 0.02, -hr * 0.47), Color3.fromRGB(255, 70, 110), NEON, 0)
end

function Acc.halo(b, info)
	local hr = info.hr
	local c = info.top + V3(0, hr * 0.55, 0)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		b:ball(0.17, c + V3(math.cos(a) * hr * 0.75, 0, math.sin(a) * hr * 0.75), Color3.fromRGB(255, 240, 160), NEON, 0, { kind = "spin", speed = 1.5, hp = c })
	end
end

function Acc.wings(b, info)
	local pairsN = b.opt.wingPairs or 1
	local br = info.br or 1
	local base = info.back or V3(0, 0.2, 0.6)
	for pr = 1, pairsN do
		local sc = 1 - (pr - 1) * 0.25
		local yo = -(pr - 1) * 0.55
		local zo = (pr - 1) * 0.5
		for _, s in ipairs({ -1, 1 }) do
			local hp = V3(s * br * 0.45, base.Y + yo, base.Z + zo)
			local anim = { kind = "flap", amp = 0.45 * s, speed = 5, phase = pr, hp = hp }
			local pos = V3(s * (br * 0.45 + 0.95 * sc), base.Y + 0.3 + yo, base.Z + zo)
			b:oval(V3(1.9 * sc, 0.1, 1.15 * sc), pos, b.c2, V3(0, 0, s * 25), nil, nil, anim)
			b:oval(V3(1.25 * sc, 0.12, 0.7 * sc), pos + V3(s * 0.2, 0.03, 0.18), b.c3, V3(0, 0, s * 25), nil, nil, anim)
		end
	end
end

function Acc.flame(b, info)
	local hr = info.hr
	local outer = b.c3
	local inner = lighten(b.c3, 0.55)
	local p = info.top + V3(0, hr * 0.2, 0)
	b:oval(V3(hr * 0.75, hr * 1.1, hr * 0.75), p + V3(0, hr * 0.25, 0), outer, nil, NEON, 0.15, { kind = "bob", amp = 0.06, speed = 6 })
	b:oval(V3(hr * 0.45, hr * 0.8, hr * 0.45), p + V3(0, hr * 0.2, 0), inner, nil, NEON, 0.1, { kind = "bob", amp = 0.05, speed = 7, phase = 1 })
	b:ball(0.14, p + V3(hr * 0.5, hr * 0.8, 0), outer, NEON, 0, { kind = "bob", amp = 0.15, speed = 4 })
end

function Acc.spikes(b, info)
	local sp = info.spine or { y = 0.2, z0 = 0.1, z1 = 1.1 }
	for i = 0, 4 do
		local z = sp.z0 + (sp.z1 - sp.z0) * i / 4
		local sc = 0.7 + 0.5 * math.sin(i / 4 * math.pi)
		b:cone(0.12 * sc, 0.45 * sc, V3(0, sp.y - 0.05 * i, z), b.c3, V3(-10, 0, 0), nil, 0, nil, 2)
	end
end

function Acc.aura(b, info)
	local d = (info.br or 1) * 2 + 1.6
	b:ball(d, info.bodyC or V3(0, 0, 0), b.c3, NEON, 0.86, { kind = "bob", amp = 0.04, speed = 2 })
end

function Acc.orbs(b, info, arg)
	local n = tonumber(arg) or 3
	local R = (info.br or 1) * 1.7 + 0.5
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		local col = (i % 2 == 0) and b.c3 or b.c2
		b:ball(0.28, V3(math.cos(a) * R, 0.3 + math.sin(a * 2) * 0.35, math.sin(a) * R), col, NEON, 0, { kind = "spin", speed = 1.3, hp = V3(0, 0, 0) })
	end
end

function Acc.scarf(b, info)
	local hr = info.hr
	local h = info.head
	b:cyl(0.3, hr * 1.3, h + V3(0, -hr * 0.72, 0.05), b.c3, nil, SMOOTH, 0)
	b:box(V3(0.28, 0.8, 0.1), h + V3(hr * 0.5, -hr * 1.2, hr * 0.3), b.c3, V3(0, 0, 8), SMOOTH, 0)
end

function Acc.hat(b, info, kind)
	local hr = info.hr
	local top = info.top
	if kind == "wizard" then
		local col = Color3.fromRGB(110, 70, 200)
		b:cone(hr * 0.55, hr * 1.3, top + V3(0, -0.1, 0), col, V3(-8, 0, 0), SMOOTH, 0)
		b:cyl(0.08, hr * 1.5, top + V3(0, -0.1, 0), col, nil, SMOOTH, 0)
		b:ball(0.14, top + V3(0, hr * 0.5, -0.1), Color3.fromRGB(255, 230, 90), NEON, 0)
	elseif kind == "top" then
		b:cyl(hr * 0.75, hr * 0.8, top + V3(0, hr * 0.3, 0), Color3.fromRGB(30, 30, 38), nil, SMOOTH, 0)
		b:cyl(0.07, hr * 1.25, top + V3(0, -0.02, 0), Color3.fromRGB(30, 30, 38), nil, SMOOTH, 0)
		b:cyl(0.12, hr * 0.82, top + V3(0, hr * 0.12, 0), Color3.fromRGB(200, 40, 50), nil, SMOOTH, 0)
	elseif kind == "pirate" then
		local dark = Color3.fromRGB(35, 30, 40)
		b:oval(V3(hr * 2, hr * 0.55, hr * 1.1), top + V3(0, 0.0, 0), dark, V3(0, 0, 0), SMOOTH, 0)
		b:oval(V3(hr * 0.6, hr * 0.6, 0.1), top + V3(0, 0.0, -hr * 0.52), WHITE, nil, SMOOTH, 0)
		b:box(V3(hr * 1.6, 0.06, 0.06), top + V3(0, -0.12, -hr * 0.4), GOLD, nil, METAL, 0)
	elseif kind == "knight" then
		local steel = Color3.fromRGB(170, 180, 195)
		b:cyl(hr * 0.7, hr * 1.12, top + V3(0, -hr * 0.1, 0), steel, nil, METAL, 0)
		b:box(V3(hr * 0.8, 0.1, 0.06), top + V3(0, -hr * 0.2, -hr * 0.56), Color3.fromRGB(40, 40, 50), nil, SMOOTH, 0)
		b:cone(0.12, 0.45, top + V3(0, hr * 0.25, 0), Color3.fromRGB(220, 50, 60), nil, SMOOTH, 0, nil, 2)
	end
end

function Acc.band(b, info)
	local hr = info.hr
	local h = info.head
	b:cyl(0.22, hr * 1.97, h + V3(0, hr * 0.3, 0), b.c2, nil, SMOOTH, 0)
	b:box(V3(0.25, 0.1, 0.5), h + V3(hr * 0.3, hr * 0.3, hr * 1.0), b.c2, V3(0, 20, 0), SMOOTH, 0)
	b:box(V3(0.25, 0.1, 0.5), h + V3(-hr * 0.1, hr * 0.28, hr * 1.1), b.c2, V3(0, -15, 10), SMOOTH, 0)
end

function Acc.glasses(b, info)
	local hr = info.hr
	local x = info.eyeX or hr * 0.4
	local y = info.eyeY or info.head.Y
	local z = (info.eyeZ or (info.head.Z - hr)) - 0.06
	for _, s in ipairs({ -1, 1 }) do
		b:cyl(0.08, hr * 0.62, V3(s * x, y, z), Color3.fromRGB(20, 20, 30), V3(90, 0, 0), SMOOTH, 0.15)
		b:cyl(0.1, hr * 0.7, V3(s * x, y, z + 0.01), b.c2, V3(90, 0, 0), NEON, 0.2)
	end
	b:box(V3(x, 0.07, 0.07), V3(0, y, z), b.c2, nil, NEON, 0)
end

function Acc.gem(b, info)
	local hr = info.hr
	local p = info.head + V3(0, hr * 0.5, -hr * 0.88)
	b:box(V3(0.26, 0.26, 0.12), p, b.c3, V3(0, 0, 45), NEON, 0)
end

function Acc.armor(b, info)
	local br = info.br or 1
	local c = info.bodyC or V3(0, 0, 0)
	local steel = Color3.fromRGB(165, 175, 190)
	b:oval(V3(br * 1.5, br * 1.2, br * 0.55), c + V3(0, 0, -br * 0.62), steel, nil, METAL, 0)
	for _, s in ipairs({ -1, 1 }) do
		b:ball(br * 0.6, c + V3(s * br * 0.85, br * 0.4, 0), steel, METAL, 0)
	end
end

function Acc.antenna(b, info)
	local top = info.top
	b:cyl(0.6, 0.07, top + V3(0, 0.25, 0), Color3.fromRGB(150, 150, 160), nil, METAL, 0)
	b:ball(0.2, top + V3(0, 0.6, 0), b.c3, NEON, 0, { kind = "bob", amp = 0.08, speed = 5 })
end

function Acc.lightning(b, info)
	local base = info.bolt or (info.top + V3(0, 0.35, 0))
	local yel = Color3.fromRGB(255, 235, 70)
	for _, s in ipairs({ -1, 1 }) do
		local o = base + V3(s * 0.7, 0, 0)
		local anim = { kind = "bob", amp = 0.08, speed = 9, phase = s }
		b:box(V3(0.1, 0.4, 0.1), o + V3(0, 0.2, 0), yel, V3(0, 0, 25 * s), NEON, 0, anim)
		b:box(V3(0.1, 0.35, 0.1), o + V3(-0.07 * s, -0.1, 0), yel, V3(0, 0, -25 * s), NEON, 0, anim)
		b:box(V3(0.1, 0.3, 0.1), o + V3(0.0, -0.35, 0), yel, V3(0, 0, 20 * s), NEON, 0, anim)
	end
end

function Acc.crystals(b, info)
	local sp = info.spine or { y = 0.4, z0 = 0.1, z1 = 1.0 }
	for i = 0, 2 do
		local z = sp.z0 + (sp.z1 - sp.z0) * i / 2
		local h = 0.9 - i * 0.2
		b:box(V3(0.26, h, 0.26), V3(((i % 2) - 0.5) * 0.35, sp.y + h * 0.4, z), b.c3, V3(15 * (i - 1), 30 * i, 20 * (1 - i)), NEON, 0.15)
	end
end

function Acc.cape(b, info)
	local br = info.br or 1
	local c = info.bodyC or V3(0, 0, 0)
	b:box(V3(br * 1.5, br * 2, 0.08), c + V3(0, -0.1, br * 0.95), b.c3, V3(8, 0, 0), SMOOTH, 0, { kind = "wag", amp = 0.15, speed = 3, hp = c + V3(0, br, br * 0.9) })
end

-- Applies a comma separated accessory string like "horns,wings,orbs:5"
function PetBuilder.applyAccessories(b, info, accString)
	for token in string.gmatch(accString or "", "[^,]+") do
		local name, arg = string.match(token, "^([%w]+):?(.*)$")
		local fn = Acc[name]
		if fn then
			fn(b, info, arg ~= "" and arg or nil)
		end
	end
end

PetBuilder.Colors = { EYE = EYE, WHITE = WHITE, GOLD = GOLD }
PetBuilder.lighten = lighten

return PetBuilder
end

----------------------------------------------------------------------
-- module: PetModels
----------------------------------------------------------------------
Defs.PetModels = function()
-- Public API for building pet models (used by the pet followers and every UI icon).

local Config = Mod("Config")
local PetData = Mod("PetData")
local PB = Mod("PetBuilder")
local ArchA = Mod("PetArchA")
local ArchB = Mod("PetArchB")

local Arch = {}
for k, v in pairs(ArchA) do
	Arch[k] = v
end
for k, v in pairs(ArchB) do
	Arch[k] = v
end

local PetModels = {}
local Anims = setmetatable({}, { __mode = "k" })
local V3 = Vector3.new

-- Builds a fresh model. Root part is anchored; all other parts are welded to it.
function PetModels.Build(petId, noParticles)
	local pet = PetData.Pets[petId]
	local c = pet.Colors
	local b = PB.new(pet.Size, Color3.fromHex(c[1]), Color3.fromHex(c[2]), Color3.fromHex(c[3]), pet.Opt, pet.Acc)
	local fn = Arch[pet.Arch] or Arch.blob
	local info = fn(b)
	PB.applyAccessories(b, info, pet.Acc)
	if pet.Opt.lava and pet.Arch ~= "rock" and pet.Arch ~= "dragon" then
		local bc = info.bodyC or V3(0, 0, 0)
		for _, o in ipairs({ V3(0.5, 0.4, -0.4), V3(-0.5, 0.2, -0.5), V3(0.3, -0.3, -0.6), V3(-0.4, 0.5, 0.3) }) do
			b:ball(0.22, bc + o * (info.br or 1), b.c3, Enum.Material.Neon, 0)
		end
	end
	local model = b.model
	model.Name = pet.Name
	model:SetAttribute("PetId", petId)
	Anims[model] = b.anims
	local cf, size = model:GetBoundingBox()
	model:SetAttribute("Bottom", -(cf.Position.Y - size.Y / 2))
	model:SetAttribute("Radius", size.Magnitude / 2)
	if not noParticles and pet.RarityIndex >= 5 then
		local e = Instance.new("ParticleEmitter")
		e.Name = "Sparkle"
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Rate = ({ 6, 10, 14, 20 })[pet.RarityIndex - 4]
		e.Lifetime = NumberRange.new(0.8, 1.4)
		e.Speed = NumberRange.new(0.5, 1.5)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5 * pet.Size), NumberSequenceKeypoint.new(1, 0) })
		e.Color = ColorSequence.new(Config.Rarities[pet.RarityIndex].Color)
		e.LightEmission = 1
		e.Acceleration = V3(0, 2, 0)
		e.Parent = model.PrimaryPart
	end
	return model
end

-- Animates wings / tails / orbs. Works inside ViewportFrames and the workspace.
function PetModels.Animate(model, t)
	local list = Anims[model]
	if not list then
		return
	end
	local rootCF = model.PrimaryPart.CFrame
	for _, a in ipairs(list) do
		local k = a.kind
		local c0
		if k == "bob" then
			c0 = CFrame.new(0, math.sin(t * a.speed + a.phase) * a.amp, 0) * a.base
		else
			local off
			if k == "flap" then
				off = CFrame.Angles(0, 0, math.sin(t * a.speed + a.phase) * a.amp)
			elseif k == "wag" then
				off = CFrame.Angles(0, math.sin(t * a.speed + a.phase) * a.amp, 0)
			else -- spin
				off = CFrame.Angles(0, t * a.speed, 0)
			end
			c0 = CFrame.new(a.hp) * off * CFrame.new(-a.hp) * a.base
		end
		a.w.C0 = c0
		a.p.CFrame = rootCF * c0
	end
end

-- Returns a ViewportFrame showing the pet (and the model so callers can spin it)
function PetModels.Viewport(petId)
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundTransparency = 1
	vp.Size = UDim2.fromScale(1, 1)
	vp.Ambient = Color3.fromRGB(175, 175, 190)
	vp.LightColor = Color3.fromRGB(255, 250, 240)
	vp.LightDirection = V3(-0.5, -1, -0.8)
	local model = PetModels.Build(petId, true)
	model.Parent = vp
	local cf, size = model:GetBoundingBox()
	local cam = Instance.new("Camera")
	cam.FieldOfView = 35
	local center = cf.Position
	cam.CFrame = CFrame.lookAt(center + V3(0.5, 0.3, -1).Unit * size.Magnitude * 1.55, center)
	cam.Parent = vp
	vp.CurrentCamera = cam
	return vp, model
end

return PetModels
end

return {
	Get = Mod,
	Has = function(n)
		return Defs[n] ~= nil
	end,
}
]]></ProtectedString></Properties>
</Item>
<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">GameSharedArt</string><ProtectedString name="Source"><![CDATA[-- ModuleScript named "GameSharedArt"
-- Location: ReplicatedStorage > GameSharedArt
-- Pet model archetypes (the 100 procedural pet designs).

local Defs, Cache = {}, {}
local Finders = {
	function() return require(game:GetService("ReplicatedStorage"):WaitForChild("GameShared")) end,
}

local function Mod(name)
	local c = Cache[name]
	if c == nil then
		local f = Defs[name]
		if f then
			c = f()
		else
			for _, find in ipairs(Finders) do
				local b = find()
				if b.Has(name) then
					c = b.Get(name)
					break
				end
			end
		end
		if c == nil then
			error("Unknown module: " .. tostring(name))
		end
		Cache[name] = c
	end
	return c
end

----------------------------------------------------------------------
-- module: PetArchA
----------------------------------------------------------------------
Defs.PetArchA = function()
-- Archetypes (part 1): four legged animals, dragons, horses and slimes.

local PB = Mod("PetBuilder")
local V3 = Vector3.new
local C = PB.Colors
local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon

local A = {}

local function whiskers(b, hp, hr, sc)
	for _, s in ipairs({ -1, 1 }) do
		for k = -1, 1 do
			b:box(V3(0.55 * sc, 0.03, 0.03), hp + V3(s * hr * 0.8, -hr * 0.28 + k * 0.1, -hr * 0.75), C.WHITE, V3(0, s * 20, k * s * 10), SMOOTH, 0)
		end
	end
end

-- builds one head (center hp, scale sc)
local function head(b, p, hp, sc)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	local hd = (p.hd or 1.7) * sc
	local hr = hd / 2
	b:ball(hd, hp, p.headColor or c1)
	local ec = p.earColor or c1
	local es = (p.earScale or 1) * sc
	for _, s in ipairs({ -1, 1 }) do
		local ear = p.ear
		if ear == "cone" then
			b:cone(0.3 * es, 0.7 * es, hp + V3(s * hr * 0.62, hr * 0.72, 0.05), ec, V3(0, 0, -s * 18))
			b:cone(0.17 * es, 0.45 * es, hp + V3(s * hr * 0.62, hr * 0.72, -0.08 * sc), p.innerEar or c2, V3(0, 0, -s * 18), nil, nil, nil, 2)
		elseif ear == "round" then
			b:ball(0.62 * es, hp + V3(s * hr * 0.72, hr * 0.8, 0.05), ec)
			b:ball(0.36 * es, hp + V3(s * hr * 0.72, hr * 0.8, -0.1 * sc), p.innerEar or c2)
		elseif ear == "long" then
			b:cyl(1.5 * sc, 0.38 * sc, hp + V3(s * 0.33 * sc, hr + 0.5 * sc, 0.1), ec, V3(0, 0, -s * 8))
			b:cyl(1.2 * sc, 0.2 * sc, hp + V3(s * 0.33 * sc + s * 0.02, hr + 0.5 * sc, -0.07), c2, V3(0, 0, -s * 8))
		elseif ear == "floppy" then
			b:oval(V3(0.4 * sc, 0.95 * sc, 0.45 * sc), hp + V3(s * (hr + 0.02 * sc), 0.0, 0.05), c3, V3(0, 0, s * 12))
		elseif ear == "tiny" then
			b:cone(0.22 * sc, 0.4 * sc, hp + V3(s * hr * 0.65, hr * 0.78, -0.05), c1, V3(-25, 0, -s * 25), nil, nil, nil, 2)
		elseif ear == "horn" then
			b:oval(V3(0.65 * sc, 0.2, 0.35 * sc), hp + V3(s * (hr + 0.28 * sc), hr * 0.35, 0.05), c1, V3(0, 0, s * 12))
			b:cone(0.13 * sc, 0.5 * sc, hp + V3(s * hr * 0.5, hr * 0.85, 0), Color3.fromRGB(245, 235, 205), V3(0, 0, -s * 20), nil, nil, nil, 2)
		end
	end
	local sc2 = p.snoutColor or c2
	local sn = p.snout
	if sn == "short" then
		b:ball(0.6 * sc, hp + V3(0, -hr * 0.32, -hr * 0.82), sc2)
		b:ball(0.22 * sc, hp + V3(0, -hr * 0.1, -hr * 1.08), C.EYE)
	elseif sn == "long" then
		b:oval(V3(0.6 * sc, 0.55 * sc, 1.0 * sc), hp + V3(0, -hr * 0.3, -hr * 0.95), sc2)
		b:ball(0.24 * sc, hp + V3(0, -hr * 0.16, -hr * 1.5), C.EYE)
	elseif sn == "pig" then
		b:cyl(0.3 * sc, 0.75 * sc, hp + V3(0, -hr * 0.25, -hr * 0.97), sc2, V3(90, 0, 0))
		for _, sx in ipairs({ -1, 1 }) do
			b:ball(0.12 * sc, hp + V3(sx * 0.14 * sc, -hr * 0.25, -hr * 0.97 - 0.17 * sc), C.EYE)
		end
	elseif sn == "croc" then
		b:box(V3(0.95 * sc, 0.38 * sc, 1.5 * sc), hp + V3(0, -hr * 0.25, -hr * 1.15), p.headColor or c1)
		b:box(V3(0.85 * sc, 0.22 * sc, 1.35 * sc), hp + V3(0, -hr * 0.55, -hr * 1.1), c2)
		for _, sx in ipairs({ -1, 1 }) do
			b:ball(0.1 * sc, hp + V3(sx * 0.25 * sc, -hr * 0.1, -(hr * 1.15 + 0.7 * sc)), C.EYE)
		end
	end
	if not p.noEyes then
		b:eyes(hp.Y + hr * 0.12, hp.Z - hr * 0.88, hr * 0.42, 0.26 * sc, p.eyeColor)
	end
end

local function quad(b, p)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	local bd = p.bd or 1.5
	local bodyC = V3(0, -0.55, 0.45)
	b:ball(bd, bodyC, p.bodyColor or c1)
	if p.belly then
		b:oval(V3(bd * 0.62, bd * 0.7, 0.45), V3(0, -0.68, -0.1), c2)
	end
	local paw = p.paw or c1
	for _, s in ipairs({ -1, 1 }) do
		b:oval(V3(0.5, 0.45, 0.65), V3(s * 0.42, -1.2, -0.1), paw)
		b:oval(V3(0.52, 0.45, 0.65), V3(s * 0.45, -1.2, 1.0), paw)
	end
	local hp = V3(0, 0.45, -0.25)
	local hr = (p.hd or 1.7) / 2
	head(b, p, hp, 1)
	if p.heads == 3 then
		for _, s in ipairs({ -1, 1 }) do
			head(b, p, hp + V3(s * 1.25, -0.15, 0.2), 0.7)
		end
	end
	local tb = V3(0, -0.3, 1.1)
	local tail = p.tail
	if tail == "curl" then
		local pts = { V3(0, -0.35, 1.2), V3(0, 0.0, 1.45), V3(0, 0.4, 1.5), V3(0, 0.75, 1.35) }
		local ds = { 0.38, 0.34, 0.3, 0.27 }
		for i, v in ipairs(pts) do
			b:ball(ds[i], v, c1, nil, nil, { kind = "wag", amp = 0.35, speed = 5, phase = i * 0.3, hp = tb })
		end
		if p.tuft then
			b:ball(0.42, V3(0, 1.05, 1.3), p.tuft, nil, nil, { kind = "wag", amp = 0.35, speed = 5, phase = 1.5, hp = tb })
		end
	elseif tail == "bushy" then
		local n = p.tails or 1
		for i = 1, n do
			local ang = (i - (n + 1) / 2) * 28
			local base = CFrame.new(tb) * CFrame.Angles(0, math.rad(ang), 0)
			local mid = base * CFrame.new(0, 0.3, 0.9) * CFrame.Angles(math.rad(-30), 0, 0)
			local anim = { kind = "wag", amp = 0.3, speed = 3, phase = i, hp = tb }
			b:ovalCF(V3(0.65, 0.65, 1.6), mid, c1, nil, nil, anim)
			b:ball(0.5, (base * CFrame.new(0, 0.72, 1.6)).Position, p.tipColor or c2, nil, nil, anim)
		end
	elseif tail == "stub" then
		b:ball(p.stubSize or 0.38, V3(0, -0.2, 1.2), p.tailColor or c2, nil, nil, { kind = "wag", amp = 0.5, speed = 8, hp = tb })
	elseif tail == "long" then
		b:cyl(1.8, 0.09, V3(0, -0.7, 1.9), p.tailColor or c3, V3(90, 0, 0), nil, nil, { kind = "wag", amp = 0.3, speed = 4, hp = tb })
	elseif tail == "spiked" then
		b:cone(0.38, 1.5, V3(0, -0.45, 0.95), c1, V3(80, 0, 0), nil, nil, { kind = "wag", amp = 0.25, speed = 3, hp = tb }, 4)
	end
	local info = {
		head = hp,
		hr = hr,
		top = hp + V3(0, hr, 0),
		back = V3(0, -0.15, 0.8),
		br = 0.8,
		bodyC = bodyC,
		spine = { y = 0.15, z0 = 0.1, z1 = 1.2 },
		eyeX = hr * 0.42,
		eyeY = hp.Y + hr * 0.12,
		eyeZ = hp.Z - hr * 0.88,
	}
	if p.ext then
		p.ext(b, info, hp, hr)
	end
	return info
end

A.cat = function(b)
	return quad(b, {
		ear = "cone", snout = "short", tail = "curl", belly = true, paw = b.c2,
		ext = function(bb, _, hp, hr)
			whiskers(bb, hp, hr, 1)
		end,
	})
end

A.dog = function(b)
	return quad(b, {
		ear = "floppy", snout = "short", tail = "stub", belly = true, tailColor = b.c1, stubSize = 0.45, paw = b.c2,
		ext = function(bb, _, hp, hr)
			if bb.opt.heads then
				return
			end
			bb:oval(V3(0.45, 0.4, 0.15), hp + V3(0, hr * 0.15, -hr * 0.95), b.c2) -- brow patch
		end,
	})
end

A.bunny = function(b)
	return quad(b, {
		ear = "long", snout = "short", tail = "stub", tailColor = b.c1, stubSize = 0.55, paw = b.c1,
		ext = function(bb, _, hp, hr)
			bb:box(V3(0.18, 0.2, 0.06), hp + V3(0, -hr * 0.55, -hr * 0.98), C.WHITE, nil, SMOOTH, 0)
			for _, s in ipairs({ -1, 1 }) do
				bb:ball(0.3, hp + V3(s * hr * 0.62, -hr * 0.3, -hr * 0.7), bb.c3, SMOOTH, 0.55) -- blush
			end
		end,
	})
end

A.bear = function(b)
	return quad(b, { ear = "round", snout = "short", tail = "stub", tailColor = b.c1, belly = true })
end

A.fox = function(b)
	return quad(b, {
		ear = "cone", snout = "long", tail = "bushy", tails = b.opt.tails, belly = true, paw = b.c3, tipColor = b.c2,
		innerEar = b.c3,
	})
end

A.wolf = function(b)
	return quad(b, {
		ear = "cone", snout = "long", tail = "bushy", belly = true, hd = 1.8, bd = 1.6, tipColor = b.c1, innerEar = b.c3,
		ext = function(bb, _, hp, hr)
			bb:oval(V3(1.0, 0.9, 0.5), hp + V3(0, -hr * 0.15, -hr * 0.72), bb.c2) -- face mask
			bb:oval(V3(0.55, 0.55, 0.6), hp + V3(0, hr * 0.5, -hr * 0.6), bb.c3, nil, nil, 0.4) -- brow shade
		end,
	})
end

A.lion = function(b)
	return quad(b, {
		ear = "round", snout = "short", tail = "curl", tuft = b.c2, belly = false, paw = b.c1,
		ext = function(bb, _, hp, hr)
			bb:ball(hr * 2.3, hp + V3(0, 0, 0.35), bb.c2)
			for i = 0, 9 do
				local a = i / 10 * math.pi * 2
				bb:ball(0.75, hp + V3(math.cos(a) * hr * 1.0, math.sin(a) * hr * 1.0, 0.22), bb.c2)
			end
		end,
	})
end

A.pig = function(b)
	return quad(b, { ear = "tiny", snout = "pig", tail = "stub", paw = b.c2, stubSize = 0.3, tailColor = b.c1, bd = 1.7 })
end

A.cow = function(b)
	return quad(b, {
		ear = "horn", snout = "short", snoutColor = b.c3, tail = "long", tailColor = b.c1, paw = b.c1, bd = 1.7,
		ext = function(bb, info, hp, hr)
			local spots = { V3(0.45, -0.3, 0.2), V3(-0.4, -0.5, 0.8), V3(0.5, -0.65, 0.9), V3(-0.5, -0.2, 0.55) }
			for _, v in ipairs(spots) do
				bb:oval(V3(0.55, 0.5, 0.55), v + V3(0, 0, 0.1), bb.c2)
			end
			bb:oval(V3(0.5, 0.45, 0.3), hp + V3(0.45, 0.35, -hr * 0.72), bb.c2)
		end,
	})
end

A.sheep = function(b)
	return quad(b, {
		ear = "floppy", snout = "short", snoutColor = b.c2, tail = "stub", tailColor = b.c1, headColor = b.c2, earColor = b.c2,
		hd = 1.35, paw = b.c2,
		ext = function(bb, _, hp, hr)
			local offs = { V3(-0.55, 0.05, -0.1), V3(0.55, 0.05, -0.1), V3(-0.6, -0.1, 0.6), V3(0.6, -0.1, 0.6), V3(0, 0.55, 0.2), V3(0, 0.4, 0.85), V3(-0.3, -0.75, 0.2), V3(0.3, -0.75, 0.5) }
			for _, o in ipairs(offs) do
				bb:ball(0.85, V3(0, -0.55, 0.45) + o, bb.c1)
			end
			bb:ball(0.7, hp + V3(0, hr * 0.85, 0.0), bb.c1)
			bb:ball(0.55, hp + V3(-0.4, hr * 0.7, 0.05), bb.c1)
			bb:ball(0.55, hp + V3(0.4, hr * 0.7, 0.05), bb.c1)
		end,
	})
end

A.panda = function(b)
	return quad(b, {
		ear = "round", earColor = b.c2, innerEar = b.c2, snout = "short", snoutColor = b.c1, tail = "stub", tailColor = b.c1, paw = b.c2,
		ext = function(bb, _, hp, hr)
			for _, s in ipairs({ -1, 1 }) do
				bb:oval(V3(0.45, 0.55, 0.2), hp + V3(s * hr * 0.42, hr * 0.12, -hr * 0.8), bb.c2, V3(0, 0, s * 20))
				bb:oval(V3(0.45, 0.8, 0.5), V3(s * 0.8, -0.4, 0.05), bb.c2, V3(0, 0, s * 20))
			end
		end,
	})
end

A.hedgehog = function(b)
	return quad(b, {
		ear = "round", earScale = 0.7, earColor = b.c2, snout = "short", tail = "none", headColor = b.c2, hd = 1.35, paw = b.c2,
		ext = function(bb, info)
			for _, x in ipairs({ -0.42, 0, 0.42 }) do
				for k = 0, 6 do
					local a = math.rad(-10 + k * 24)
					local dir = V3(math.sin(a) * 0, math.cos(a), math.sin(a))
					local pos = V3(x, -0.55, 0.45) + dir * 0.85 + V3(0, 0, 0.05)
					bb:cyl(0.55, 0.12, pos, bb.c3, V3(math.deg(a), 0, -x * 35))
				end
			end
		end,
	})
end

A.mouse = function(b)
	return quad(b, {
		ear = "round", earScale = 1.7, snout = "short", tail = "long", tailColor = b.c2, belly = true, hd = 1.5, paw = b.c2,
		ext = function(bb, _, hp, hr)
			whiskers(bb, hp, hr, 0.9)
		end,
	})
end

A.dino = function(b)
	return quad(b, {
		ear = nil, snout = "croc", tail = "spiked", belly = true, hd = 1.9, bd = 1.5, paw = b.c1,
		ext = function(bb, info, hp, hr)
			for i = 0, 4 do
				local sc = 0.7 + 0.4 * math.sin(i / 4 * math.pi)
				local z = 0.1 + i * 0.26
				local y = -0.55 + math.sqrt(math.max(0.5625 - (z - 0.45) ^ 2, 0.01)) - 0.05
				bb:cone(0.2 * sc, 0.5 * sc, V3(0, y, z), bb.c3, V3(-10, 0, 0), nil, nil, nil, 2)
			end
			for _, s in ipairs({ -1, 1 }) do
				bb:oval(V3(0.3, 0.3, 0.6), V3(s * 0.72, -0.45, -0.15), bb.c1, V3(-30, 0, s * 10))
			end
		end,
	})
end

A.croc = function(b)
	return quad(b, {
		ear = nil, snout = "croc", tail = "spiked", belly = true, hd = 1.5, bd = 1.5, noEyes = true, paw = b.c1,
		ext = function(bb, info, hp, hr)
			for _, s in ipairs({ -1, 1 }) do
				bb:ball(0.55, hp + V3(s * hr * 0.5, hr * 0.78, -0.1), bb.c1)
				bb:ball(0.32, hp + V3(s * hr * 0.5, hr * 0.85, -0.3), C.WHITE, SMOOTH, 0)
				bb:ball(0.17, hp + V3(s * hr * 0.5, hr * 0.85, -0.45), C.EYE, SMOOTH, 0)
			end
			for i = 0, 5 do
				bb:cone(0.1, 0.25, V3(((i % 2) - 0.5) * 0.4, 0.05, -0.1 + i * 0.28), bb.c3, nil, nil, nil, nil, 2)
			end
			info.eyeY = hp.Y + hr * 0.85
			info.eyeZ = hp.Z - 0.5
			info.eyeX = hr * 0.5
		end,
	})
end

A.dragon = function(b)
	return quad(b, {
		ear = nil, snout = "croc", tail = "spiked", belly = true, hd = 1.8, bd = 1.7, eyeColor = b.c3, paw = b.c1,
		ext = function(bb, info, hp, hr)
			for _, s in ipairs({ -1, 1 }) do
				bb:cone(0.14, 0.55, hp + V3(s * hr * 0.9, -hr * 0.2, 0.2), bb.c2, V3(0, 0, -s * 90), nil, nil, nil, 2)
				bb:box(V3(0.42, 0.1, 0.1), hp + V3(s * hr * 0.42, hr * 0.42, -hr * 0.8), bb.c2, V3(0, 0, -s * 20), SMOOTH, 0)
			end
			for _, s in ipairs({ -1, 1 }) do
				bb:oval(V3(0.35, 0.35, 0.8), V3(s * 0.7, -0.55, -0.1), bb.c1, V3(-30, 0, s * 10))
			end
			if bb.opt.lava then
				for _, v in ipairs({ V3(0.5, 0.0, 0.5), V3(-0.4, -0.2, 0.9), V3(0.3, -0.35, 1.0) }) do
					bb:ball(0.22, v, bb.c3, NEON, 0)
				end
			end
		end,
	})
end

A.horse = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	local bodyC = V3(0, -0.4, 0.6)
	b:oval(V3(1.4, 1.4, 2.3), bodyC, c1)
	for _, s in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -0.15, 1.35 }) do
			b:cyl(1.0, 0.32, V3(s * 0.42, -1.3, z), c1)
			b:cyl(0.22, 0.36, V3(s * 0.42, -1.78, z), c2)
		end
	end
	b:oval(V3(0.75, 1.3, 0.8), V3(0, 0.35, -0.5), c1, V3(-25, 0, 0))
	local hp = V3(0, 0.95, -0.85)
	b:oval(V3(0.85, 0.95, 1.1), hp, c1, V3(-15, 0, 0))
	b:oval(V3(0.65, 0.6, 0.7), hp + V3(0, -0.25, -0.5), c1)
	for _, s in ipairs({ -1, 1 }) do
		b:ball(0.1, hp + V3(s * 0.15, -0.2, -0.85), C.EYE)
		b:cone(0.11, 0.35, hp + V3(s * 0.26, 0.42, 0.12), c1, V3(0, 0, -s * 10), nil, nil, nil, 2)
	end
	b:eyes(1.05, -1.12, 0.34, 0.22)
	for i = 0, 4 do
		b:ball(0.42, V3(0, 1.4 - i * 0.28, -0.4 + i * 0.16), c2)
	end
	local tb = V3(0, -0.05, 1.7)
	b:ovalCF(V3(0.55, 0.55, 1.8), CFrame.new(0, -0.45, 2.15) * CFrame.Angles(math.rad(-20), 0, 0), c2, nil, nil, { kind = "wag", amp = 0.3, speed = 3, hp = tb })
	if b.opt.antlers then
		for _, s in ipairs({ -1, 1 }) do
			b:cone(0.08, 1.0, hp + V3(s * 0.25, 0.5, 0.0), c3, V3(0, 0, -s * 20), NEON, 0.2)
			b:cone(0.06, 0.5, hp + V3(s * 0.4, 0.85, 0.0), c3, V3(0, 0, -s * 60), NEON, 0.2, nil, 2)
		end
	else
		b:cone(0.1, 0.9, hp + V3(0, 0.45, -0.35), PB.lighten(c3, 0.4), V3(-30, 0, 0), NEON, 0)
	end
	return {
		head = hp,
		hr = 0.5,
		top = hp + V3(0, 0.55, 0),
		back = V3(0, 0.3, 0.7),
		br = 0.8,
		bodyC = bodyC,
		spine = { y = 0.35, z0 = 0, z1 = 1.5 },
		eyeX = 0.34,
		eyeY = 1.05,
		eyeZ = -1.12,
	}
end

A.blob = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:oval(V3(2.2, 1.9, 2.2), V3(0, -0.1, 0), c1, nil, nil, 0.25)
	b:ball(0.85, V3(0, -0.2, 0.15), c2, NEON, 0.1, { kind = "bob", amp = 0.05, speed = 3 })
	b:oval(V3(2.7, 0.15, 2.7), V3(0, -1.0, 0), c1, nil, nil, 0.45)
	b:eyes(0.25, -0.95, 0.42, 0.3)
	b:box(V3(0.3, 0.06, 0.05), V3(0, -0.12, -1.02), C.EYE, nil, SMOOTH, 0)
	b:oval(V3(0.4, 0.22, 0.15), V3(-0.55, 0.65, -0.65), C.WHITE, V3(0, 20, 20), SMOOTH, 0.3)
	if b.opt.neon then
		b:ball(0.3, V3(0.5, -0.5, -0.4), c3, NEON, 0)
	end
	return {
		head = V3(0, 0.3, 0),
		hr = 1.0,
		top = V3(0, 0.95, 0),
		back = V3(0, 0.2, 0.9),
		br = 1.1,
		bodyC = V3(0, -0.1, 0),
		spine = { y = 0.9, z0 = -0.4, z1 = 0.6 },
		eyeX = 0.42,
		eyeY = 0.25,
		eyeZ = -0.95,
	}
end

return A
end

----------------------------------------------------------------------
-- module: PetArchB
----------------------------------------------------------------------
Defs.PetArchB = function()
-- Archetypes (part 2): birds, sea/bug/plant/food/object creatures and spirits.

local PB = Mod("PetBuilder")
local V3 = Vector3.new
local C = PB.Colors
local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal
local rad = math.rad

local A = {}

local function info(t, d)
	d = d or {}
	return {
		head = t.head, hr = t.hr, top = t.top or (t.head + V3(0, t.hr, 0)), back = t.back or V3(0, 0.2, 0.7), br = t.br or 0.8,
		bodyC = t.bodyC or V3(0, 0, 0), spine = t.spine or { y = 0.5, z0 = 0, z1 = 0.9 },
		eyeX = t.eyeX, eyeY = t.eyeY, eyeZ = t.eyeZ, bolt = t.bolt,
	}
end

------------------------------------------------------------------ birds
A.bird = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	local kind = b.opt.kind or "chick"
	local dark = c1:Lerp(Color3.new(0, 0, 0), 0.2)
	if kind == "owl" then
		local hp = V3(0, 1.0, -0.2)
		b:oval(V3(1.6, 1.9, 1.5), V3(0, 0.1, 0.1), c1)
		b:oval(V3(1.1, 1.4, 0.6), V3(0, -0.1, -0.5), c2)
		b:ball(1.5, hp, c1)
		for _, s in ipairs({ -1, 1 }) do
			b:ball(0.8, V3(s * 0.4, 1.05, -0.7), c2)
			b:ball(0.45, V3(s * 0.4, 1.05, -1.02), c3, SMOOTH, 0)
			b:ball(0.24, V3(s * 0.4, 1.05, -1.15), C.EYE, SMOOTH, 0)
			b:cone(0.14, 0.5, V3(s * 0.45, 1.6, -0.2), c1, V3(0, 0, -s * 20), nil, nil, nil, 2)
			b:box(V3(0.25, 0.1, 0.4), V3(s * 0.3, -0.85, -0.1), c3, nil, SMOOTH, 0)
			if not b:has("wings") then
				b:oval(V3(0.3, 1.1, 0.8), V3(s * 0.88, 0.1, 0.15), dark, V3(0, 0, s * 8), nil, nil, { kind = "flap", amp = 0.3 * s, speed = 4, hp = V3(s * 0.7, 0.6, 0.15) })
			end
		end
		b:cone(0.14, 0.35, V3(0, 0.85, -0.95), c3, V3(-90, 0, 0), nil, 0, nil, 2)
		b:oval(V3(0.5, 0.15, 0.7), V3(0, -0.3, 0.95), dark, V3(-25, 0, 0))
		return info({ head = hp, hr = 0.75, back = V3(0, 0.3, 0.8), br = 0.85, bodyC = V3(0, 0.1, 0.1), eyeX = 0.4, eyeY = 1.05, eyeZ = -1.2, bolt = V3(0, 2.1, -0.2) })
	end

	local chick = kind == "chick"
	local bd = chick and 1.7 or 1.5
	local hd = chick and 1.3 or 1.0
	local bodyC = V3(0, 0, 0.1)
	b:ball(bd, bodyC, c1)
	b:oval(V3(bd * 0.65, bd * 0.7, 0.5), V3(0, -0.15, -0.5), c2)
	local hp = V3(0, 0.85, -0.45)
	local hr = hd / 2
	b:ball(hd, hp, kind == "eagle" and PB.lighten(c1, 0.7) or c1)
	b:eyes(hp.Y + 0.05, hp.Z - hr * 0.86, hr * 0.45, 0.2)
	local beakColor = (kind == "duck" or kind == "phoenix" or kind == "eagle") and c2 or c3
	if kind == "duck" then
		b:oval(V3(0.65, 0.2, 0.6), hp + V3(0, -0.15, -hr - 0.1), c2)
	else
		b:cone(0.18, 0.42, hp + V3(0, -0.12, -hr + 0.02), beakColor, V3(-90, 0, 0), nil, 0, nil, 2)
	end
	if kind == "phoenix" then
		for i = -1, 1 do
			b:cone(0.12, 0.6, hp + V3(i * 0.15, hr * 0.85, 0.05), i == 0 and c2 or c3, V3(-15, 0, -i * 25), NEON, 0, nil, 2)
		end
	elseif kind == "duck" then
		b:ball(0.2, hp + V3(0, hr * 0.95, -0.05), c1)
	end
	for _, s in ipairs({ -1, 1 }) do
		b:box(V3(0.25, 0.1, 0.4), V3(s * 0.3, -0.78, -0.05), c3 == c1 and c2 or (kind == "duck" and c2 or c3), nil, SMOOTH, 0)
		if not b:has("wings") then
			local wc = (kind == "parrot" or kind == "eagle") and c2 or dark
			b:oval(V3(0.3, 0.95, 0.7), V3(s * (bd * 0.5 + 0.02), 0.0, 0.15), wc, V3(0, 0, s * 8), nil, nil, { kind = "flap", amp = 0.35 * s, speed = 5, hp = V3(s * 0.6, 0.5, 0.15) })
		end
	end
	local tb = V3(0, -0.3, 0.85)
	local feathers = { { c1, 0 } }
	if kind == "parrot" then
		feathers = { { c2, -12 }, { c3, 0 }, { c1, 12 } }
	elseif kind == "phoenix" then
		feathers = { { c1, -22 }, { c2, 0 }, { c3, 22 }, { c2, -42 }, { c1, 42 } }
	elseif kind == "eagle" then
		feathers = { { c2, -18 }, { c2, 0 }, { c2, 18 } }
	end
	for i, f in ipairs(feathers) do
		local len = (kind == "parrot" or kind == "phoenix") and 1.8 or 0.8
		local cf = CFrame.new(tb) * CFrame.Angles(0, rad(f[2]), 0) * CFrame.new(0, -0.1, len * 0.5) * CFrame.Angles(rad(-12), 0, 0)
		b:ovalCF(V3(0.35, 0.1, len), cf, f[1], nil, nil, { kind = "wag", amp = 0.2, speed = 3, phase = i, hp = tb })
	end
	return info({ head = hp, hr = hr, back = V3(0, 0.2, 0.7), br = bd * 0.5, bodyC = bodyC, eyeX = hr * 0.45, eyeY = hp.Y + 0.05, eyeZ = hp.Z - hr * 0.86, bolt = hp + V3(0, hr + 0.5, 0) })
end

A.penguin = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:oval(V3(1.6, 2.0, 1.4), V3(0, -0.1, 0.05), c1)
	b:oval(V3(1.15, 1.6, 0.8), V3(0, -0.15, -0.38), c2)
	local hp = V3(0, 1.05, -0.05)
	b:ball(1.25, hp, c1)
	b:oval(V3(0.9, 0.7, 0.4), hp + V3(0, -0.1, -0.4), c2)
	b:eyes(1.12, -0.58, 0.26, 0.18)
	b:cone(0.14, 0.32, V3(0, 0.95, -0.62), c3, V3(-90, 0, 0), nil, 0, nil, 2)
	for _, s in ipairs({ -1, 1 }) do
		b:oval(V3(0.25, 0.95, 0.5), V3(s * 0.9, 0.0, 0.05), c1, V3(0, 0, s * 15), nil, nil, { kind = "flap", amp = 0.3 * s, speed = 4, hp = V3(s * 0.75, 0.5, 0.05) })
		b:oval(V3(0.55, 0.12, 0.75), V3(s * 0.35, -1.1, -0.25), c3)
	end
	return info({ head = hp, hr = 0.62, back = V3(0, 0.2, 0.65), br = 0.8, bodyC = V3(0, -0.05, 0), eyeX = 0.26, eyeY = 1.12, eyeZ = -0.6, spine = { y = 0.9, z0 = 0.4, z1 = 0.6 } })
end

------------------------------------------------------------------ water / reptiles
A.fish = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:oval(V3(1.1, 1.5, 2.2), V3(0, 0, 0), c1)
	b:oval(V3(0.9, 0.8, 1.8), V3(0, -0.35, -0.05), c2)
	local tb = V3(0, 0, 1.1)
	b:oval(V3(0.15, 1.3, 0.9), V3(0, 0, 1.4), c3, nil, nil, nil, { kind = "wag", amp = 0.4, speed = 6, hp = tb })
	b:oval(V3(0.15, 0.75, 0.9), V3(0, 0.85, 0.1), c3)
	for _, s in ipairs({ -1, 1 }) do
		b:oval(V3(0.7, 0.12, 0.5), V3(s * 0.6, -0.25, -0.2), c3, V3(0, 0, -s * 15), nil, nil, { kind = "flap", amp = 0.4 * s, speed = 5, hp = V3(s * 0.45, -0.25, -0.2) })
		b:ball(0.5, V3(s * 0.5, 0.25, -0.8), C.WHITE, SMOOTH, 0)
		b:ball(0.26, V3(s * 0.55, 0.25, -1.0), C.EYE, SMOOTH, 0)
	end
	b:box(V3(0.4, 0.06, 0.06), V3(0, -0.1, -1.1), C.EYE, nil, SMOOTH, 0)
	return info({ head = V3(0, 0.2, -0.7), hr = 0.6, top = V3(0, 0.9, -0.4), back = V3(0, 0.3, 0.4), br = 0.7, spine = { y = 0.8, z0 = -0.2, z1 = 0.8 }, eyeX = 0.5, eyeY = 0.25, eyeZ = -1.05 })
end

A.frog = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:oval(V3(1.8, 1.3, 1.6), V3(0, -0.35, 0.1), c1)
	b:oval(V3(1.3, 0.8, 0.8), V3(0, -0.6, -0.4), c2)
	for _, s in ipairs({ -1, 1 }) do
		b:ball(0.7, V3(s * 0.55, 0.55, -0.45), c1)
		b:ball(0.5, V3(s * 0.55, 0.6, -0.65), C.WHITE, SMOOTH, 0)
		b:ball(0.28, V3(s * 0.55, 0.6, -0.85), C.EYE, SMOOTH, 0)
		b:ball(0.35, V3(s * 0.75, -0.15, -0.8), c2, SMOOTH, 0.55)
		b:oval(V3(0.5, 0.5, 1.1), V3(s * 0.95, -0.8, 0.55), c1)
		b:oval(V3(0.55, 0.12, 0.6), V3(s * 1.0, -1.05, -0.05), c2)
		b:oval(V3(0.35, 0.35, 0.6), V3(s * 0.7, -0.95, -0.7), c1)
	end
	b:box(V3(1.2, 0.06, 0.05), V3(0, -0.12, -0.88), C.EYE, nil, SMOOTH, 0)
	return info({ head = V3(0, 0.1, -0.4), hr = 0.9, top = V3(0, 1.0, -0.4), back = V3(0, 0.2, 0.85), br = 0.9, bodyC = V3(0, -0.35, 0.1), spine = { y = 0.3, z0 = 0, z1 = 0.9 }, eyeX = 0.55, eyeY = 0.6, eyeZ = -0.95 })
end

A.turtle = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:oval(V3(2.1, 1.3, 2.1), V3(0, 0, 0.2), c2)
	b:oval(V3(0.9, 0.25, 0.9), V3(0, 0.62, 0.2), c3)
	for _, s in ipairs({ -1, 1 }) do
		b:oval(V3(0.7, 0.25, 0.7), V3(s * 0.72, 0.4, -0.2), c3, V3(0, 0, -s * 30))
		b:oval(V3(0.7, 0.25, 0.7), V3(s * 0.72, 0.4, 0.6), c3, V3(0, 0, -s * 30))
		b:ball(0.55, V3(s * 0.8, -0.75, -0.5), c1)
		b:ball(0.55, V3(s * 0.8, -0.75, 0.9), c1)
	end
	b:oval(V3(1.7, 0.5, 1.8), V3(0, -0.55, 0.2), c1)
	local hp = V3(0, -0.1, -1.2)
	b:ball(0.9, hp, c1)
	b:eyes(0.0, -1.58, 0.2, 0.17)
	b:ball(0.25, V3(0, -0.6, 1.35), c1)
	return info({ head = hp, hr = 0.45, top = V3(0, 0.35, -1.2), back = V3(0, 0.5, 0.9), br = 1.0, bodyC = V3(0, 0, 0.2), spine = { y = 0.65, z0 = -0.3, z1 = 0.8 }, eyeX = 0.2, eyeY = 0.0, eyeZ = -1.6 })
end

A.snake = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	for i = 0, 7 do
		local a = rad(270 + i * 45)
		local col = (i % 2 == 0) and c1 or c2
		b:ball(0.78 - i * 0.02, V3(math.cos(a) * 0.8, -0.6, math.sin(a) * 0.8), col)
	end
	b:ball(0.38, V3(0, -0.5, 0), c1)
	local neck = { V3(0, -0.25, -0.85), V3(0, 0.15, -0.9), V3(0, 0.55, -0.85) }
	for i, v in ipairs(neck) do
		b:ball(0.72 - i * 0.04, v, (i % 2 == 0) and c2 or c1, nil, nil, { kind = "wag", amp = 0.1, speed = 2, phase = i, hp = V3(0, -0.6, -0.8) })
	end
	local hp = V3(0, 1.05, -0.95)
	b:ball(1.0, hp, c1)
	b:eyes(1.15, -1.4, 0.28, 0.2)
	b:box(V3(0.06, 0.04, 0.4), V3(0, 0.9, -1.55), Color3.fromRGB(230, 50, 70), nil, SMOOTH, 0)
	b:oval(V3(0.5, 0.2, 0.3), V3(0, 1.5, -0.95), c3, nil, nil, nil)
	return info({ head = hp, hr = 0.5, back = V3(0, -0.2, 0.8), br = 1.0, bodyC = V3(0, -0.4, 0), eyeX = 0.28, eyeY = 1.15, eyeZ = -1.4 })
end

A.octopus = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:oval(V3(1.8, 1.8, 1.7), V3(0, 0.5, 0), c1)
	for _, s in ipairs({ -1, 1 }) do
		b:ball(0.5, V3(s * 0.45, 0.4, -0.78), C.WHITE, SMOOTH, 0)
		b:ball(0.26, V3(s * 0.45, 0.4, -0.98), C.EYE, SMOOTH, 0)
	end
	for _, v in ipairs({ V3(0, 1.3, -0.1), V3(0.4, 1.2, 0.3), V3(-0.4, 1.15, 0.35) }) do
		b:ball(0.3, v, c2)
	end
	for i = 0, 5 do
		local a = rad(i * 60 + 30)
		local dx, dz = math.cos(a), math.sin(a)
		for k = 1, 3 do
			b:ball(0.6 - k * 0.1, V3(dx * (0.55 + 0.3 * k), -0.35 - 0.38 * k, dz * (0.55 + 0.3 * k)), k == 3 and c2 or c1, nil, nil, { kind = "wag", amp = 0.2, speed = 3, phase = i, hp = V3(0, 0.2, 0) })
		end
	end
	return info({ head = V3(0, 0.5, 0), hr = 0.9, back = V3(0, 0.3, 0.8), br = 0.9, bodyC = V3(0, 0.2, 0), eyeX = 0.45, eyeY = 0.4, eyeZ = -1.0 })
end

A.crab = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:oval(V3(2.2, 1.0, 1.6), V3(0, -0.2, 0), c1)
	b:oval(V3(1.4, 0.4, 0.5), V3(0, -0.3, -0.55), c2)
	for _, s in ipairs({ -1, 1 }) do
		b:cyl(0.45, 0.12, V3(s * 0.4, 0.45, -0.5), c1)
		b:ball(0.42, V3(s * 0.4, 0.75, -0.5), C.WHITE, SMOOTH, 0)
		b:ball(0.22, V3(s * 0.4, 0.78, -0.7), C.EYE, SMOOTH, 0)
		b:oval(V3(0.35, 0.35, 0.9), V3(s * 1.05, -0.1, -0.7), c1, V3(0, s * 25, 0))
		b:oval(V3(0.95, 0.55, 0.75), V3(s * 1.4, 0.05, -1.25), c1, V3(0, 0, 0), nil, nil, { kind = "flap", amp = 0.15 * s, speed = 4, hp = V3(s * 1.2, 0, -0.9) })
		b:oval(V3(0.35, 0.3, 0.5), V3(s * 1.4, 0.1, -1.7), c2)
		for i = 0, 2 do
			b:cyl(0.8, 0.14, V3(s * 1.25, -0.6, -0.3 + i * 0.4), c1, V3(0, 0, -s * -65))
		end
	end
	return info({ head = V3(0, 0.1, -0.3), hr = 0.9, top = V3(0, 1.1, -0.5), back = V3(0, 0.2, 0.6), br = 1.1, bodyC = V3(0, -0.2, 0), spine = { y = 0.3, z0 = -0.2, z1 = 0.6 }, eyeX = 0.4, eyeY = 0.78, eyeZ = -0.8 })
end

A.snail = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:oval(V3(0.9, 0.7, 2.2), V3(0, -0.55, 0.1), c1)
	b:oval(V3(0.7, 0.9, 0.7), V3(0, -0.2, -0.9), c1)
	local hp = V3(0, 0.05, -1.1)
	b:ball(0.8, hp, c1)
	b:ball(0.55 * 1.7, V3(0, 0.25, 0.5), c2)
	for _, s in ipairs({ -1, 1 }) do
		b:cyl(0.7, 0.1, V3(s * 0.2, 0.55, -1.1), c1, V3(0, 0, -s * 8))
		b:ball(0.3, V3(s * 0.25, 0.95, -1.12), C.WHITE, SMOOTH, 0)
		b:ball(0.15, V3(s * 0.25, 0.95, -1.28), C.EYE, SMOOTH, 0)
		b:cyl(0.18, 1.3, V3(s * 0.88, 0.25, 0.5), c3, V3(0, 0, 90))
		b:cyl(0.2, 0.65, V3(s * 0.94, 0.25, 0.5), c2, V3(0, 0, 90))
	end
	b:box(V3(0.3, 0.05, 0.05), V3(0, -0.12, -1.48), C.EYE, nil, SMOOTH, 0)
	return info({ head = hp, hr = 0.4, top = V3(0, 0.5, -1.1), back = V3(0, 1.1, 0.5), br = 1.0, bodyC = V3(0, 0.1, 0.4), spine = { y = 1.1, z0 = 0.2, z1 = 0.9 }, eyeX = 0.25, eyeY = 0.95, eyeZ = -1.3 })
end

------------------------------------------------------------------ bugs
A.bee = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:oval(V3(1.5, 1.4, 1.9), V3(0, 0, 0.2), c1)
	b:cyl(0.4, 1.55, V3(0, 0, 0.35), c2, V3(90, 0, 0))
	b:cyl(0.35, 1.4, V3(0, 0, 0.85), c2, V3(90, 0, 0))
	local hp = V3(0, 0.15, -0.95)
	b:ball(1.05, hp, c1)
	b:eyes(0.2, -1.4, 0.3, 0.3)
	b:cone(0.14, 0.45, V3(0, 0, 1.2), c2, V3(90, 0, 0), nil, 0, nil, 2)
	for _, s in ipairs({ -1, 1 }) do
		b:cyl(0.6, 0.06, V3(s * 0.22, 0.85, -1.05), c2, V3(-20, 0, -s * 15))
		b:ball(0.15, V3(s * 0.3, 1.15, -1.2), c2)
		b:oval(V3(0.75, 0.07, 1.4), V3(s * 0.55, 0.85, 0.3), c3, V3(0, 0, s * 20), nil, 0.4, { kind = "flap", amp = 0.5 * s, speed = 16, hp = V3(s * 0.2, 0.7, 0.3) })
	end
	return info({ head = hp, hr = 0.52, back = V3(0, 0.6, 0.4), br = 0.75, bodyC = V3(0, 0, 0.2), spine = { y = 0.7, z0 = -0.2, z1 = 0.9 }, eyeX = 0.3, eyeY = 0.2, eyeZ = -1.45 })
end

A.spider = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:ball(1.3, V3(0, 0, 0.5), c1)
	b:oval(V3(0.3, 0.12, 0.6), V3(0, 0.62, 0.55), c3, nil, NEON, 0)
	local hp = V3(0, 0.15, -0.5)
	b:ball(1.0, hp, c1)
	b:eyes(0.3, -0.95, 0.22, 0.3)
	for _, s in ipairs({ -1, 1 }) do
		b:ball(0.16, V3(s * 0.42, 0.5, -0.88), C.EYE, SMOOTH, 0)
		for i = 0, 3 do
			local z = -0.6 + i * 0.45
			local fan = (i - 1.5) * 0.12
			b:cyl(0.8, 0.12, V3(s * 0.75, 0.3, z), c1, V3(0, 0, math.deg(math.atan2(-s * 0.8, 0.6))))
			b:cyl(0.95, 0.1, V3(s * 1.45, -0.2, z + fan), c2, V3(0, 0, math.deg(math.atan2(-s * 0.5, -0.85))))
		end
	end
	return info({ head = hp, hr = 0.5, back = V3(0, 0.5, 0.9), br = 0.8, bodyC = V3(0, 0, 0.5), spine = { y = 0.65, z0 = 0.1, z1 = 1.0 }, eyeX = 0.22, eyeY = 0.3, eyeZ = -0.95 })
end

A.bug = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	local beetle = b.opt.kind == "beetle"
	b:oval(V3(1.8, 1.3, 1.9), V3(0, 0, 0.1), c1, nil, beetle and METAL or nil)
	b:box(V3(0.05, 0.9, 1.7), V3(0, 0.1, 0.1), c2, nil, SMOOTH, 0)
	if not beetle then
		for _, v in ipairs({ V3(0.5, 0.5, 0.3), V3(-0.5, 0.5, 0.3), V3(0.55, 0.38, -0.3), V3(-0.55, 0.38, -0.3), V3(0.35, 0.45, 0.75), V3(-0.35, 0.45, 0.75) }) do
			b:ball(0.35, v, c2, SMOOTH, 0)
		end
	end
	local hp = V3(0, -0.1, -0.95)
	b:ball(0.9, hp, c2)
	b:eyes(0.0, -1.35, 0.25, 0.2, C.WHITE)
	for _, s in ipairs({ -1, 1 }) do
		b:cyl(0.6, 0.06, V3(s * 0.2, 0.5, -1.15), c2, V3(-30, 0, -s * 15))
		for i = 0, 2 do
			b:cyl(0.7, 0.1, V3(s * 1.0, -0.45, -0.5 + i * 0.55), c2, V3(0, 0, s * -65))
		end
	end
	if beetle then
		b:cone(0.16, 0.7, V3(0, 0.25, -1.25), c3, V3(-50, 0, 0), NEON, 0, nil, 3)
	end
	return info({ head = hp, hr = 0.45, top = V3(0, 0.35, -0.95), back = V3(0, 0.5, 0.8), br = 0.9, bodyC = V3(0, 0, 0.1), spine = { y = 0.6, z0 = -0.3, z1 = 1.0 }, eyeX = 0.25, eyeY = 0.0, eyeZ = -1.4 })
end

A.bat = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:ball(1.2, V3(0, -0.1, 0.1), c1)
	local hp = V3(0, 0.65, -0.25)
	b:ball(1.3, hp, c1)
	for _, s in ipairs({ -1, 1 }) do
		b:cone(0.28, 0.8, hp + V3(s * 0.45, 0.5, 0), c1, V3(0, 0, -s * 12))
		b:cone(0.16, 0.5, hp + V3(s * 0.45, 0.5, -0.1), c3, V3(0, 0, -s * 12), nil, nil, nil, 2)
		b:cone(0.05, 0.16, hp + V3(s * 0.12, -0.3, -0.62), C.WHITE, V3(180, 0, 0), SMOOTH, 0, nil, 2)
		if not b:has("wings") then
			b:oval(V3(2.2, 0.1, 1.4), V3(s * 1.6, 0.0, 0.2), c2, V3(0, 0, s * 15), nil, nil, { kind = "flap", amp = 0.5 * s, speed = 7, hp = V3(s * 0.5, 0, 0.2) })
		end
	end
	b:eyes(0.75, -0.85, 0.26, 0.26, c3)
	b:ball(0.15, hp + V3(0, -0.15, -0.62), C.EYE)
	return info({ head = hp, hr = 0.65, top = V3(0, 1.3, -0.25), back = V3(0, 0.2, 0.5), br = 0.6, bodyC = V3(0, -0.1, 0.1), eyeX = 0.26, eyeY = 0.75, eyeZ = -0.85 })
end

------------------------------------------------------------------ plants / food / objects
A.mushroom = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:cyl(1.2, 0.9, V3(0, -0.5, 0), c2)
	b:oval(V3(2.4, 1.3, 2.4), V3(0, 0.5, 0), c1)
	for _, v in ipairs({ V3(0.7, 1.0, 0.2), V3(-0.65, 1.02, -0.3), V3(0.15, 1.12, -0.6), V3(-0.3, 1.1, 0.6), V3(0.05, 1.15, 0.05) }) do
		b:oval(V3(0.6, 0.18, 0.6), v, c3, nil, SMOOTH, 0)
	end
	b:eyes(-0.25, -0.44, 0.2, 0.22)
	for _, s in ipairs({ -1, 1 }) do
		b:ball(0.2, V3(s * 0.33, -0.45, -0.38), Color3.fromRGB(255, 150, 170), SMOOTH, 0.4)
	end
	b:box(V3(0.18, 0.04, 0.04), V3(0, -0.55, -0.45), C.EYE, nil, SMOOTH, 0)
	return info({ head = V3(0, 0.5, 0), hr = 1.1, top = V3(0, 1.15, 0), back = V3(0, 0.2, 0.6), br = 0.7, bodyC = V3(0, -0.4, 0), spine = { y = 1.0, z0 = -0.4, z1 = 0.6 }, eyeX = 0.2, eyeY = -0.25, eyeZ = -0.46 })
end

A.cactus = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:cyl(2.0, 1.2, V3(0, 0, 0), c1)
	b:ball(1.2, V3(0, 1.0, 0), c1)
	b:ball(1.2, V3(0, -1.0, 0), c1)
	for _, s in ipairs({ -1, 1 }) do
		b:cyl(0.8, 0.5, V3(s * 0.8, 0.1, 0), c1, V3(0, 0, 90))
		b:cyl(0.8, 0.5, V3(s * 1.15, 0.5, 0), c1)
		b:ball(0.5, V3(s * 1.15, 0.9, 0), c1)
	end
	for i, v in ipairs({ V3(0.3, 0.7, -0.58), V3(-0.4, -0.1, -0.56), V3(0.45, -0.4, -0.52), V3(-0.2, 0.3, -0.6), V3(0, -0.7, -0.55) }) do
		b:box(V3(0.04, 0.22, 0.04), v, c2, V3(0, 0, i * 25), SMOOTH, 0)
	end
	b:eyes(0.35, -0.58, 0.25, 0.2)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		b:ball(0.3, V3(math.cos(a) * 0.35 + 0.1, 1.6, math.sin(a) * 0.35), c3, nil, 0)
	end
	b:ball(0.25, V3(0.1, 1.62, 0), Color3.fromRGB(255, 225, 70), nil, 0)
	return info({ head = V3(0, 0.4, 0), hr = 0.6, top = V3(0, 1.8, 0), back = V3(0, 0, 0.6), br = 0.7, bodyC = V3(0, 0, 0), spine = { y = 0.5, z0 = 0.3, z1 = 0.6 }, eyeX = 0.25, eyeY = 0.35, eyeZ = -0.6 })
end

A.cloud = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:ball(1.6, V3(0, 0, 0), c1)
	for _, s in ipairs({ -1, 1 }) do
		b:ball(1.2, V3(s * 0.8, -0.15, 0.0), c1)
		b:ball(1.1, V3(s * 0.45, 0.45, 0.05), c1)
	end
	b:ball(1.2, V3(0, -0.35, 0.35), c1)
	b:oval(V3(2.4, 0.5, 1.5), V3(0, -0.7, 0.1), c2)
	b:eyes(0.05, -0.8, 0.32, 0.26)
	for _, s in ipairs({ -1, 1 }) do
		b:ball(0.3, V3(s * 0.55, -0.2, -0.72), Color3.fromRGB(255, 160, 180), SMOOTH, 0.5)
	end
	b:box(V3(0.25, 0.05, 0.05), V3(0, -0.2, -0.82), C.EYE, nil, SMOOTH, 0)
	return info({ head = V3(0, 0.1, 0), hr = 0.8, top = V3(0, 1.0, 0), back = V3(0, 0, 0.7), br = 1.2, bodyC = V3(0, 0, 0), eyeX = 0.32, eyeY = 0.05, eyeZ = -0.8, bolt = V3(0, -1.1, -0.2) })
end

A.donut = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		b:ball(0.8, V3(math.cos(a) * 0.85, math.sin(a) * 0.85, 0), c1)
		b:ball(0.66, V3(math.cos(a) * 0.85, math.sin(a) * 0.85, -0.14), c2)
	end
	local cols = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(80, 200, 255), Color3.fromRGB(255, 230, 70), Color3.fromRGB(120, 255, 140) }
	for i = 0, 13 do
		local a = i / 14 * math.pi * 2 + 0.2
		local r = 0.85 + ((i % 3) - 1) * 0.15
		b:box(V3(0.06, 0.2, 0.06), V3(math.cos(a) * r, math.sin(a) * r, -0.5), cols[(i % 4) + 1], V3(0, 0, i * 40), SMOOTH, 0)
	end
	b:eyes(0.75, -0.55, 0.42, 0.17)
	return info({ head = V3(0, 0, 0), hr = 1.2, top = V3(0, 1.45, 0), back = V3(0, 0, 0.5), br = 1.2, bodyC = V3(0, 0, 0), spine = { y = 1.2, z0 = 0, z1 = 0.4 }, eyeX = 0.42, eyeY = 0.75, eyeZ = -0.58 })
end

A.pizza = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	for i = 0, 5 do
		b:box(V3(2.0 - i * 0.32, 0.32, 0.3), V3(0, 0.75 - i * 0.3, 0), c1)
	end
	b:cyl(2.2, 0.45, V3(0, 0.98, 0), Color3.fromRGB(226, 170, 100), V3(0, 0, 90))
	for _, v in ipairs({ V3(0.55, 0.55, -0.17), V3(-0.55, 0.5, -0.17), V3(0.0, 0.0, -0.17), V3(0.2, -0.45, -0.17) }) do
		b:cyl(0.1, 0.42, v, c2, V3(90, 0, 0))
	end
	for _, v in ipairs({ V3(-0.2, 0.3, -0.17), V3(0.35, 0.15, -0.17), V3(-0.3, -0.15, -0.17) }) do
		b:box(V3(0.14, 0.1, 0.05), v, c3, V3(0, 0, 30), SMOOTH, 0)
	end
	b:eyes(0.4, -0.2, 0.35, 0.2)
	b:box(V3(0.3, 0.05, 0.05), V3(0, 0.15, -0.18), C.EYE, nil, SMOOTH, 0)
	return info({ head = V3(0, 0.1, -0.15), hr = 0.8, top = V3(0, 1.3, 0), back = V3(0, 0.1, 0.4), br = 0.9, bodyC = V3(0, 0, 0), spine = { y = 0.5, z0 = 0.2, z1 = 0.4 }, eyeX = 0.35, eyeY = 0.4, eyeZ = -0.22 })
end

A.burger = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:cyl(0.45, 2.0, V3(0, -0.7, 0), c1)
	b:cyl(0.45, 2.1, V3(0, -0.25, 0), c3)
	b:box(V3(1.9, 0.1, 1.9), V3(0, 0.05, 0), Color3.fromRGB(255, 205, 60), V3(0, 45, 0), SMOOTH, 0)
	b:cyl(0.2, 2.25, V3(0, 0.25, 0), c2)
	b:oval(V3(2.0, 1.0, 2.0), V3(0, 0.95, 0), c1)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		b:oval(V3(0.22, 0.1, 0.12), V3(math.cos(a) * 0.55, 1.4, math.sin(a) * 0.55), Color3.fromRGB(255, 245, 210), V3(0, i * 50, 0), SMOOTH, 0)
	end
	b:eyes(-0.2, -1.04, 0.35, 0.22)
	b:box(V3(0.4, 0.05, 0.05), V3(0, -0.5, -1.04), C.EYE, nil, SMOOTH, 0)
	return info({ head = V3(0, -0.2, 0), hr = 1.0, top = V3(0, 1.45, 0), back = V3(0, 0.4, 0.9), br = 1.0, bodyC = V3(0, 0, 0), spine = { y = 1.2, z0 = -0.3, z1 = 0.5 }, eyeX = 0.35, eyeY = -0.2, eyeZ = -1.06 })
end

A.cupcake = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:cyl(0.3, 1.0, V3(0, -1.0, 0), c1)
	b:cyl(0.3, 1.25, V3(0, -0.7, 0), c1)
	b:cyl(0.3, 1.5, V3(0, -0.4, 0), c1)
	b:oval(V3(1.7, 0.7, 1.7), V3(0, 0.0, 0), c2)
	b:oval(V3(1.3, 0.6, 1.3), V3(0, 0.5, 0), c2)
	b:oval(V3(0.8, 0.5, 0.8), V3(0, 0.9, 0), c2)
	b:ball(0.42, V3(0, 1.3, 0), c3, SMOOTH, 0)
	local cols = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(80, 200, 255), Color3.fromRGB(255, 230, 70), Color3.fromRGB(120, 255, 140) }
	for i = 0, 8 do
		local a = i / 9 * math.pi * 2
		b:box(V3(0.06, 0.2, 0.06), V3(math.cos(a) * 0.7, 0.35 + (i % 3) * 0.15, math.sin(a) * 0.7), cols[(i % 4) + 1], V3(20, i * 40, 30), SMOOTH, 0)
	end
	b:eyes(-0.45, -0.77, 0.3, 0.2)
	for _, s in ipairs({ -1, 1 }) do
		b:ball(0.22, V3(s * 0.5, -0.62, -0.7), Color3.fromRGB(255, 130, 160), SMOOTH, 0.5)
	end
	return info({ head = V3(0, -0.2, 0), hr = 0.9, top = V3(0, 1.5, 0), back = V3(0, 0, 0.8), br = 0.85, bodyC = V3(0, -0.2, 0), eyeX = 0.3, eyeY = -0.45, eyeZ = -0.78 })
end

A.snowman = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:ball(1.6, V3(0, -0.8, 0), c1)
	b:ball(1.2, V3(0, 0.35, 0), c1)
	local hp = V3(0, 1.25, 0)
	b:ball(0.95, hp, c1)
	b:eyes(1.35, -0.43, 0.2, 0.14)
	b:cone(0.1, 0.45, V3(0, 1.2, -0.45), c3, V3(-90, 0, 0), SMOOTH, 0, nil, 2)
	for i = 0, 2 do
		b:ball(0.14, V3(0, 0.6 - i * 0.25, -0.57 + i * 0.02), c2, SMOOTH, 0)
	end
	for _, s in ipairs({ -1, 1 }) do
		b:cyl(1.0, 0.07, V3(s * 0.95, 0.5, 0), Color3.fromRGB(110, 75, 40), V3(0, 0, s * 55), SMOOTH, 0)
	end
	if not b:has("crown") then
		b:cyl(0.55, 0.6, V3(0, 1.95, 0), c2)
		b:cyl(0.06, 0.95, V3(0, 1.7, 0), c2)
	end
	return info({ head = hp, hr = 0.48, top = V3(0, 1.72, 0), back = V3(0, 0.2, 0.6), br = 0.8, bodyC = V3(0, -0.1, 0), eyeX = 0.2, eyeY = 1.35, eyeZ = -0.45 })
end

A.pumpkin = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	for i = 0, 4 do
		b:oval(V3(1.2, 1.7, 1.7), V3(0, 0, 0), c1, V3(0, i * 36, 0))
	end
	b:cyl(0.4, 0.3, V3(0, 0.95, 0), c2)
	b:oval(V3(0.5, 0.1, 0.25), V3(0.3, 0.9, 0), c2, V3(0, 0, 25))
	for _, s in ipairs({ -1, 1 }) do
		b:box(V3(0.3, 0.3, 0.1), V3(s * 0.4, 0.25, -0.76), c3, V3(0, 0, 45), NEON, 0)
	end
	for i = 0, 4 do
		b:box(V3(0.14, 0.14, 0.1), V3(-0.4 + i * 0.2, -0.3 + ((i % 2) * 0.1), -0.72), c3, V3(0, 0, 45), NEON, 0)
	end
	return info({ head = V3(0, 0, 0), hr = 0.9, top = V3(0, 1.1, 0), back = V3(0, 0, 0.8), br = 0.9, bodyC = V3(0, 0, 0), eyeX = 0.4, eyeY = 0.25, eyeZ = -0.78 })
end

A.plant = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	if b.opt.kind == "flower" then
		b:cyl(1.3, 0.3, V3(0, -0.65, 0), c3)
		for _, s in ipairs({ -1, 1 }) do
			b:oval(V3(0.9, 0.12, 0.45), V3(s * 0.5, -0.5, 0), c3, V3(0, 0, s * 25), nil, nil, { kind = "flap", amp = 0.15 * s, speed = 2, hp = V3(s * 0.1, -0.6, 0) })
		end
		for i = 0, 7 do
			local a = i / 8 * math.pi * 2
			b:oval(V3(0.6, 0.6, 0.2), V3(math.cos(a) * 0.78, 0.5 + math.sin(a) * 0.78, 0), c1, nil, nil, nil, { kind = "flap", amp = 0.05, speed = 3, phase = i, hp = V3(0, 0.5, 0) })
		end
		b:ball(0.95, V3(0, 0.5, -0.05), c2)
		b:eyes(0.55, -0.5, 0.25, 0.17)
		b:box(V3(0.25, 0.04, 0.04), V3(0, 0.3, -0.5), C.EYE, nil, SMOOTH, 0)
		return info({ head = V3(0, 0.5, 0), hr = 0.45, top = V3(0, 1.45, 0), back = V3(0, 0, 0.5), br = 0.6, bodyC = V3(0, -0.2, 0), eyeX = 0.25, eyeY = 0.55, eyeZ = -0.52 })
	end
	b:ball(1.5, V3(0, -0.3, 0), c1)
	b:eyes(-0.2, -0.7, 0.3, 0.2)
	for _, s in ipairs({ -1, 1 }) do
		b:ball(0.25, V3(s * 0.5, -0.4, -0.6), Color3.fromRGB(255, 150, 170), SMOOTH, 0.45)
	end
	b:box(V3(0.25, 0.04, 0.04), V3(0, -0.45, -0.73), C.EYE, nil, SMOOTH, 0)
	b:cyl(0.7, 0.15, V3(0, 0.65, 0), c2)
	for _, s in ipairs({ -1, 1 }) do
		b:oval(V3(0.9, 0.12, 0.5), V3(s * 0.5, 1.0, 0), c2, V3(0, 0, s * 25), nil, nil, { kind = "flap", amp = 0.2 * s, speed = 3, hp = V3(0, 0.9, 0) })
	end
	b:oval(V3(1.2, 0.3, 1.2), V3(0, -1.0, 0), c3)
	return info({ head = V3(0, -0.3, 0), hr = 0.75, top = V3(0, 1.4, 0), back = V3(0, -0.1, 0.7), br = 0.8, bodyC = V3(0, -0.3, 0), eyeX = 0.3, eyeY = -0.2, eyeZ = -0.72 })
end

A.robot = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	local m = (b.mat == SMOOTH) and METAL or b.mat
	b:box(V3(1.4, 1.3, 1.2), V3(0, -0.35, 0), c1, nil, m)
	b:box(V3(1.3, 1.0, 1.1), V3(0, 0.65, 0), c1, nil, m)
	b:box(V3(1.0, 0.45, 0.1), V3(0, 0.7, -0.58), c3, nil, NEON, 0)
	for _, s in ipairs({ -1, 1 }) do
		b:oval(V3(0.18, 0.2, 0.06), V3(s * 0.22, 0.7, -0.64), C.EYE, nil, SMOOTH, 0)
		b:cyl(0.3, 0.4, V3(s * 0.72, 0.65, 0), c2, V3(0, 0, 90), m)
		b:cyl(0.9, 0.2, V3(s * 0.85, -0.35, 0), c2, V3(0, 0, s * 12), m)
		b:cyl(0.3, 0.7, V3(s * 0.5, -1.1, 0), c2, V3(0, 0, 90), m)
	end
	b:box(V3(0.5, 0.3, 0.05), V3(0, -0.25, -0.62), c3, nil, NEON, 0)
	b:cyl(0.5, 0.07, V3(0, 1.4, 0), c2, nil, m)
	b:ball(0.2, V3(0, 1.72, 0), c3, NEON, 0, { kind = "bob", amp = 0.06, speed = 5 })
	return info({ head = V3(0, 0.65, 0), hr = 0.65, top = V3(0, 1.15, 0), back = V3(0, -0.2, 0.6), br = 0.7, bodyC = V3(0, -0.35, 0), spine = { y = 0.3, z0 = 0, z1 = 0.6 }, eyeX = 0.22, eyeY = 0.7, eyeZ = -0.66 })
end

A.ghost = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	local t = math.max(b.trans, 0.12)
	b:ball(1.7, V3(0, 0.35, 0), c1, nil, t)
	b:cyl(1.2, 1.7, V3(0, -0.35, 0), c1, nil, nil, t)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		b:ball(0.75, V3(math.cos(a) * 0.62, -0.95, math.sin(a) * 0.62), c1, nil, t, { kind = "bob", amp = 0.08, speed = 4, phase = i })
	end
	b:ball(0.75, V3(0, -0.95, 0), c1, nil, t)
	for _, s in ipairs({ -1, 1 }) do
		b:oval(V3(0.35, 0.7, 0.35), V3(s * 0.98, -0.1, -0.2), c1, V3(0, 0, s * 30), nil, t, { kind = "flap", amp = 0.3 * s, speed = 3, hp = V3(s * 0.8, 0.2, -0.2) })
		b:oval(V3(0.3, 0.45, 0.2), V3(s * 0.32, 0.45, -0.8), C.EYE, nil, SMOOTH, 0)
		b:ball(0.28, V3(s * 0.6, 0.0, -0.74), c3, SMOOTH, 0.5)
	end
	b:oval(V3(0.3, 0.35, 0.1), V3(0, 0.0, -0.82), C.EYE, nil, SMOOTH, 0)
	return info({ head = V3(0, 0.35, 0), hr = 0.85, top = V3(0, 1.2, 0), back = V3(0, 0, 0.8), br = 0.9, bodyC = V3(0, -0.2, 0), eyeX = 0.32, eyeY = 0.45, eyeZ = -0.82 })
end

A.star = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	local spin = b.opt.neon
	b:ball(1.3, V3(0, 0, 0), c1)
	for k = 0, 4 do
		local ang = k * 72
		local anim = spin and { kind = "flap", amp = 0.12, speed = 1.5, hp = V3(0, 0, 0) } or nil
		b:cone(0.42, 1.2, V3(0, 0, 0), c1, V3(0, 0, ang), nil, nil, anim, 3)
		local a = rad(ang)
		b:ball(0.3, V3(-math.sin(a) * 1.25, math.cos(a) * 1.25, 0), c2, NEON, 0, anim)
	end
	b:eyes(0.1, -0.6, 0.25, 0.22)
	b:box(V3(0.25, 0.05, 0.05), V3(0, -0.2, -0.64), C.EYE, nil, SMOOTH, 0)
	return info({ head = V3(0, 0, 0), hr = 0.65, top = V3(0, 1.6, 0), back = V3(0, 0, 0.5), br = 1.0, bodyC = V3(0, 0, 0), eyeX = 0.25, eyeY = 0.1, eyeZ = -0.62 })
end

A.jelly = function(b)
