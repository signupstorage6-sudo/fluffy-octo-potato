	b:ball(1.9, V3(0, 0.3, 0), c1, nil, 0.3)
	b:ball(1.0, V3(0, 0.2, 0), c2, NEON, 0.25, { kind = "bob", amp = 0.05, speed = 3 })
	b:cyl(0.12, 2.0, V3(0, -0.05, 0), c2, nil, nil, 0.3)
	b:eyes(0.35, -0.9, 0.35, 0.24)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		b:cyl(1.2 + (i % 2) * 0.3, 0.12, V3(math.cos(a) * 0.6, -0.7 - (i % 2) * 0.15, math.sin(a) * 0.6), (i % 2 == 0) and c2 or c3, nil, nil, 0.1, { kind = "wag", amp = 0.25, speed = 3, phase = i, hp = V3(0, -0.1, 0) })
	end
	return info({ head = V3(0, 0.3, 0), hr = 0.95, top = V3(0, 1.25, 0), back = V3(0, 0.3, 0.9), br = 1.0, bodyC = V3(0, 0.2, 0), eyeX = 0.35, eyeY = 0.35, eyeZ = -0.92 })
end

A.rock = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	local m = (b.mat == SMOOTH) and Enum.Material.Slate or b.mat
	b:oval(V3(1.9, 1.7, 1.7), V3(0, -0.2, 0), c1, V3(0, 15, 0), m)
	b:oval(V3(0.9, 0.8, 0.9), V3(0.7, 0.6, 0.2), c2, V3(20, 10, 10), m)
	b:oval(V3(0.8, 0.7, 0.8), V3(-0.65, 0.55, 0.3), c2, V3(-10, 20, -10), m)
	b:oval(V3(1.0, 0.2, 0.8), V3(0, 0.62, 0.1), c3, nil, Enum.Material.Grass)
	b:eyes(0.1, -0.84, 0.35, 0.26, c3)
	b:box(V3(0.5, 0.08, 0.05), V3(0, -0.3, -0.84), C.EYE, nil, SMOOTH, 0)
	if b.opt.arms then
		for _, s in ipairs({ -1, 1 }) do
			b:oval(V3(0.6, 1.0, 0.6), V3(s * 1.15, -0.2, -0.1), c1, V3(0, 0, s * 15), m)
			b:ball(0.75, V3(s * 1.25, -0.85, -0.1), c2, m)
		end
	end
	if b.opt.lava then
		for _, v in ipairs({ { V3(0.5, -0.2, -0.82), 20 }, { V3(-0.25, -0.55, -0.8), -30 }, { V3(-0.6, 0.2, -0.75), 55 } }) do
			b:box(V3(0.07, 0.7, 0.05), v[1], c3, V3(0, 0, v[2]), NEON, 0)
		end
	end
	return info({ head = V3(0, 0.1, 0), hr = 0.9, top = V3(0, 0.75, 0), back = V3(0, 0.2, 0.8), br = 1.0, bodyC = V3(0, -0.2, 0), spine = { y = 0.6, z0 = 0, z1 = 0.7 }, eyeX = 0.35, eyeY = 0.1, eyeZ = -0.86 })
end

A.flame = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:ball(1.7, V3(0, -0.4, 0), c1, NEON, 0.05)
	b:oval(V3(1.3, 1.4, 1.3), V3(0, 0.35, 0), c1, nil, NEON, 0.05, { kind = "bob", amp = 0.05, speed = 5 })
	b:oval(V3(0.8, 1.3, 0.8), V3(0, 1.0, 0), c1, nil, NEON, 0.05, { kind = "bob", amp = 0.08, speed = 6, phase = 1 })
	b:oval(V3(0.4, 1.0, 0.4), V3(0, 1.6, 0), c2, nil, NEON, 0, { kind = "bob", amp = 0.12, speed = 7, phase = 2 })
	b:oval(V3(1.0, 1.1, 0.5), V3(0, -0.1, -0.5), c2, nil, NEON, 0.1)
	for _, s in ipairs({ -1, 1 }) do
		b:oval(V3(0.5, 0.9, 0.5), V3(s * 0.8, 0.1, 0), c3, V3(0, 0, -s * 20), NEON, 0.1, { kind = "bob", amp = 0.08, speed = 6, phase = s })
	end
	b:eyes(0.0, -0.8, 0.3, 0.24)
	b:box(V3(0.25, 0.05, 0.05), V3(0, -0.3, -0.8), C.EYE, nil, SMOOTH, 0)
	return info({ head = V3(0, 0.1, 0), hr = 0.75, top = V3(0, 2.0, 0), back = V3(0, 0.2, 0.6), br = 0.8, bodyC = V3(0, -0.1, 0), eyeX = 0.3, eyeY = 0.0, eyeZ = -0.82 })
end

A.skull = function(b)
	local c1, c2, c3 = b.c1, b.c2, b.c3
	b:ball(1.7, V3(0, 0.2, 0), c1)
	b:box(V3(0.9, 0.4, 0.9), V3(0, -0.7, -0.2), c1)
	for i = 0, 4 do
		b:box(V3(0.04, 0.22, 0.04), V3(-0.32 + i * 0.16, -0.78, -0.66), c2, nil, SMOOTH, 0)
	end
	for _, s in ipairs({ -1, 1 }) do
		b:oval(V3(0.5, 0.55, 0.3), V3(s * 0.38, 0.2, -0.7), c2, nil, SMOOTH, 0)
		b:ball(0.2, V3(s * 0.38, 0.18, -0.82), c3, NEON, 0, { kind = "bob", amp = 0.02, speed = 8 })
	end
	b:box(V3(0.18, 0.18, 0.08), V3(0, -0.15, -0.82), c2, V3(0, 0, 45), SMOOTH, 0)
	b:box(V3(0.04, 0.5, 0.04), V3(0.15, 0.9, -0.3), c2, V3(40, 0, 20), SMOOTH, 0)
	return info({ head = V3(0, 0.2, 0), hr = 0.85, top = V3(0, 1.05, 0), back = V3(0, -0.2, 0.6), br = 0.8, bodyC = V3(0, -0.2, 0), eyeX = 0.38, eyeY = 0.2, eyeZ = -0.82 })
end

return A
end

return {
	Get = Mod,
	Has = function(n)
		return Defs[n] ~= nil
	end,
}
]]></ProtectedString></Properties>
