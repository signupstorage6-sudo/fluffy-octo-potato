<Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">GameShared</string><ProtectedString name="Source"><![CDATA[-- ModuleScript named "GameShared"
-- Location: ReplicatedStorage > GameShared
-- Config, Net, PetData, PetBuilder, PetModels.

local Defs, Cache = {}, {}
local Finders = {
	function() return require(game:GetService("ReplicatedStorage"):WaitForChild("GameSharedArt")) end,
}

local function Mod(name)
	local c = Cache[name]
	if c == nil then
		local f = Defs[name]
		if f then
			c = f()
		else
			for _, find in ipairs(Finders) do
				local b = find()
				if b.Has(name) then
					c = b.Get(name)
					break
				end
			end
		end
		if c == nil then
			error("Unknown module: " .. tostring(name))
		end
		Cache[name] = c
	end
	return c
end

----------------------------------------------------------------------
-- module: Config
----------------------------------------------------------------------
Defs.Config = function()
-- All game balance + shared constants live here. Tweak numbers freely.

local Config = {}

Config.GameName = "Roll a Pet and Fight!"
Config.DataStoreName = "RollAPetAndFight_v1"
Config.LeaderboardStoreName = "RollAPetAndFight_BestWave_v1"
Config.AutoSaveInterval = 60

-- Economy ---------------------------------------------------------------
Config.StartCoins = 500
Config.BaseSlots = 3
Config.MaxSlots = 6
Config.IncomeInterval = 4 -- seconds between passive income payouts
Config.PotionDuration = 300 -- seconds (5 minutes)
Config.MaxLuck = 6
Config.RollCounts = { 1, 5, 10 }
Config.BossRollCost = 10 -- Boss Tokens per Boss Roll (Epic+ pets only)

-- Roll price slowly rises with total rolls so late-game rolling stays meaningful
function Config.RollPrice(totalRolls, count)
	local total = 0
	for i = 0, (count or 1) - 1 do
		total += math.floor(100 * (1 + (totalRolls + i) / 100) ^ 1.1)
	end
	return total
end

-- Rarities (Weight = base roll chance weight) -----------------------------
Config.Rarities = {
	{ Name = "Common", Color = Color3.fromRGB(180, 188, 200), Weight = 56, Income = 1, Damage = 6, DupShards = 1 },
	{ Name = "Uncommon", Color = Color3.fromRGB(92, 214, 110), Weight = 25, Income = 2.5, Damage = 12, DupShards = 2 },
	{ Name = "Rare", Color = Color3.fromRGB(70, 150, 255), Weight = 12, Income = 7, Damage = 28, DupShards = 4 },
	{ Name = "Epic", Color = Color3.fromRGB(176, 90, 255), Weight = 5, Income = 20, Damage = 65, DupShards = 8 },
	{ Name = "Legendary", Color = Color3.fromRGB(255, 176, 40), Weight = 1.8, Income = 60, Damage = 150, DupShards = 16 },
	{ Name = "Mythic", Color = Color3.fromRGB(255, 70, 110), Weight = 0.6, Income = 180, Damage = 360, DupShards = 30 },
	{ Name = "Secret", Color = Color3.fromRGB(30, 235, 220), Weight = 0.12, Income = 600, Damage = 900, DupShards = 60 },
	{ Name = "Divine", Color = Color3.fromRGB(255, 245, 170), Weight = 0.02, Income = 2500, Damage = 2400, DupShards = 120 },
}
Config.RarityIndex = {}
for i, r in ipairs(Config.Rarities) do
	Config.RarityIndex[r.Name] = i
end
-- Weights used by the Boss Roll (Epic+ only)
Config.BossRollWeights = { Epic = 70, Legendary = 22, Mythic = 6.5, Secret = 1.3, Divine = 0.2 }

-- Permanent upgrades -------------------------------------------------------
Config.Upgrades = {
	{ Key = "Income", Name = "Pet Income", Icon = "💰", Desc = "+10% pet income per level", Base = 250, Growth = 1.45, Max = 50, Per = 0.10 },
	{ Key = "Luck", Name = "Roll Luck", Icon = "🍀", Desc = "+4% Rare+ luck per level", Base = 400, Growth = 1.5, Max = 25, Per = 0.04 },
	{ Key = "Damage", Name = "Pet Damage", Icon = "⚔️", Desc = "+10% pet damage per level", Base = 300, Growth = 1.45, Max = 50, Per = 0.10 },
	{ Key = "Health", Name = "Tough Skin", Icon = "❤️", Desc = "+15 starting HP in the arena per level", Base = 200, Growth = 1.4, Max = 20, Per = 15 },
	{ Key = "Reward", Name = "Treasure Hunter", Icon = "🎁", Desc = "+8% coins from runs per level", Base = 500, Growth = 1.5, Max = 30, Per = 0.08 },
	{ Key = "Drops", Name = "Lucky Drops", Icon = "🧪", Desc = "+5% potion & item drops per level", Base = 800, Growth = 1.55, Max = 20, Per = 0.05 },
	{ Key = "Slots", Name = "Extra Pet Slot", Icon = "🐾", Desc = "Equip one more pet", Costs = { 25000, 250000, 2500000 }, Max = 3, Per = 1 },
}
Config.UpgradeByKey = {}
for _, u in ipairs(Config.Upgrades) do
	Config.UpgradeByKey[u.Key] = u
end

function Config.UpgradeCost(key, level)
	local u = Config.UpgradeByKey[key]
	if not u or level >= u.Max then
		return nil
	end
	if u.Costs then
		return u.Costs[level + 1]
	end
	return math.floor(u.Base * u.Growth ^ level)
end

-- Potions & materials --------------------------------------------------------
Config.PotionOrder = { "Coin", "Damage", "Luck", "Income" }
Config.Potions = {
	Coin = { Name = "2x Coin Potion", Icon = "🪙", Color = Color3.fromRGB(255, 205, 60), Desc = "2x coins from fights" },
	Damage = { Name = "2x Damage Potion", Icon = "⚔️", Color = Color3.fromRGB(255, 90, 90), Desc = "2x pet damage" },
	Luck = { Name = "Luck Potion", Icon = "🍀", Color = Color3.fromRGB(90, 220, 120), Desc = "2x roll luck" },
	Income = { Name = "2x Income Potion", Icon = "💸", Color = Color3.fromRGB(90, 190, 255), Desc = "2x passive pet income" },
}
Config.MaterialOrder = { "Shards", "Crystals", "Tokens" }
Config.Materials = {
	Shards = { Name = "Pet Shards", Icon = "🔹", Color = Color3.fromRGB(110, 190, 255) },
	Crystals = { Name = "Crystals", Icon = "💎", Color = Color3.fromRGB(200, 120, 255) },
	Tokens = { Name = "Boss Tokens", Icon = "🏆", Color = Color3.fromRGB(255, 190, 60) },
}

Config.Craft = {
	{ Key = "CoinPotion", Name = "2x Coin Potion", Icon = "🪙", Cost = { Shards = 25 }, Give = { Potions = { Coin = 1 } } },
	{ Key = "DamagePotion", Name = "2x Damage Potion", Icon = "⚔️", Cost = { Shards = 25 }, Give = { Potions = { Damage = 1 } } },
	{ Key = "IncomePotion", Name = "2x Income Potion", Icon = "💸", Cost = { Shards = 40 }, Give = { Potions = { Income = 1 } } },
	{ Key = "LuckPotion", Name = "Luck Potion", Icon = "🍀", Cost = { Crystals = 5 }, Give = { Potions = { Luck = 1 } } },
	{ Key = "PotionPack", Name = "Mega Potion Pack", Icon = "🧪", Cost = { Crystals = 18 }, Give = { Potions = { Coin = 2, Damage = 2, Income = 2, Luck = 2 } } },
	{ Key = "CoinBag", Name = "Bag of Coins", Icon = "💰", Cost = { Shards = 60 }, Give = { CoinsFromIncome = 900 } },
}

-- Daily rewards (7 day cycle) ---------------------------------------------
Config.DailyCooldown = 20 * 60 * 60 -- can claim again after 20h
Config.DailyStreakWindow = 48 * 60 * 60 -- streak resets after 48h
Config.Daily = {
	{ Coins = 500, Shards = 5 },
	{ Coins = 1000, Potions = { Coin = 1 } },
	{ Coins = 2000, Shards = 15 },
	{ Coins = 4000, Potions = { Luck = 1 } },
	{ Coins = 8000, Crystals = 2 },
	{ Coins = 15000, Potions = { Damage = 1, Income = 1 } },
	{ Coins = 30000, Crystals = 5, Tokens = 5, Potions = { Coin = 1, Luck = 1 } },
}

-- Pet Index rewards -------------------------------------------------------------
Config.IndexMilestones = {
	{ Need = 10, Reward = { Coins = 2000, Shards = 20 } },
	{ Need = 25, Reward = { Coins = 10000, Potions = { Coin = 1, Luck = 1 } } },
	{ Need = 50, Reward = { Coins = 50000, Crystals = 10, Potions = { Luck = 2 } } },
	{ Need = 75, Reward = { Coins = 250000, Crystals = 25, Tokens = 10 } },
	{ Need = 100, Reward = { Coins = 2000000, Crystals = 100, Tokens = 50, Potions = { Coin = 3, Damage = 3, Income = 3, Luck = 3 } } },
}
-- Completing every pet of a rarity
Config.RarityRewards = {
	Common = { Coins = 1500, Shards = 15 },
	Uncommon = { Coins = 6000, Shards = 30 },
	Rare = { Coins = 25000, Crystals = 3 },
	Epic = { Coins = 120000, Crystals = 6 },
	Legendary = { Coins = 600000, Crystals = 12 },
	Mythic = { Coins = 3000000, Crystals = 20, Tokens = 10 },
	Secret = { Coins = 12000000, Crystals = 30, Tokens = 20 },
	Divine = { Coins = 100000000, Crystals = 50, Tokens = 30 },
}

-- Combat --------------------------------------------------------------------------
Config.Combat = {
	PlayerHealth = 150,
	CountdownSeconds = 3,
	IntermissionSeconds = 3,
	WaveHPBase = 28,
	WaveHPGrowth = 1.2,
	EnemyDamageBase = 3,
	EnemyDamageGrowth = 1.11,
	EnemyAttackInterval = 1.6,
	PetAttackInterval = 0.9,
	PetRange = 80,
	BossEvery = 5,
	HealOnClear = 0.3,
	EndRunGrace = 10, -- seconds pets get to finish enemies after END RUN
	CoinBase = 3,
	CoinGrowth = 1.2,
	WaveBonusBase = 8,
	BossBonusBase = 120,
	ReachBase = 10,
	SurvivorBonus = 0.10,
}

-- World layout (shared so client arrows / tutorial know where things are) -------
Config.Hub = {
	Center = Vector3.new(0, 0, 0),
	SpawnPosition = Vector3.new(0, 3, 62),
	PortalPosition = Vector3.new(0, 0, -130),
	PortalFront = Vector3.new(0, 4, -108),
}
Config.Arena = {
	Origin = Vector3.new(4000, 0, 0),
	Spacing = 320,
	Radius = 62,
	MaxSlots = 24,
}

-- Helpers -----------------------------------------------------------------------------
local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
local function trim(s)
	if s:find("%.") then
		s = s:gsub("0+$", "")
		s = s:gsub("%.$", "")
	end
	return s
end

function Config.Format(n)
	n = n or 0
	if n < 1000 then
		if n == math.floor(n) then
			return tostring(math.floor(n))
		end
		return trim(string.format("%.1f", n))
	end
	local i = 1
	while n >= 1000 and i < #SUFFIX do
		n /= 1000
		i += 1
	end
	return trim(string.format("%.2f", n)) .. SUFFIX[i]
end

function Config.Time(sec)
	sec = math.max(0, math.floor(sec))
	return string.format("%d:%02d", sec // 60, sec % 60)
end

function Config.RarityColor(name)
	local i = Config.RarityIndex[name]
	return i and Config.Rarities[i].Color or Color3.new(1, 1, 1)
end

return Config
end

----------------------------------------------------------------------
-- module: Net
----------------------------------------------------------------------
Defs.Net = function()
-- Creates (server) / fetches (client) every RemoteEvent + RemoteFunction used by the game.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Net = {}

local EVENTS = {
	-- server -> client
	"Data", "Income", "Toast", "RunStart", "WaveStart", "WaveClear", "RunStatus", "RunEnd", "PetHit", "EnemyDied", "Hurt",
	-- client -> server
	"EquipPet", "UnequipPet", "EquipBest", "UnequipAll", "UsePotion", "BuyUpgrade", "Craft", "ClaimDaily", "ClaimIndex",
	"TutorialDone", "EndRun", "WarpToPortal", "Ready",
}
local FUNCTIONS = { "Roll" }

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
		for _, n in ipairs(EVENTS) do
			local e = Instance.new("RemoteEvent")
			e.Name = n
			e.Parent = folder
		end
		for _, n in ipairs(FUNCTIONS) do
			local f = Instance.new("RemoteFunction")
			f.Name = n
			f.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

function Net.Get(name)
	if RunService:IsServer() then
		return folder:FindFirstChild(name)
	end
	return folder:WaitForChild(name)
end

-- Server only: simple per player rate limiter
if RunService:IsServer() then
	local last = {}
	function Net.Throttle(player, key, interval)
		local now = os.clock()
		local t = last[player]
		if not t then
			t = {}
			last[player] = t
		end
		if t[key] and now - t[key] < interval then
			return false
		end
		t[key] = now
		return true
	end
	Players.PlayerRemoving:Connect(function(p)
		last[p] = nil
	end)
	-- kind: "good" | "error" | "info"
	function Net.Toast(player, text, kind)
		folder.Toast:FireClient(player, text, kind or "info")
	end
end

return Net
end

----------------------------------------------------------------------
-- module: PetData
----------------------------------------------------------------------
Defs.PetData = function()
-- All 100 pets. Stats are generated from rarity (see Config.Rarities).

local Config = Mod("Config")

local PetData = {}
PetData.Pets = {}
PetData.ByRarity = {}
PetData.RollPool = {}
for _, r in ipairs(Config.Rarities) do
	PetData.ByRarity[r.Name] = {}
	PetData.RollPool[r.Name] = {}
end

-- Boss -> exclusive pet (filled below via the `boss` argument)
PetData.BossPets = {}

-- P(name, rarity, archetype, body, secondary, accent, size, accessories, options, bossName)
local function P(name, rarity, arch, c1, c2, c3, size, acc, opt, boss)
	local id = #PetData.Pets + 1
	local ri = Config.RarityIndex[rarity]
	local list = PetData.ByRarity[rarity]
	local k = #list + 1
	local t = ((k * 37) % 100) / 100
	local base = Config.Rarities[ri]
	local incomeMult = 0.8 + 0.6 * t
	local damageMult = 1.4 - 0.6 * t
	if boss then
		incomeMult *= 1.3
		damageMult *= 1.3
	end
	local function round(x)
		if x < 10 then
			return math.floor(x * 10 + 0.5) / 10
		end
		return math.floor(x + 0.5)
	end
	local pet = {
		Id = id,
		Name = name,
		Rarity = rarity,
		RarityIndex = ri,
		Arch = arch,
		Colors = { c1, c2, c3 },
		Size = size or 1,
		Acc = acc or "",
		Opt = opt or {},
		Mult = math.floor(incomeMult * 100 + 0.5) / 100,
		Income = round(base.Income * incomeMult),
		Damage = round(base.Damage * damageMult),
		Boss = boss,
	}
	PetData.Pets[id] = pet
	list[k] = id
	if boss then
		PetData.BossPets[boss] = id
	else
		table.insert(PetData.RollPool[rarity], id)
	end
end

