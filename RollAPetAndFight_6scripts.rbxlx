<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">ClientCore</string><ProtectedString name="Source"><![CDATA[-- ModuleScript named "ClientCore"
-- Location: StarterPlayer > StarterPlayerScripts > ClientCore
-- UI toolkit, HUD, effects, pet following, daily and run summary popups.

local Defs, Cache = {}, {}
local Finders = {
	function() return require(game:GetService("ReplicatedStorage"):WaitForChild("GameShared")) end,
	function() return require(game:GetService("ReplicatedStorage"):WaitForChild("GameSharedArt")) end,
}

local function Mod(name)
	local c = Cache[name]
	if c == nil then
		local f = Defs[name]
		if f then
			c = f()
		else
			for _, find in ipairs(Finders) do
				local b = find()
				if b.Has(name) then
					c = b.Get(name)
					break
				end
			end
		end
		if c == nil then
			error("Unknown module: " .. tostring(name))
		end
		Cache[name] = c
	end
	return c
end

----------------------------------------------------------------------
-- module: State
----------------------------------------------------------------------
Defs.State = function()
-- Client side copy of the player's data (sent by the server) plus the current fighting run.

local State = {}

State.Data = nil
State.ServerOffset = 0
State.Run = { Active = false, Wave = 0, HP = 0, MaxHP = 0, Left = 0, Total = 0, Coins = 0, Kills = 0, Ending = false, Grace = 0 }

local listeners = {}

function State.OnChanged(fn)
	table.insert(listeners, fn)
	if State.Data then
		task.spawn(fn, State.Data)
	end
end

function State.Set(snapshot)
	State.Data = snapshot
	State.ServerOffset = snapshot.Derived.ServerTime - os.time()
	for _, fn in ipairs(listeners) do
		task.spawn(fn, snapshot)
	end
end

function State.Now()
	return os.time() + State.ServerOffset
end

function State.Owned(id)
	return State.Data and (State.Data.Pets[tostring(id)] or 0) or 0
end

function State.Discovered(id)
	return State.Data ~= nil and State.Data.Discovered[tostring(id)] == true
end

function State.DiscoveredCount()
	local n = 0
	if State.Data then
		for _ in pairs(State.Data.Discovered) do
			n += 1
		end
	end
	return n
end

function State.EquippedCount(id)
	local n = 0
	if State.Data then
		for _, e in ipairs(State.Data.Equipped) do
			if e == id then
				n += 1
			end
		end
	end
	return n
end

-- seconds left on an active potion (0 when not active)
function State.PotionLeft(kind)
	if not State.Data then
		return 0
	end
	return math.max(0, (State.Data.Active[kind] or 0) - State.Now())
end

function State.DailyReady()
	local d = State.Data
	if not d then
		return false
	end
	local Config = Mod("Config")
	return d.Daily.Last == 0 or State.Now() - d.Daily.Last >= Config.DailyCooldown
end

return State
end

----------------------------------------------------------------------
-- module: UI
----------------------------------------------------------------------
Defs.UI = function()
-- Shared UI toolkit: layers (auto scaled for phones/tablets), buttons, panels, toasts and pet cards.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = Mod("Config")
local PetData = Mod("PetData")
local PetModels = Mod("PetModels")

local UI = {}

UI.C = {
	Bg = Color3.fromRGB(34, 28, 62),
	Bg2 = Color3.fromRGB(52, 43, 92),
	Dark = Color3.fromRGB(21, 17, 40),
	Accent = Color3.fromRGB(140, 85, 245),
	Gold = Color3.fromRGB(255, 205, 70),
	Good = Color3.fromRGB(60, 195, 105),
	Bad = Color3.fromRGB(230, 75, 90),
	Info = Color3.fromRGB(80, 160, 250),
	Text = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(178, 172, 210),
}
UI.Format = Config.Format

local FONT = Enum.Font.GothamBold
local FONT_BLACK = Enum.Font.GothamBlack
UI.Font = FONT
UI.FontBlack = FONT_BLACK

UI.Layers = {}
UI.Panels = {}

----------------------------------------------------------------------- layers
local function makeLayer(name, order)
	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = order
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = pg
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = gui
	local sc = Instance.new("UIScale")
	sc.Parent = root
	UI.Layers[name] = { Gui = gui, Root = root, Scale = sc }
	return root
end

local function applyScale()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local vp = cam.ViewportSize
	local s = math.clamp(math.min(vp.X / 1100, vp.Y / 620), 0.55, 1.5)
	UI.ScaleValue = s
	for _, l in pairs(UI.Layers) do
		l.Scale.Scale = s
		l.Root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
end

function UI.Init()
	UI.Hud = makeLayer("RAPF_Hud", 1)
	UI.PanelLayer = makeLayer("RAPF_Panels", 5)
	UI.Overlay = makeLayer("RAPF_Overlay", 10)
	UI.ToastLayer = makeLayer("RAPF_Toast", 20)
	applyScale()
	local cam = workspace.CurrentCamera
	cam:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		task.wait()
		applyScale()
		if workspace.CurrentCamera then
			workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
		end
	end)

	-- toast container
	local tc = Instance.new("Frame")
	tc.Name = "Toasts"
	tc.BackgroundTransparency = 1
	tc.AnchorPoint = Vector2.new(0.5, 0)
	tc.Position = UDim2.new(0.5, 0, 0, 96)
	tc.Size = UDim2.fromOffset(560, 300)
	tc.Parent = UI.ToastLayer
	local ll = Instance.new("UIListLayout")
	ll.Padding = UDim.new(0, 6)
	ll.HorizontalAlignment = Enum.HorizontalAlignment.Center
	ll.SortOrder = Enum.SortOrder.LayoutOrder
	ll.Parent = tc
	UI.ToastBox = tc
end

----------------------------------------------------------------------- small helpers
function UI.Tween(inst, time, props, style, dir)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

function UI.Corner(inst, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 12)
	c.Parent = inst
	return c
end

function UI.Stroke(inst, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.new(0, 0, 0)
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = inst
	return s
end

function UI.Frame(parent, p)
	local f = Instance.new("Frame")
	f.Name = p.Name or "Frame"
	f.BackgroundColor3 = p.Color or UI.C.Bg2
	f.BackgroundTransparency = p.Transparency or 0
	f.BorderSizePixel = 0
	f.Size = p.Size or UDim2.fromScale(1, 1)
	f.Position = p.Position or UDim2.new()
	f.AnchorPoint = p.AnchorPoint or Vector2.zero
	f.ZIndex = p.ZIndex or 1
	f.ClipsDescendants = p.Clip or false
	if p.Radius then
		UI.Corner(f, p.Radius)
	end
	if p.Stroke then
		UI.Stroke(f, p.Stroke, p.StrokeThickness or 2, p.StrokeTransparency)
	end
	f.Parent = parent
	return f
end

function UI.Label(parent, p)
	local l = Instance.new("TextLabel")
	l.Name = p.Name or "Label"
	l.BackgroundTransparency = 1
	l.Font = p.Font or FONT
	l.TextSize = p.TextSize or 18
	l.TextColor3 = p.Color or UI.C.Text
	l.Text = p.Text or ""
	l.Size = p.Size or UDim2.fromScale(1, 1)
	l.Position = p.Position or UDim2.new()
	l.AnchorPoint = p.AnchorPoint or Vector2.zero
	l.TextXAlignment = p.XAlign or Enum.TextXAlignment.Center
	l.TextYAlignment = p.YAlign or Enum.TextYAlignment.Center
	l.TextWrapped = p.Wrap or false
	l.RichText = p.Rich or false
	l.ZIndex = p.ZIndex or 1
	if p.Stroke then
		l.TextStrokeTransparency = 0.35
		l.TextStrokeColor3 = Color3.fromRGB(15, 10, 30)
	end
	l.Parent = parent
	return l
end

function UI.Button(parent, p)
	local b = Instance.new("TextButton")
	b.Name = p.Name or "Button"
	b.AutoButtonColor = false
	b.Text = p.Text or ""
	b.Font = p.Font or FONT_BLACK
	b.TextSize = p.TextSize or 20
	b.TextColor3 = p.TextColor or UI.C.Text
	b.BackgroundColor3 = p.Color or UI.C.Accent
	b.Size = p.Size or UDim2.fromOffset(140, 44)
	b.Position = p.Position or UDim2.new()
	b.AnchorPoint = p.AnchorPoint or Vector2.zero
	b.ZIndex = p.ZIndex or 1
	b.BorderSizePixel = 0
	b.RichText = p.Rich or false
	b.TextWrapped = p.Wrap or false
	b:SetAttribute("Base", p.Color or UI.C.Accent)
	UI.Corner(b, p.Radius or 12)
	UI.Stroke(b, Color3.new(0, 0, 0), 2, 0.55)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(185, 185, 195))
	g.Rotation = 90
	g.Parent = b
	local sc = Instance.new("UIScale")
	sc.Parent = b
	b.MouseButton1Down:Connect(function()
		if not b:GetAttribute("Disabled") then
			UI.Tween(sc, 0.08, { Scale = 0.94 })
		end
	end)
	local function up()
		UI.Tween(sc, 0.14, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	b.MouseButton1Up:Connect(up)
	b.MouseLeave:Connect(up)
	if p.OnClick then
		b.Activated:Connect(function()
			if b:GetAttribute("Disabled") then
				return
			end
			p.OnClick()
		end)
	end
	b.Parent = parent
	return b
end

function UI.SetEnabled(b, on)
	b:SetAttribute("Disabled", not on)
	if on then
		b.BackgroundColor3 = b:GetAttribute("Base") or UI.C.Accent
		b.TextTransparency = 0
	else
		b.BackgroundColor3 = Color3.fromRGB(88, 84, 108)
		b.TextTransparency = 0.4
	end
end

function UI.Chip(parent, p)
	local f = UI.Frame(parent, { Name = p.Name or "Chip", Color = p.Color or UI.C.Dark, Size = p.Size or UDim2.fromOffset(90, 28), Position = p.Position, AnchorPoint = p.AnchorPoint, Radius = p.Radius or 14, Stroke = p.Stroke, Transparency = p.Transparency })
	local l = UI.Label(f, { Text = p.Text or "", TextSize = p.TextSize or 15, Color = p.TextColor or UI.C.Text, Rich = p.Rich })
	return f, l
end

function UI.Scroll(parent, p)
	local s = Instance.new("ScrollingFrame")
	s.Name = p.Name or "Scroll"
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.Size = p.Size or UDim2.fromScale(1, 1)
	s.Position = p.Position or UDim2.new()
	s.ScrollBarThickness = 6
	s.ScrollBarImageColor3 = UI.C.Accent
	s.CanvasSize = UDim2.new()
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	s.Parent = parent
	return s
end

----------------------------------------------------------------------- toasts
local toastColors = { good = Color3.fromRGB(46, 160, 90), error = Color3.fromRGB(200, 60, 75), info = Color3.fromRGB(90, 80, 200) }

function UI.Toast(text, kind)
	if not UI.ToastBox then
		return
	end
	local old = UI.ToastBox:GetChildren()
	local count = 0
	for _, c in ipairs(old) do
		if c:IsA("Frame") then
			count += 1
		end
	end
	if count >= 4 then
		for _, c in ipairs(old) do
			if c:IsA("Frame") then
				c:Destroy()
				break
			end
		end
	end
	local f = Instance.new("Frame")
	f.Size = UDim2.fromOffset(540, 38)
	f.BackgroundColor3 = toastColors[kind or "info"] or toastColors.info
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.LayoutOrder = os.clock() * 100
	UI.Corner(f, 12)
	local st = UI.Stroke(f, Color3.new(0, 0, 0), 2, 1)
	local l = UI.Label(f, { Text = text, TextSize = 17, Stroke = true })
	l.TextTransparency = 1
	f.Parent = UI.ToastBox
	UI.Tween(f, 0.2, { BackgroundTransparency = 0.08 })
	UI.Tween(st, 0.2, { Transparency = 0.5 })
	UI.Tween(l, 0.2, { TextTransparency = 0 })
	task.delay(3.4, function()
		if f.Parent then
			UI.Tween(f, 0.35, { BackgroundTransparency = 1 })
			UI.Tween(l, 0.35, { TextTransparency = 1, TextStrokeTransparency = 1 })
			UI.Tween(st, 0.35, { Transparency = 1 })
			task.wait(0.4)
			f:Destroy()
		end
	end)
end

----------------------------------------------------------------------- panels
function UI.CloseAllPanels(except)
	for _, p in pairs(UI.Panels) do
		if p ~= except and p.IsOpen then
			p:Close()
		end
	end
end

function UI.AnyPanelOpen()
	for _, p in pairs(UI.Panels) do
		if p.IsOpen then
			return true
		end
	end
	return false
end

function UI.Panel(name, title, size)
	local self = { Name = name, IsOpen = false }
	local back = Instance.new("TextButton")
	back.Name = name .. "Backdrop"
	back.AutoButtonColor = false
	back.Text = ""
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.new(0, 0, 0)
	back.BackgroundTransparency = 1
	back.BorderSizePixel = 0
	back.Visible = false
	back.Parent = UI.PanelLayer
	local frame = Instance.new("Frame")
	frame.Name = "Window"
	frame.Active = true
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = size
	frame.BackgroundColor3 = UI.C.Bg
	frame.BorderSizePixel = 0
	frame.Parent = back
	UI.Corner(frame, 18)
	UI.Stroke(frame, Color3.fromRGB(12, 9, 26), 3, 0)
	local sc = Instance.new("UIScale")
	sc.Parent = frame
	local bar = UI.Frame(frame, { Name = "TitleBar", Color = UI.C.Bg2, Size = UDim2.new(1, 0, 0, 52), Radius = 18 })
	UI.Frame(bar, { Color = UI.C.Bg2, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -20) })
	UI.Label(bar, { Text = title, TextSize = 26, Font = FONT_BLACK, Color = UI.C.Gold, XAlign = Enum.TextXAlignment.Left, Size = UDim2.new(1, -70, 1, 0), Position = UDim2.fromOffset(18, 0), Stroke = true })
	UI.Button(bar, {
		Name = "Close", Text = "✕", Color = UI.C.Bad, TextSize = 22, Size = UDim2.fromOffset(42, 42), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		OnClick = function()
			self:Close()
		end,
	})
	local body = UI.Frame(frame, { Name = "Body", Color = UI.C.Bg, Transparency = 1, Size = UDim2.new(1, 0, 1, -56), Position = UDim2.fromOffset(0, 56), Clip = true })
	self.Backdrop, self.Window, self.Body, self.Scale = back, frame, body, sc

	back.Activated:Connect(function()
		self:Close()
	end)

	function self:Open()
		if self.IsOpen then
			return
		end
		UI.CloseAllPanels(self)
		self.IsOpen = true
		back.Visible = true
		sc.Scale = 0.85
		back.BackgroundTransparency = 1
		UI.Tween(back, 0.18, { BackgroundTransparency = 0.5 })
		UI.Tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		if self.OnOpen then
			self.OnOpen()
		end
	end

	function self:Close()
		if not self.IsOpen then
			return
		end
		self.IsOpen = false
		UI.Tween(back, 0.12, { BackgroundTransparency = 1 })
		UI.Tween(sc, 0.12, { Scale = 0.9 })
		task.delay(0.13, function()
			if not self.IsOpen then
				back.Visible = false
			end
		end)
		if self.OnClose then
			self.OnClose()
		end
	end

	function self:Toggle()
		if self.IsOpen then
			self:Close()
		else
			self:Open()
		end
	end

	UI.Panels[name] = self
	return self
end

----------------------------------------------------------------------- pet cards
local spinners = {}

-- makes a viewport pet model rotate (used for big previews only)
function UI.Spin(model)
	spinners[model] = os.clock()
end

RunService.RenderStepped:Connect(function()
	for model, t0 in pairs(spinners) do
		if not model.Parent or not model.PrimaryPart then
			spinners[model] = nil
		else
			local t = os.clock() - t0
			model:PivotTo(CFrame.Angles(0, t * 0.9, 0))
			PetModels.Animate(model, t)
		end
	end
end)

local SIL = Color3.fromRGB(26, 22, 44)

-- returns { Frame, Button, Model, Viewport }
-- opts: Size, Locked (silhouette), Count, Equipped, Hint (small text instead of rarity), OnClick
function UI.PetCard(parent, petId, opts)
	opts = opts or {}
	local pet = PetData.Pets[petId]
	local rc = Config.Rarities[pet.RarityIndex].Color
	local f = Instance.new("Frame")
	f.Name = "PetCard"
	f.Size = opts.Size or UDim2.fromOffset(110, 132)
	f.BackgroundColor3 = UI.C.Dark:Lerp(rc, 0.3)
	f.BorderSizePixel = 0
	UI.Corner(f, 12)
	UI.Stroke(f, rc, 2.5, opts.Locked and 0.5 or 0)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 170))
	g.Rotation = 90
	g.Parent = f

	local vp, model = PetModels.Viewport(petId)
	vp.Position = UDim2.new(0, 4, 0, 4)
	vp.Size = UDim2.new(1, -8, 0.66, 0)
	vp.ZIndex = 2
	if opts.Locked then
		vp.Ambient = Color3.fromRGB(60, 56, 84)
		vp.LightColor = Color3.fromRGB(80, 76, 110)
		vp.BackgroundTransparency = 0.5
		vp.BackgroundColor3 = UI.C.Bg2
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Color = SIL
				d.Material = Enum.Material.SmoothPlastic
				d.Transparency = (d == model.PrimaryPart) and 1 or 0
			elseif d:IsA("SpecialMesh") then
				d.TextureId = ""
			end
		end
	end
	vp.Parent = f

	UI.Label(f, {
		Name = "Name", Text = opts.Locked and "???" or pet.Name, TextSize = 14, Font = FONT_BLACK, Color = UI.C.Text,
		Size = UDim2.new(1, -6, 0.17, 0), Position = UDim2.new(0, 3, 0.68, 0), ZIndex = 3,
	}).TextTruncate = Enum.TextTruncate.AtEnd
	UI.Label(f, {
		Name = "Rarity", Text = opts.Hint or pet.Rarity, TextSize = 12, Color = rc,
		Size = UDim2.new(1, -6, 0.13, 0), Position = UDim2.new(0, 3, 0.85, 0), ZIndex = 3,
	})
	if opts.Count and opts.Count > 1 then
		local chip = UI.Chip(f, { Text = "x" .. opts.Count, Size = UDim2.fromOffset(34, 20), Position = UDim2.new(1, -4, 0, 4), AnchorPoint = Vector2.new(1, 0), TextSize = 13, Color = UI.C.Dark })
		chip.ZIndex = 4
		for _, c in ipairs(chip:GetChildren()) do
			if c:IsA("TextLabel") then
				c.ZIndex = 5
			end
		end
	end
	if opts.Equipped then
		local chip, l = UI.Chip(f, { Text = "✔", Size = UDim2.fromOffset(24, 24), Position = UDim2.new(0, 4, 0, 4), TextSize = 15, Color = UI.C.Good, Radius = 12 })
		chip.ZIndex = 4
		l.ZIndex = 5
	end
	local btn = Instance.new("TextButton")
	btn.Name = "Hit"
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.Size = UDim2.fromScale(1, 1)
	btn.ZIndex = 10
	btn.Parent = f
	if opts.OnClick then
		btn.Activated:Connect(opts.OnClick)
	end
	f.Parent = parent
	return { Frame = f, Button = btn, Model = model, Viewport = vp }
end

-- Rich text line "  💰 12/s   ⚔ 150  "
function UI.StatLine(pet, incomeMult, damageMult)
	return string.format("💰 %s/s    ⚔ %s", Config.Format(pet.Income * (incomeMult or 1)), Config.Format(pet.Damage * (damageMult or 1)))
end

return UI
end

----------------------------------------------------------------------
-- module: Effects
----------------------------------------------------------------------
Defs.Effects = function()
-- Floating numbers, hit/death bursts, camera shake, screen flashes and the smooth spin of hub decorations.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")

local UI = Mod("UI")

local Effects = {}

local folder = Instance.new("Folder")
folder.Name = "ClientEffects"
folder.Parent = workspace

local function anchorAt(pos)
	local a = Instance.new("Part")
	a.Anchored = true
	a.CanCollide = false
	a.CanQuery = false
	a.CanTouch = false
	a.CastShadow = false
	a.Transparency = 1
	a.Size = Vector3.new(0.2, 0.2, 0.2)
	a.Position = pos
	a.Parent = folder
	return a
end

-- text that floats up from a world position and fades
function Effects.FloatText(pos, text, color, size, rise)
	local a = anchorAt(pos)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(220, 60)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.StudsOffset = Vector3.new(0, 0, 0)
	gui.Parent = a
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextSize = size or 28
	l.Text = text
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.1
	l.TextStrokeColor3 = Color3.fromRGB(20, 10, 30)
	l.Parent = gui
	local sc = Instance.new("UIScale")
	sc.Scale = 0.4
	sc.Parent = l
	TweenService:Create(sc, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	TweenService:Create(gui, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffset = Vector3.new(0, rise or 4, 0) }):Play()
	task.delay(0.65, function()
		TweenService:Create(l, TweenInfo.new(0.45), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
	Debris:AddItem(a, 1.3)
end

function Effects.Damage(pos, amount, crit)
	local jitter = Vector3.new((math.random() - 0.5) * 3, (math.random() - 0.5) * 1.5, (math.random() - 0.5) * 3)
	local text = UI.Format(amount)
	if crit then
		Effects.FloatText(pos + jitter, text .. "!", Color3.fromRGB(255, 215, 60), 40, 5)
	else
		Effects.FloatText(pos + jitter, text, Color3.fromRGB(255, 255, 255), 28, 4)
	end
end

function Effects.Burst(pos, color, amount, speed)
	local a = anchorAt(pos)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.5, 1.0)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Color = ColorSequence.new(color)
	e.LightEmission = 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) })
	e.Parent = a
	e:Emit(amount)
	Debris:AddItem(a, 1.4)
end

-- camera shake (uses Humanoid.CameraOffset)
local shakeUntil, shakeStart, shakeMag = 0, 0, 0
function Effects.Shake(magnitude, duration)
	if os.clock() + duration > shakeUntil or magnitude > shakeMag then
		shakeStart = os.clock()
		shakeUntil = shakeStart + duration
		shakeMag = magnitude
	end
end

-- full screen colour flash
function Effects.Flash(color, alpha, time)
	if not UI.Overlay then
		return
	end
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = alpha or 0.5
	f.BorderSizePixel = 0
	f.ZIndex = 50
	f.Parent = UI.Overlay
	local t = TweenService:Create(f, TweenInfo.new(time or 0.35), { BackgroundTransparency = 1 })
	t:Play()
	t.Completed:Connect(function()
		f:Destroy()
	end)
end

-- Spin tagged models (roll machine balls, portal swirl, index book)
local spinning = {}
local function addSpin(m)
	if m:IsA("Model") and not spinning[m] then
		spinning[m] = { base = m:GetPivot(), speed = m:GetAttribute("SpinSpeed") or 30, axis = m:GetAttribute("SpinAxis") or "Y", t0 = os.clock() }
	end
end

function Effects.Init()
	for _, m in ipairs(CollectionService:GetTagged("Spin")) do
		addSpin(m)
	end
	CollectionService:GetInstanceAddedSignal("Spin"):Connect(addSpin)
	CollectionService:GetInstanceRemovedSignal("Spin"):Connect(function(m)
		spinning[m] = nil
	end)

	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		for m, s in pairs(spinning) do
			if not m.Parent then
				spinning[m] = nil
			else
				local ang = math.rad(s.speed * (now - s.t0))
				local rot = (s.axis == "Z") and CFrame.Angles(0, 0, ang) or CFrame.Angles(0, ang, 0)
				m:PivotTo(s.base * rot)
			end
		end
		-- camera shake
		local char = Players.LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			if now < shakeUntil then
				local k = (shakeUntil - now) / math.max(shakeUntil - shakeStart, 0.01)
				local m = shakeMag * k
				hum.CameraOffset = Vector3.new((math.random() - 0.5) * m, (math.random() - 0.5) * m, 0)
			elseif hum.CameraOffset ~= Vector3.zero then
				hum.CameraOffset = Vector3.zero
			end
		end
	end)
end

return Effects
end

----------------------------------------------------------------------
-- module: PetFollow
----------------------------------------------------------------------
Defs.PetFollow = function()
-- Renders every player's equipped pets (from the "EquippedPets" attribute) floating smoothly behind them.
-- During fights, pets lunge at the enemy they hit (the server decides the damage, this is just the animation).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PetData = Mod("PetData")
local PetModels = Mod("PetModels")

local PetFollow = {}

local V3 = Vector3.new
local folder = Instance.new("Folder")
folder.Name = "ClientPets"
folder.Parent = workspace

local entries = {} -- [player] = { ids = "1,2", pets = { {model, root, pos, cf, radius, bottom, attack} } }
local CULL = 160

local function clear(entry)
	for _, p in ipairs(entry.pets) do
		p.model:Destroy()
	end
	table.clear(entry.pets)
end

local function rebuild(player, entry, ids)
	clear(entry)
	entry.ids = ids
	for token in string.gmatch(ids, "[^,]+") do
		local id = tonumber(token)
		if id and PetData.Pets[id] then
			local model = PetModels.Build(id)
			model.Parent = folder
			table.insert(entry.pets, {
				id = id,
				model = model,
				root = model.PrimaryPart,
				radius = model:GetAttribute("Radius") or 2,
				bottom = model:GetAttribute("Bottom") or 1.5,
				pos = nil,
				look = nil,
				attack = nil,
			})
		end
	end
end

-- called when the server says pet #slot hit an enemy
function PetFollow.Attack(player, slot, enemyRoot)
	local e = entries[player]
	local p = e and e.pets[slot]
	if p and enemyRoot then
		p.attack = { t0 = os.clock(), target = enemyRoot }
	end
end

function PetFollow.GetPetPosition(player, slot)
	local e = entries[player]
	local p = e and e.pets[slot]
	return p and p.pos
end

local function update(dt)
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position or V3()
	local t = os.clock()
	for _, player in ipairs(Players:GetPlayers()) do
		local ids = player:GetAttribute("EquippedPets") or ""
		local entry = entries[player]
		if not entry then
			entry = { ids = "", pets = {} }
			entries[player] = entry
		end
		if entry.ids ~= ids then
			rebuild(player, entry, ids)
		end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local n = #entry.pets
		if hrp and n > 0 then
			local far = (hrp.Position - camPos).Magnitude > CULL
			local cf = hrp.CFrame
			local flatLook = V3(cf.LookVector.X, 0, cf.LookVector.Z)
			if flatLook.Magnitude < 0.01 then
				flatLook = V3(0, 0, -1)
			end
			flatLook = flatLook.Unit
			local right = V3(-flatLook.Z, 0, flatLook.X)
			local groundY = hrp.Position.Y - 3
			local alpha = 1 - math.exp(-9 * dt)
			for i, p in ipairs(entry.pets) do
				if far then
					p.model.Parent = nil
				else
					if p.model.Parent ~= folder then
						p.model.Parent = folder
					end
					local lateral = (i - (n + 1) / 2) * (3.6 + p.radius * 0.5)
					local back = 5.5 + p.radius * 0.6 + math.abs(i - (n + 1) / 2) * 0.8
					local hover = 1.3 + math.sin(t * 2.2 + i * 1.7) * 0.35
					local base = hrp.Position + right * lateral - flatLook * back
					local target = V3(base.X, groundY + p.bottom + hover, base.Z)
					if not p.pos or (p.pos - target).Magnitude > 60 then
						p.pos = target
						p.look = flatLook
					else
						p.pos = p.pos:Lerp(target, alpha)
						p.look = p.look:Lerp(flatLook, alpha).Unit
					end
					local pos, look = p.pos, p.look
					local atk = p.attack
					if atk then
						local el = t - atk.t0
						if el > 0.42 or not atk.target.Parent then
							p.attack = nil
						else
							local k = math.sin(math.pi * el / 0.42)
							local tp = atk.target.Position
							local dir = pos - tp
							dir = V3(dir.X, 0, dir.Z)
							dir = dir.Magnitude > 0.1 and dir.Unit or V3(0, 0, 1)
							local hit = V3(tp.X, pos.Y + 1, tp.Z) + dir * (p.radius + 2.5)
							pos = pos:Lerp(hit, k)
							local toE = V3(tp.X - pos.X, 0, tp.Z - pos.Z)
							if toE.Magnitude > 0.1 then
								look = look:Lerp(toE.Unit, k).Unit
							end
						end
					end
					p.root.CFrame = CFrame.lookAt(pos, pos + look)
					PetModels.Animate(p.model, t)
				end
			end
		end
	end
end

function PetFollow.Init()
	Players.PlayerRemoving:Connect(function(player)
		local e = entries[player]
		if e then
			clear(e)
			entries[player] = nil
		end
	end)
	RunService.RenderStepped:Connect(update)
end

return PetFollow
end

----------------------------------------------------------------------
-- module: Hud
----------------------------------------------------------------------
Defs.Hud = function()
-- The always-on screen: coins, materials, menu buttons, equipped pets, potions and the combat HUD (wave, HP, END RUN).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = Mod("Config")
local PetData = Mod("PetData")
local Net = Mod("Net")
local UI = Mod("UI")
local State = Mod("State")
local Effects = Mod("Effects")

local Hud = { Refs = {} }
local R = Hud.Refs
local C = UI.C
local LEFT = Enum.TextXAlignment.Left
local BLACK = Enum.Font.GothamBlack

local shownCoins, targetCoins = 0, 0
local equippedKey = ""
local lastHurt = 0

local function iconButton(parent, name, icon, text, color, y)
	local b = UI.Button(parent, { Name = name, Text = "", Color = color, Size = UDim2.fromOffset(72, 72), Position = UDim2.fromOffset(0, y), Radius = 16 })
	UI.Label(b, { Name = "Icon", Text = icon, TextSize = 34, Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 3), Font = BLACK })
	UI.Label(b, { Name = "Text", Text = text, TextSize = 13, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, -21), Font = BLACK, Stroke = true })
	return b
end

local function mmss(sec)
	return string.format("%d:%02d", sec // 60, sec % 60)
end

----------------------------------------------------------------------- equipped bar
local function rebuildEquipped(d)
	local key = table.concat(d.Equipped, ",") .. "/" .. d.Derived.Slots
	if key == equippedKey then
		return
	end
	equippedKey = key
	local bar = R.EquippedSlots
	for _, c in ipairs(bar:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local slots = d.Derived.Slots
	bar.Parent.Size = UDim2.fromOffset(slots * 84 + 16, 130)
	R.EquippedTitle.Text = string.format("🐾 Equipped %d/%d  (tap a pet to unequip)", #d.Equipped, slots)
	for i = 1, slots do
		local id = d.Equipped[i]
		local holder = UI.Frame(bar, { Name = "Slot" .. i, Color = C.Dark, Transparency = 0.35, Size = UDim2.fromOffset(78, 94), Position = UDim2.fromOffset((i - 1) * 84, 0), Radius = 12, Stroke = C.Muted, StrokeTransparency = 0.6 })
		if id then
			holder:Destroy()
			local card = UI.PetCard(bar, id, {
				Size = UDim2.fromOffset(78, 94),
				OnClick = function()
					if State.Run.Active then
						UI.Toast("You can't change pets during a run!", "error")
						return
					end
					Net.Get("UnequipPet"):FireServer(id)
				end,
			})
			card.Frame.Position = UDim2.fromOffset((i - 1) * 84, 0)
		else
			UI.Label(holder, { Text = "+", TextSize = 34, Color = C.Muted })
			local hit = Instance.new("TextButton")
			hit.BackgroundTransparency = 1
			hit.Text = ""
			hit.Size = UDim2.fromScale(1, 1)
			hit.Parent = holder
			hit.Activated:Connect(function()
				if Hud.Panels and Hud.Panels.Inventory and not State.Run.Active then
					Hud.Panels.Inventory:Open()
				end
			end)
		end
	end
end

----------------------------------------------------------------------- state refresh
local function onState(d)
	targetCoins = d.Coins
	R.IncomeLabel.Text = string.format("+%s/s", Config.Format(d.Derived.IncomePS))
	for _, m in ipairs(Config.MaterialOrder) do
		R["Mat" .. m].Text = Config.Materials[m].Icon .. " " .. Config.Format(d.Materials[m])
	end
	for _, k in ipairs(Config.PotionOrder) do
		local n = d.Potions[k]
		local b = R.PotionButtons[k]
		b.Count.Text = tostring(n)
		UI.SetEnabled(b.Button, n > 0)
	end
	rebuildEquipped(d)
	R.DailyBadge.Visible = State.DailyReady()
end

local function tick()
	local d = State.Data
	if not d then
		return
	end
	for _, k in ipairs(Config.PotionOrder) do
		local left = State.PotionLeft(k)
		local chip = R.PotionChips[k]
		if left > 0 then
			chip.Frame.Visible = true
			chip.Label.Text = string.format("%s %s  %s", Config.Potions[k].Icon, Config.Potions[k].Name, mmss(left))
		else
			chip.Frame.Visible = false
		end
	end
	R.DailyBadge.Visible = State.DailyReady()
end

----------------------------------------------------------------------- public helpers
function Hud.Income(amount)
	local char = Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		Effects.FloatText(hrp.Position + Vector3.new(0, 4.5, 0), "+" .. Config.Format(amount) .. " 🪙", C.Gold, 30, 5)
	end
	R.CoinScale.Scale = 1.12
	UI.Tween(R.CoinScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
end

function Hud.Hurt()
	local now = os.clock()
	if now - lastHurt < 0.3 then
		return
	end
	lastHurt = now
	Effects.Flash(Color3.fromRGB(255, 40, 40), 0.82, 0.3)
	Effects.Shake(0.45, 0.15)
end

-- big message in the middle of the screen
function Hud.Banner(text, color, sub, duration)
	local f = Instance.new("Frame")
	f.BackgroundTransparency = 1
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(0.5, 0.27)
	f.Size = UDim2.fromOffset(700, 110)
	f.Parent = UI.Hud
	local sc = Instance.new("UIScale")
	sc.Scale = 0.3
	sc.Parent = f
	local l = UI.Label(f, { Text = text, TextSize = 56, Font = BLACK, Color = color or C.Gold, Size = UDim2.new(1, 0, 0, 66), Stroke = true })
	l.TextStrokeTransparency = 0
	local s
	if sub then
		s = UI.Label(f, { Text = sub, TextSize = 24, Color = C.Text, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 66), Stroke = true })
	end
	UI.Tween(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(duration or 1.8, function()
		UI.Tween(l, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		if s then
			UI.Tween(s, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
		task.wait(0.45)
		f:Destroy()
	end)
end

function Hud.SetCombat(active)
	R.Combat.Visible = active
	R.Buttons.Visible = not active
	R.EndRun.Text = "🏁 END RUN"
	UI.SetEnabled(R.EndRun, true)
	if active then
		UI.CloseAllPanels()
	end
end

function Hud.UpdateRun()
	local run = State.Run
	R.WaveLabel.Text = run.Wave == 0 and "GET READY!" or ("WAVE " .. run.Wave)
	local pct = run.MaxHP > 0 and math.clamp(run.HP / run.MaxHP, 0, 1) or 0
	R.HPFill.Size = UDim2.new(pct, 0, 1, 0)
	R.HPFill.BackgroundColor3 = Color3.fromRGB(235, 70, 70):Lerp(Color3.fromRGB(70, 210, 100), pct)
	R.HPText.Text = string.format("❤ %d / %d", run.HP, run.MaxHP)
	R.InfoLabel.Text = string.format("👾 %d / %d      🪙 %s earned", run.Left, run.Total, Config.Format(run.Coins))
	if run.Ending then
		R.EndingLabel.Visible = true
		R.EndingLabel.Text = run.Grace > 0 and string.format("RUN ENDING - pets are finishing the fight (%ds)", run.Grace) or "RUN ENDING..."
		R.EndRun.Text = "ENDING..."
		UI.SetEnabled(R.EndRun, false)
	else
		R.EndingLabel.Visible = false
	end
end

----------------------------------------------------------------------- build
function Hud.Init(panels)
	Hud.Panels = panels
	local root = UI.Hud

	-- coins
	local pill = UI.Frame(root, { Name = "Coins", Color = C.Dark, Size = UDim2.fromOffset(280, 54), Position = UDim2.fromOffset(14, 14), Radius = 27, Stroke = C.Gold, StrokeThickness = 3 })
	R.Coins = pill
	R.CoinScale = Instance.new("UIScale")
	R.CoinScale.Parent = pill
	UI.Label(pill, { Text = "🪙", TextSize = 32, Size = UDim2.fromOffset(52, 54), Position = UDim2.fromOffset(2, 0) })
	R.CoinLabel = UI.Label(pill, { Text = "0", TextSize = 30, Font = BLACK, Color = C.Gold, XAlign = LEFT, Size = UDim2.new(1, -64, 1, 0), Position = UDim2.fromOffset(56, 0), Stroke = true })
	R.IncomeLabel = UI.Label(root, { Text = "+0/s", TextSize = 17, Color = C.Good, XAlign = LEFT, Size = UDim2.fromOffset(200, 22), Position = UDim2.fromOffset(26, 72), Stroke = true })
	for i, m in ipairs(Config.MaterialOrder) do
		local _, label = UI.Chip(root, { Size = UDim2.fromOffset(100, 28), Position = UDim2.fromOffset(14 + (i - 1) * 106, 98), TextSize = 15, Color = C.Dark, Stroke = Config.Materials[m].Color })
		R["Mat" .. m] = label
	end

	-- potion timers (top right)
	local pbox = Instance.new("Frame")
	pbox.BackgroundTransparency = 1
	pbox.AnchorPoint = Vector2.new(1, 0)
	pbox.Position = UDim2.new(1, -14, 0, 14)
	pbox.Size = UDim2.fromOffset(230, 140)
	pbox.Parent = root
	local pl = Instance.new("UIListLayout")
	pl.Padding = UDim.new(0, 4)
	pl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	pl.Parent = pbox
	R.PotionChips = {}
	for _, k in ipairs(Config.PotionOrder) do
		local f = UI.Frame(pbox, { Name = "Chip" .. k, Color = C.Dark, Size = UDim2.fromOffset(230, 30), Radius = 15, Stroke = Config.Potions[k].Color })
		f.Visible = false
		local l = UI.Label(f, { Text = "", TextSize = 15 })
		R.PotionChips[k] = { Frame = f, Label = l }
	end

	-- menu buttons (right)
	local col = Instance.new("Frame")
	col.Name = "Buttons"
	col.BackgroundTransparency = 1
	col.AnchorPoint = Vector2.new(1, 0.5)
	col.Position = UDim2.new(1, -14, 0.5, 18)
	col.Size = UDim2.fromOffset(72, 6 * 80)
	col.Parent = root
	R.Buttons = col
	local defs = {
		{ "Roll", "🎲", "ROLL", Color3.fromRGB(150, 85, 245), function() panels.Roll:Toggle() end },
		{ "Pets", "🐾", "PETS", Color3.fromRGB(70, 150, 245), function() panels.Inventory:Toggle() end },
		{ "Index", "📖", "INDEX", Color3.fromRGB(225, 90, 170), function() panels.Index:Toggle() end },
		{ "Shop", "🛒", "SHOP", Color3.fromRGB(240, 140, 50), function() panels.Shop:Toggle() end },
		{ "Daily", "🎁", "DAILY", Color3.fromRGB(215, 165, 30), function() panels.Daily:Toggle() end },
		{ "Fight", "⚔️", "FIGHT", Color3.fromRGB(225, 70, 70), function()
			UI.CloseAllPanels()
			Net.Get("WarpToPortal"):FireServer()
		end },
	}
	for i, def in ipairs(defs) do
		local b = iconButton(col, "Btn" .. def[1], def[2], def[3], (i - 1) * 80)
		b.BackgroundColor3 = def[4]
		b:SetAttribute("Base", def[4])
		b.Activated:Connect(def[5])
		R["Btn" .. def[1]] = b
	end
	local badge = UI.Chip(R.BtnDaily, { Text = "!", Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, 4, 0, -4), AnchorPoint = Vector2.new(1, 0), Color = C.Bad, TextSize = 15, Radius = 11 })
	badge.ZIndex = 5
	for _, c in ipairs(badge:GetChildren()) do
		if c:IsA("TextLabel") then
			c.ZIndex = 6
		end
	end
	R.DailyBadge = badge
	badge.Visible = false

	-- potions (bottom left)
	local potBar = Instance.new("Frame")
	potBar.Name = "PotionBar"
	potBar.BackgroundTransparency = 1
	potBar.AnchorPoint = Vector2.new(0, 1)
	potBar.Position = UDim2.new(0, 14, 1, -14)
	potBar.Size = UDim2.fromOffset(4 * 68, 62)
	potBar.Parent = root
	R.PotionBar = potBar
	R.PotionButtons = {}
	for i, k in ipairs(Config.PotionOrder) do
		local p = Config.Potions[k]
		local b = UI.Button(potBar, {
			Name = "Potion" .. k, Text = "", Color = p.Color:Lerp(Color3.new(0, 0, 0), 0.35), Size = UDim2.fromOffset(62, 62), Position = UDim2.fromOffset((i - 1) * 68, 0), Radius = 14,
			OnClick = function()
				Net.Get("UsePotion"):FireServer(k)
			end,
		})
		UI.Label(b, { Text = p.Icon, TextSize = 30, Size = UDim2.new(1, 0, 0.75, 0) })
		local cnt = UI.Label(b, { Name = "Count", Text = "0", TextSize = 15, Font = BLACK, Size = UDim2.new(1, -6, 0, 18), Position = UDim2.new(0, 0, 1, -20), XAlign = Enum.TextXAlignment.Right, Stroke = true })
		R.PotionButtons[k] = { Button = b, Count = cnt }
	end

	-- equipped pets (bottom centre)
	local eq = Instance.new("Frame")
	eq.Name = "Equipped"
	eq.BackgroundTransparency = 1
	eq.AnchorPoint = Vector2.new(0.5, 1)
	eq.Position = UDim2.new(0.5, 0, 1, -12)
	eq.Size = UDim2.fromOffset(268, 130)
	eq.Parent = root
	R.Equipped = eq
	R.EquippedTitle = UI.Label(eq, { Text = "🐾 Equipped", TextSize = 14, Color = C.Muted, Size = UDim2.new(1, 0, 0, 20), Stroke = true })
	R.EquippedSlots = Instance.new("Frame")
	R.EquippedSlots.BackgroundTransparency = 1
	R.EquippedSlots.Position = UDim2.fromOffset(8, 24)
	R.EquippedSlots.Size = UDim2.new(1, -16, 0, 96)
	R.EquippedSlots.Parent = eq

	-- combat HUD
	local combat = Instance.new("Frame")
	combat.Name = "Combat"
	combat.BackgroundTransparency = 1
	combat.Size = UDim2.fromScale(1, 1)
	combat.Visible = false
	combat.Parent = root
	R.Combat = combat
	R.WaveLabel = UI.Label(combat, { Text = "WAVE 1", TextSize = 38, Font = BLACK, Size = UDim2.fromOffset(360, 46), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Stroke = true })
	local hpBack = UI.Frame(combat, { Name = "HP", Color = C.Dark, Size = UDim2.fromOffset(380, 28), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 60), Radius = 14, Stroke = Color3.new(0, 0, 0), Clip = true })
	R.HP = hpBack
	R.HPFill = UI.Frame(hpBack, { Color = Color3.fromRGB(70, 210, 100), Size = UDim2.fromScale(1, 1), Radius = 14 })
	R.HPText = UI.Label(hpBack, { Text = "❤", TextSize = 17, Font = BLACK, Stroke = true, ZIndex = 3 })
	R.InfoLabel = UI.Label(combat, { Text = "", TextSize = 19, Size = UDim2.fromOffset(460, 26), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 94), Stroke = true })
	R.EndingLabel = UI.Label(combat, { Text = "", TextSize = 18, Color = Color3.fromRGB(255, 120, 120), Size = UDim2.fromOffset(560, 26), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 122), Stroke = true })
	R.EndingLabel.Visible = false
	R.EndRun = UI.Button(combat, {
		Name = "EndRun", Text = "🏁 END RUN", Color = Color3.fromRGB(225, 60, 70), TextSize = 24, Size = UDim2.fromOffset(190, 62), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -14), Radius = 16,
		OnClick = function()
			Net.Get("EndRun"):FireServer()
		end,
	})

	-- live updates
	State.OnChanged(onState)
	RunService.RenderStepped:Connect(function(dt)
		local diff = targetCoins - shownCoins
		if math.abs(diff) < 1 then
			shownCoins = targetCoins
		else
			shownCoins += diff * math.min(1, dt * 9)
		end
		R.CoinLabel.Text = Config.Format(math.floor(shownCoins + 0.5))
	end)
	task.spawn(function()
		while true do
			tick()
			task.wait(0.5)
		end
	end)
end

return Hud
end

----------------------------------------------------------------------
-- module: Popups
----------------------------------------------------------------------
Defs.Popups = function()
-- The Daily Reward panel (7 day calendar + countdown) and the end-of-run reward summary screen.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = Mod("Config")
local PetData = Mod("PetData")
local Net = Mod("Net")
local UI = Mod("UI")
local State = Mod("State")
local Effects = Mod("Effects")

local Popups = {}
local C = UI.C
local BLACK = Enum.Font.GothamBlack
local LEFT = Enum.TextXAlignment.Left

local function rewardLines(r)
	local lines = {}
	if r.Coins then
		table.insert(lines, "🪙 " .. Config.Format(r.Coins))
	end
	for _, m in ipairs(Config.MaterialOrder) do
		if r[m] then
			table.insert(lines, Config.Materials[m].Icon .. " " .. r[m])
		end
	end
	if r.Potions then
		for _, k in ipairs(Config.PotionOrder) do
			if r.Potions[k] then
				table.insert(lines, Config.Potions[k].Icon .. " x" .. r.Potions[k])
			end
		end
	end
	return table.concat(lines, "\n")
end

local function hms(s)
	s = math.max(0, math.floor(s))
	return string.format("%d:%02d:%02d", s // 3600, (s % 3600) // 60, s % 60)
end

----------------------------------------------------------------------- daily rewards
function Popups.InitDaily()
	local panel = UI.Panel("Daily", "🎁  Daily Rewards", UDim2.fromOffset(820, 470))
	local body = panel.Body
	Popups.DailyPanel = panel

	UI.Label(body, { Text = "Come back every day to keep your streak going - day 7 has the best prize!", TextSize = 17, Color = C.Muted, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 4) })

	local tiles = {}
	for i = 1, 7 do
		local w, x, y = 180, 16 + (i - 1) * 196, 44
		if i >= 5 then
			y = 192
			x = 16 + (i - 5) * 196
			if i == 7 then
				w, x = 372, 408
			end
		end
		local f = UI.Frame(body, { Name = "Day" .. i, Color = C.Bg2, Size = UDim2.fromOffset(w, 136), Position = UDim2.fromOffset(x, y), Radius = 12, Stroke = Color3.fromRGB(70, 64, 110), StrokeThickness = 3 })
		UI.Label(f, { Text = "DAY " .. i, TextSize = 17, Font = BLACK, Color = (i == 7) and C.Gold or C.Text, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 4) })
		UI.Label(f, { Text = rewardLines(Config.Daily[i]), TextSize = 16, Wrap = true, Size = UDim2.new(1, -10, 1, -36), Position = UDim2.fromOffset(5, 32) })
		local mark = UI.Label(f, { Name = "Mark", Text = "", TextSize = 44, Color = C.Good, Size = UDim2.fromScale(1, 1), ZIndex = 5, Stroke = true })
		local shade = UI.Frame(f, { Name = "Shade", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.fromScale(1, 1), Radius = 12, ZIndex = 4 })
		tiles[i] = { Frame = f, Mark = mark, Shade = shade }
	end

	local claim = UI.Button(body, {
		Text = "CLAIM", Color = C.Good, TextSize = 24, Size = UDim2.fromOffset(260, 56), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Radius = 14,
		OnClick = function()
			Net.Get("ClaimDaily"):FireServer()
		end,
	})
	local streakLabel = UI.Label(body, { Text = "", TextSize = 16, Color = C.Muted, XAlign = LEFT, Size = UDim2.fromOffset(240, 56), Position = UDim2.new(0, 18, 1, -68) })

	local function nextDay()
		local d = State.Data
		if d.Daily.Last == 0 or State.Now() - d.Daily.Last > Config.DailyStreakWindow then
			return 1, 0
		end
		return d.Daily.Streak % #Config.Daily + 1, d.Daily.Streak
	end

	local function refresh()
		local d = State.Data
		if not d then
			return
		end
		local day, streak = nextDay()
		local ready = State.DailyReady()
		for i, t in ipairs(tiles) do
			local done = (i < day)
			local stroke = t.Frame:FindFirstChildOfClass("UIStroke")
			if done then
				t.Mark.Text = "✔"
				t.Shade.BackgroundTransparency = 0.55
				stroke.Color = C.Good
			elseif i == day then
				t.Mark.Text = ""
				t.Shade.BackgroundTransparency = 1
				stroke.Color = ready and C.Gold or Color3.fromRGB(120, 110, 170)
			else
				t.Mark.Text = ""
				t.Shade.BackgroundTransparency = 1
				stroke.Color = Color3.fromRGB(70, 64, 110)
			end
		end
		streakLabel.Text = string.format("🔥 Streak: %d day%s", streak, streak == 1 and "" or "s")
		if ready then
			claim.Text = "CLAIM DAY " .. day
			UI.SetEnabled(claim, true)
		else
			local left = Config.DailyCooldown - (State.Now() - d.Daily.Last)
			claim.Text = "Next in " .. hms(left)
			UI.SetEnabled(claim, false)
		end
	end

	State.OnChanged(refresh)
	panel.OnOpen = refresh
	task.spawn(function()
		while true do
			task.wait(1)
			if panel.IsOpen then
				refresh()
			end
		end
	end)
	return panel
end

----------------------------------------------------------------------- run summary
local OUTCOME = {
	ended = { "RUN COMPLETE!", Color3.fromRGB(90, 220, 130) },
	defeated = { "DEFEATED", Color3.fromRGB(240, 90, 100) },
	left = { "RUN ENDED", Color3.fromRGB(240, 190, 80) },
}

local function countUp(label, target, prefix, dur)
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < dur and label.Parent do
			local k = (os.clock() - t0) / dur
			label.Text = prefix .. Config.Format(math.floor(target * (1 - (1 - k) ^ 3)))
			task.wait()
		end
		if label.Parent then
			label.Text = prefix .. Config.Format(target)
		end
	end)
end

function Popups.ShowSummary(s)
	if Popups.SummaryGui then
		Popups.SummaryGui:Destroy()
	end
	local info = OUTCOME[s.Outcome] or OUTCOME.ended
	local back = Instance.new("TextButton")
	back.Name = "RunSummary"
	back.AutoButtonColor = false
	back.Text = ""
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.new(0, 0, 0)
	back.BackgroundTransparency = 1
	back.BorderSizePixel = 0
	back.Parent = UI.Overlay
	Popups.SummaryGui = back
	UI.Tween(back, 0.25, { BackgroundTransparency = 0.4 })

	local hasPets = #s.Pets > 0
	local potionList = {}
	for _, k in ipairs(Config.PotionOrder) do
		if s.Potions[k] then
			table.insert(potionList, Config.Potions[k].Icon .. " x" .. s.Potions[k])
		end
	end
	local height = 430 + (hasPets and 150 or 0)
	local box = UI.Frame(back, { Color = C.Bg, Size = UDim2.fromOffset(620, height), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Radius = 20, Stroke = info[2], StrokeThickness = 4 })
	local sc = Instance.new("UIScale")
	sc.Scale = 0.7
	sc.Parent = box
	UI.Tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	box.Active = true

	UI.Label(box, { Text = info[1], TextSize = 38, Font = BLACK, Color = info[2], Size = UDim2.new(1, 0, 0, 52), Position = UDim2.fromOffset(0, 8), Stroke = true })
	local sub = string.format("Reached wave %d   •   %d enemies   •   %d boss%s   •   %s", s.Wave, s.Kills, s.Bosses, s.Bosses == 1 and "" or "es", Config.Time(s.Time))
	UI.Label(box, { Text = sub, TextSize = 16, Color = C.Muted, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 58) })
	if s.NewBest then
		local nb = UI.Label(box, { Text = "🏆 NEW BEST WAVE: " .. s.BestWave .. "! 🏆", TextSize = 20, Font = BLACK, Color = C.Gold, Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 84), Stroke = true })
		nb.Name = "Best"
	end

	-- coin breakdown
	local list = UI.Frame(box, { Color = C.Dark, Transparency = 0.3, Size = UDim2.new(1, -40, 0, 176), Position = UDim2.fromOffset(20, 118), Radius = 12 })
	local rows = {
		{ "Enemies defeated", s.Coins.Kills },
		{ "Waves cleared", s.Coins.Waves },
		{ "Boss kills", s.Coins.Bosses },
		{ "Wave reached bonus", s.Coins.Reach },
	}
	if s.Coins.Survivor > 0 then
		table.insert(rows, { "Safe exit bonus", s.Coins.Survivor })
	end
	for i, r in ipairs(rows) do
		UI.Label(list, { Text = r[1], TextSize = 16, XAlign = LEFT, Size = UDim2.new(0.6, 0, 0, 24), Position = UDim2.fromOffset(14, 6 + (i - 1) * 25) })
		local v = UI.Label(list, { Text = "", TextSize = 16, Color = C.Gold, XAlign = Enum.TextXAlignment.Right, Size = UDim2.new(0.4, -14, 0, 24), Position = UDim2.new(0.6, 0, 0, 6 + (i - 1) * 25) })
		countUp(v, r[2], "🪙 ", 0.8)
	end
	UI.Label(list, { Text = string.format("Coin bonus x%.2f", s.Coins.Mult), TextSize = 14, Color = C.Muted, XAlign = LEFT, Size = UDim2.new(0.6, 0, 0, 20), Position = UDim2.fromOffset(14, 6 + #rows * 25) })
	local total = UI.Label(list, { Text = "", TextSize = 26, Font = BLACK, Color = C.Gold, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 1, -38), Stroke = true })
	countUp(total, s.Coins.Total, "TOTAL 🪙 ", 1.1)

	-- materials & potions
	local mats = {}
	if s.Shards > 0 then
		table.insert(mats, Config.Materials.Shards.Icon .. " " .. s.Shards)
	end
	if s.Crystals > 0 then
		table.insert(mats, Config.Materials.Crystals.Icon .. " " .. s.Crystals)
	end
	if s.Tokens > 0 then
		table.insert(mats, Config.Materials.Tokens.Icon .. " " .. s.Tokens)
	end
	for _, p in ipairs(potionList) do
		table.insert(mats, p)
	end
	UI.Label(box, {
		Text = (#mats > 0) and ("Items:  " .. table.concat(mats, "    ")) or "No items dropped this time.", TextSize = 18, Color = C.Text,
		Size = UDim2.new(1, -40, 0, 30), Position = UDim2.fromOffset(20, 302), Wrap = true,
	})

	local y = 340
	if hasPets then
		UI.Label(box, { Text = "👑 Boss reward pets!", TextSize = 18, Font = BLACK, Color = C.Gold, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, y) })
		local strip = Instance.new("Frame")
		strip.BackgroundTransparency = 1
		strip.Size = UDim2.new(1, -40, 0, 118)
		strip.Position = UDim2.fromOffset(20, y + 28)
		strip.Parent = box
		local lay = Instance.new("UIListLayout")
		lay.FillDirection = Enum.FillDirection.Horizontal
		lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
		lay.Padding = UDim.new(0, 8)
		lay.Parent = strip
		for _, p in ipairs(s.Pets) do
			UI.PetCard(strip, p.Id, { Size = UDim2.fromOffset(96, 114), Hint = p.New and "★ NEW ★" or ("+" .. (p.Shards or 0) .. " shards") })
		end
	end

	UI.Button(box, {
		Text = "RETURN TO HUB", Color = C.Good, TextSize = 24, Size = UDim2.fromOffset(280, 56), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Radius = 14,
		OnClick = function()
			UI.Tween(back, 0.15, { BackgroundTransparency = 1 })
			UI.Tween(sc, 0.15, { Scale = 0.8 })
			task.delay(0.16, function()
				back:Destroy()
				if Popups.SummaryGui == back then
					Popups.SummaryGui = nil
				end
			end)
		end,
	})
	if s.Outcome ~= "defeated" and s.Coins.Total > 0 then
		Effects.Flash(C.Gold, 0.75, 0.5)
	end
end

return Popups
end

return {
	Get = Mod,
	Has = function(n)
		return Defs[n] ~= nil
	end,
}
]]></ProtectedString></Properties>
</Item>
<Item class="LocalScript" referent="RBX11"><Properties><string name="Name">GameClient</string><ProtectedString name="Source"><![CDATA[-- LocalScript named "GameClient"
-- Location: StarterPlayer > StarterPlayerScripts > GameClient
-- Roll, pets, index and shop panels, tutorial and the client boot code.

local Defs, Cache = {}, {}
local Finders = {
	function() return require(game:GetService("ReplicatedStorage"):WaitForChild("GameShared")) end,
	function() return require(game:GetService("ReplicatedStorage"):WaitForChild("GameSharedArt")) end,
	function() return require(script.Parent:WaitForChild("ClientCore")) end,
}

local function Mod(name)
	local c = Cache[name]
	if c == nil then
		local f = Defs[name]
		if f then
			c = f()
		else
			for _, find in ipairs(Finders) do
				local b = find()
				if b.Has(name) then
					c = b.Get(name)
					break
				end
			end
		end
		if c == nil then
			error("Unknown module: " .. tostring(name))
		end
		Cache[name] = c
	end
	return c
end

----------------------------------------------------------------------
-- module: RollPanel
----------------------------------------------------------------------
Defs.RollPanel = function()
-- The pet roller menu, the capsule opening animation and the new-pet reveal screen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = Mod("Config")
local PetData = Mod("PetData")
local PetModels = Mod("PetModels")
local Net = Mod("Net")
local UI = Mod("UI")
local State = Mod("State")
local Effects = Mod("Effects")

local RollPanel = { Refs = {} }
local C = UI.C
local BLACK = Enum.Font.GothamBlack
local LEFT = Enum.TextXAlignment.Left

local busy = false
local fast = false

local function circle(f)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = f
end

local function pct(p)
	if p < 1 then
		return string.format("%.3f%%", p)
	elseif p < 10 then
		return string.format("%.2f%%", p)
	end
	return string.format("%.1f%%", p)
end

----------------------------------------------------------------------- reveal screen
local function ring(stage, color, delay)
	task.delay(delay, function()
		local r = Instance.new("Frame")
		r.AnchorPoint = Vector2.new(0.5, 0.5)
		r.Position = UDim2.fromScale(0.5, 0.42)
		r.Size = UDim2.fromOffset(60, 60)
		r.BackgroundTransparency = 1
		circle(r)
		local s = UI.Stroke(r, color, 8, 0)
		r.Parent = stage
		UI.Tween(r, 0.7, { Size = UDim2.fromOffset(620, 620) })
		UI.Tween(s, 0.7, { Transparency = 1, Thickness = 1 })
		Debris:AddItem(r, 0.8)
	end)
end

local function sparkles(stage, color, n)
	for i = 1, n do
		local l = UI.Label(stage, { Text = "✦", TextSize = math.random(22, 40), Color = color, Size = UDim2.fromOffset(40, 40), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42) })
		l.ZIndex = 4
		local a = math.random() * math.pi * 2
		local dist = math.random(160, 330)
		UI.Tween(l, 0.8 + math.random() * 0.4, { Position = UDim2.new(0.5, math.cos(a) * dist, 0.42, math.sin(a) * dist), TextTransparency = 1, Rotation = math.random(-180, 180) })
		Debris:AddItem(l, 1.3)
	end
end

-- shows one pet. waits until the player taps (single roll) or a short time (multi roll)
local function revealOne(overlay, stage, r, total, quick, state)
	local pet = PetData.Pets[r.Id]
	local ri = pet.RarityIndex
	local rar = Config.Rarities[ri]
	local col = rar.Color

	-- capsule
	local cap = UI.Frame(stage, { Name = "Capsule", Color = Color3.fromRGB(245, 245, 255), Size = UDim2.fromOffset(150, 150), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Radius = 75, Stroke = Color3.fromRGB(150, 140, 200), StrokeThickness = 5 })
	circle(cap)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 160, 215))
	g.Rotation = 90
	g.Parent = cap
	UI.Label(cap, { Text = "?", TextSize = 90, Font = BLACK, Color = Color3.fromRGB(110, 90, 190) })
	if ri >= 5 then
		UI.Stroke(cap, col, 6, 0.3) -- a rarity hint glow for big pulls
	end
	local dur = quick and 0.28 or (0.55 + ri * 0.09)
	local t0 = os.clock()
	while os.clock() - t0 < dur do
		local k = (os.clock() - t0) / dur
		cap.Rotation = math.sin(os.clock() * (22 + k * 30)) * (6 + k * 16)
		cap.Size = UDim2.fromOffset(150 + k * 30, 150 + k * 30)
		task.wait()
	end
	cap:Destroy()

	-- burst
	Effects.Flash(ri >= 8 and Color3.fromRGB(255, 245, 190) or col, ri >= 6 and 0.1 or 0.45, 0.45)
	ring(stage, col, 0)
	if not quick then
		ring(stage, col, 0.1)
		ring(stage, Color3.new(1, 1, 1), 0.2)
	end
	sparkles(stage, col, quick and 8 or (10 + ri * 3))
	if ri >= 5 then
		Effects.Shake(0.4 + ri * 0.1, 0.35)
	end

	-- pet
	local vp, model = PetModels.Viewport(r.Id)
	vp.AnchorPoint = Vector2.new(0.5, 0.5)
	vp.Position = UDim2.fromScale(0.5, 0.42)
	vp.Size = UDim2.fromOffset(330, 330)
	vp.ZIndex = 3
	vp.Parent = stage
	local sc = Instance.new("UIScale")
	sc.Scale = 0.1
	sc.Parent = vp
	UI.Tween(sc, quick and 0.25 or 0.6, { Scale = 1 }, Enum.EasingStyle.Elastic)
	UI.Spin(model)

	local nameL = UI.Label(stage, { Text = pet.Name, TextSize = 46, Font = BLACK, Size = UDim2.new(1, 0, 0, 54), Position = UDim2.fromScale(0, 0.68), ZIndex = 5, Stroke = true })
	nameL.TextStrokeTransparency = 0
	UI.Label(stage, { Text = "★ " .. string.upper(rar.Name) .. " ★", TextSize = 28, Font = BLACK, Color = col, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 0.68, 56), ZIndex = 5, Stroke = true })
	local line
	if r.New then
		line = "✨ NEW PET! ✨"
	else
		line = string.format("Duplicate  +%d 🔹 shards", r.Shards or 0)
	end
	local nl = UI.Label(stage, { Text = line, TextSize = 24, Font = BLACK, Color = r.New and C.Gold or C.Muted, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0.68, 92), ZIndex = 5, Stroke = true })
	if r.New then
		local ns = Instance.new("UIScale")
		ns.Parent = nl
		ns.Scale = 0.5
		UI.Tween(ns, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	UI.Label(stage, { Text = UI.StatLine(pet), TextSize = 20, Color = C.Text, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 0.68, 124), ZIndex = 5, Stroke = true })
	local hint
	if total == 1 then
		hint = UI.Label(stage, { Text = "tap to continue", TextSize = 16, Color = C.Muted, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0.68, 156), ZIndex = 5 })
	end

	-- wait
	local tapped = false
	local conn = overlay.Activated:Connect(function()
		tapped = true
	end)
	local waitT = os.clock()
	local limit = (total == 1) and 9999 or (quick and 0.55 or (1.1 + ri * 0.1))
	while not tapped and not state.skip and os.clock() - waitT < limit do
		task.wait(0.03)
	end
	conn:Disconnect()
	for _, c in ipairs(stage:GetChildren()) do
		if c ~= hint then
			c:Destroy()
		end
	end
	if hint then
		hint:Destroy()
	end
end

local function showGrid(overlay, results)
	local box = UI.Frame(overlay, { Color = C.Bg, Size = UDim2.fromOffset(660, 400), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Radius = 18, Stroke = C.Gold, StrokeThickness = 3 })
	UI.Label(box, { Text = "🎉 You rolled", TextSize = 28, Font = BLACK, Color = C.Gold, Size = UDim2.new(1, 0, 0, 44), Stroke = true })
	local grid = Instance.new("Frame")
	grid.BackgroundTransparency = 1
	grid.Position = UDim2.fromOffset(20, 50)
	grid.Size = UDim2.new(1, -40, 1, -128)
	grid.Parent = box
	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.fromOffset(112, 134)
	gl.CellPadding = UDim2.fromOffset(6, 6)
	gl.HorizontalAlignment = Enum.HorizontalAlignment.Center
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.Parent = grid
	for i, r in ipairs(results) do
		local card = UI.PetCard(grid, r.Id, { Size = UDim2.fromOffset(112, 134), Hint = r.New and "★ NEW ★" or nil })
		card.Frame.LayoutOrder = i
	end
	local done = false
	UI.Button(box, {
		Text = "CONTINUE", Color = C.Good, TextSize = 24, Size = UDim2.fromOffset(240, 52), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14),
		OnClick = function()
			done = true
		end,
	})
	while not done do
		task.wait(0.05)
	end
	box:Destroy()
end

local function playReveal(results, quick)
	local overlay = Instance.new("TextButton")
	overlay.Name = "RollReveal"
	overlay.AutoButtonColor = false
	overlay.Text = ""
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.fromRGB(10, 6, 24)
	overlay.BackgroundTransparency = 1
	overlay.BorderSizePixel = 0
	overlay.ZIndex = 1
	overlay.Parent = UI.Overlay
	UI.Tween(overlay, 0.2, { BackgroundTransparency = 0.25 })
	local stage = Instance.new("Frame")
	stage.BackgroundTransparency = 1
	stage.AnchorPoint = Vector2.new(0.5, 0.5)
	stage.Position = UDim2.fromScale(0.5, 0.5)
	stage.Size = UDim2.fromOffset(640, 560)
	stage.Parent = overlay
	local state = { skip = false }
	local skipBtn
	if #results > 1 then
		skipBtn = UI.Button(overlay, {
			Text = "SKIP ▶▶", Color = Color3.fromRGB(90, 85, 130), TextSize = 18, Size = UDim2.fromOffset(120, 40), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16), ZIndex = 20,
			OnClick = function()
				state.skip = true
			end,
		})
	end
	for _, r in ipairs(results) do
		if state.skip then
			break
		end
		revealOne(overlay, stage, r, #results, quick, state)
	end
	if skipBtn then
		skipBtn:Destroy()
	end
	if #results > 1 then
		showGrid(overlay, results)
	end
	UI.Tween(overlay, 0.15, { BackgroundTransparency = 1 })
	task.wait(0.16)
	overlay:Destroy()
end

----------------------------------------------------------------------- panel
function RollPanel.Init()
	local panel = UI.Panel("Roll", "🎲  Pet Roller", UDim2.fromOffset(780, 480))
	local body = panel.Body
	RollPanel.Panel = panel

	-- odds column
	local odds = UI.Frame(body, { Color = C.Dark, Transparency = 0.2, Size = UDim2.fromOffset(250, 408), Position = UDim2.fromOffset(14, 6), Radius = 14 })
	UI.Label(odds, { Text = "ROLL CHANCES", TextSize = 18, Font = BLACK, Color = C.Gold, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 6) })
	local luckLabel = UI.Label(odds, { Text = "🍀 Luck x1.00", TextSize = 16, Color = C.Good, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 34) })
	local oddsRows = {}
	for i, r in ipairs(Config.Rarities) do
		local row = UI.Frame(odds, { Color = r.Color, Transparency = 0.82, Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 62 + (i - 1) * 42), Radius = 8, Stroke = r.Color, StrokeTransparency = 0.5 })
		UI.Label(row, { Text = r.Name, TextSize = 17, Font = BLACK, Color = r.Color, XAlign = LEFT, Size = UDim2.new(0.55, 0, 1, 0), Position = UDim2.fromOffset(10, 0) })
		oddsRows[i] = UI.Label(row, { Text = "", TextSize = 16, XAlign = Enum.TextXAlignment.Right, Size = UDim2.new(0.45, -10, 1, 0), Position = UDim2.fromScale(0.55, 0) })
	end

	-- stage
	local stage = UI.Frame(body, { Color = C.Bg2, Transparency = 0.35, Size = UDim2.fromOffset(484, 408), Position = UDim2.fromOffset(280, 6), Radius = 14 })
	local cap = UI.Frame(stage, { Name = "Capsule", Color = Color3.fromRGB(245, 245, 255), Size = UDim2.fromOffset(150, 150), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Radius = 75, Stroke = Color3.fromRGB(150, 140, 200), StrokeThickness = 5 })
	circle(cap)
	local cg = Instance.new("UIGradient")
	cg.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 160, 215))
	cg.Rotation = 90
	cg.Parent = cap
	UI.Label(cap, { Text = "?", TextSize = 90, Font = BLACK, Color = Color3.fromRGB(110, 90, 190) })
	local capScale = Instance.new("UIScale")
	capScale.Parent = cap
	task.spawn(function()
		while true do
			if panel.IsOpen and not busy then
				UI.Tween(capScale, 0.9, { Scale = 1.06 }, Enum.EasingStyle.Sine)
				task.wait(0.9)
				UI.Tween(capScale, 0.9, { Scale = 0.97 }, Enum.EasingStyle.Sine)
				task.wait(0.9)
			else
				task.wait(0.4)
			end
		end
	end)

	local buttons = {}
	local function rollButton(count, x)
		local b = UI.Button(stage, {
			Name = "Roll" .. count, Text = "", Color = Color3.fromRGB(150, 85, 245), Size = UDim2.fromOffset(148, 74), Position = UDim2.fromOffset(x, 186), Radius = 14,
			OnClick = function()
				RollPanel.Roll(count, "coins")
			end,
		})
		UI.Label(b, { Text = "ROLL x" .. count, TextSize = 22, Font = BLACK, Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 4), Stroke = true })
		local price = UI.Label(b, { Name = "Price", Text = "🪙 100", TextSize = 18, Color = C.Gold, Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 38), Stroke = true })
		buttons[count] = { Button = b, Price = price }
		return b
	end
	RollPanel.Refs.Roll1 = rollButton(1, 12)
	rollButton(5, 168)
	rollButton(10, 324)

	-- boss rolls
	local bossButtons = {}
	for i, count in ipairs({ 1, 5 }) do
		local b = UI.Button(stage, {
			Name = "Boss" .. count, Text = "", Color = Color3.fromRGB(215, 140, 30), Size = UDim2.fromOffset(230, 56), Position = UDim2.fromOffset(12 + (i - 1) * 242, 274), Radius = 14,
			OnClick = function()
				RollPanel.Roll(count, "boss")
			end,
		})
		UI.Label(b, { Text = string.format("👑 BOSS ROLL x%d", count), TextSize = 18, Font = BLACK, Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 3), Stroke = true })
		UI.Label(b, { Text = string.format("🏆 %d Boss Tokens - Epic or better!", Config.BossRollCost * count), TextSize = 13, Color = Color3.fromRGB(255, 240, 200), Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 31) })
		bossButtons[count] = b
	end

	local fastBtn
	fastBtn = UI.Button(stage, {
		Text = "⏩ Fast reveal: OFF", Color = Color3.fromRGB(80, 76, 120), TextSize = 16, Size = UDim2.fromOffset(200, 38), Position = UDim2.fromOffset(12, 350), Radius = 10,
		OnClick = function()
			fast = not fast
			fastBtn.Text = fast and "⏩ Fast reveal: ON" or "⏩ Fast reveal: OFF"
			fastBtn:SetAttribute("Base", fast and C.Good or Color3.fromRGB(80, 76, 120))
			fastBtn.BackgroundColor3 = fast and C.Good or Color3.fromRGB(80, 76, 120)
		end,
	})
	local info = UI.Label(stage, { Text = "", TextSize = 15, Color = C.Muted, XAlign = Enum.TextXAlignment.Right, Size = UDim2.fromOffset(250, 38), Position = UDim2.fromOffset(224, 350) })

	local function refresh()
		local d = State.Data
		if not d then
			return
		end
		local luck = d.Derived.LuckMult
		luckLabel.Text = string.format("🍀 Luck x%.2f  (Rare+ chances)", luck)
		for i, o in ipairs(PetData.Odds(luck)) do
			oddsRows[i].Text = pct(o.Percent)
		end
		for count, b in pairs(buttons) do
			local price = Config.RollPrice(d.Stats.Rolls, count)
			b.Price.Text = "🪙 " .. Config.Format(price)
			UI.SetEnabled(b.Button, d.Coins >= price)
		end
		for count, b in pairs(bossButtons) do
			UI.SetEnabled(b, d.Materials.Tokens >= Config.BossRollCost * count)
		end
		info.Text = string.format("Pets found: %d/%d   Rolls: %s", State.DiscoveredCount(), PetData.Count, Config.Format(d.Stats.Rolls))
	end
	State.OnChanged(refresh)
	panel.OnOpen = refresh

	return panel
end

function RollPanel.Roll(count, mode)
	if busy then
		return
	end
	busy = true
	task.spawn(function()
		local ok, res = pcall(function()
			return Net.Get("Roll"):InvokeServer(count, mode)
		end)
		if not ok or type(res) ~= "table" or not res.ok then
			busy = false
			UI.Toast((type(res) == "table" and res.err) or "Roll failed, try again.", "error")
			return
		end
		RollPanel.LastResults = res.Results
		playReveal(res.Results, fast and #res.Results > 1 or #res.Results >= 10)
		busy = false
		RollPanel.RollsDone = (RollPanel.RollsDone or 0) + 1
	end)
end

function RollPanel.IsBusy()
	return busy
end

return RollPanel
end

----------------------------------------------------------------------
-- module: InventoryPanel
----------------------------------------------------------------------
Defs.InventoryPanel = function()
-- Pet inventory: grid of every pet you own, sorting, equip / unequip, equip best, detail view.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = Mod("Config")
local PetData = Mod("PetData")
local PetModels = Mod("PetModels")
local Net = Mod("Net")
local UI = Mod("UI")
local State = Mod("State")

local InventoryPanel = {}
local C = UI.C
local BLACK = Enum.Font.GothamBlack

local sortMode = "Rarity"
local selected = nil
local cards = {} -- [id] = { card, count, equipped }

local function sortKey(id)
	local p = PetData.Pets[id]
	if sortMode == "Damage" then
		return p.Damage
	elseif sortMode == "Income" then
		return p.Income
	end
	return p.RarityIndex * 1000000 + PetData.Score(id)
end

function InventoryPanel.Init()
	local panel = UI.Panel("Inventory", "🐾  My Pets", UDim2.fromOffset(900, 500))
	local body = panel.Body
	InventoryPanel.Panel = panel

	-- top bar -----------------------------------------------------------
	local slotsLabel = UI.Label(body, { Text = "Equipped 0/3", TextSize = 20, Font = BLACK, Color = C.Gold, XAlign = Enum.TextXAlignment.Left, Size = UDim2.fromOffset(170, 34), Position = UDim2.fromOffset(18, 6) })
	local sortButtons = {}
	local function refreshSortColors()
		for mode, b in pairs(sortButtons) do
			b.BackgroundColor3 = (mode == sortMode) and C.Accent or Color3.fromRGB(80, 76, 120)
			b:SetAttribute("Base", b.BackgroundColor3)
		end
	end
	for i, mode in ipairs({ "Rarity", "Damage", "Income" }) do
		sortButtons[mode] = UI.Button(body, {
			Text = mode, TextSize = 15, Size = UDim2.fromOffset(84, 34), Position = UDim2.fromOffset(190 + (i - 1) * 90, 6), Radius = 10,
			OnClick = function()
				sortMode = mode
				refreshSortColors()
				InventoryPanel.Refresh()
			end,
		})
	end
	UI.Button(body, {
		Text = "⭐ EQUIP BEST", Color = C.Good, TextSize = 16, Size = UDim2.fromOffset(150, 34), Position = UDim2.fromOffset(470, 6), Radius = 10,
		OnClick = function()
			Net.Get("EquipBest"):FireServer()
		end,
	})
	UI.Button(body, {
		Text = "UNEQUIP ALL", Color = C.Bad, TextSize = 15, Size = UDim2.fromOffset(130, 34), Position = UDim2.fromOffset(628, 6), Radius = 10,
		OnClick = function()
			Net.Get("UnequipAll"):FireServer()
		end,
	})
	refreshSortColors()

	-- grid ------------------------------------------------------------------
	local gridFrame = UI.Frame(body, { Color = C.Dark, Transparency = 0.35, Size = UDim2.fromOffset(580, 400), Position = UDim2.fromOffset(14, 48), Radius = 12, Clip = true })
	local scroll = UI.Scroll(gridFrame, { Size = UDim2.new(1, -8, 1, -12), Position = UDim2.fromOffset(6, 6) })
	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.fromOffset(104, 126)
	gl.CellPadding = UDim2.fromOffset(6, 6)
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.Parent = scroll
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 4)
	pad.Parent = scroll
	local empty = UI.Label(gridFrame, { Text = "You have no pets yet!\nOpen the Roller (🎲) to get your first one.", TextSize = 20, Color = C.Muted, Wrap = true, Size = UDim2.fromScale(0.8, 0.4), Position = UDim2.fromScale(0.1, 0.3) })

	-- detail pane ---------------------------------------------------------
	local detail = UI.Frame(body, { Color = C.Bg2, Transparency = 0.3, Size = UDim2.fromOffset(276, 400), Position = UDim2.fromOffset(608, 48), Radius = 12 })
	local vpHolder = UI.Frame(detail, { Color = C.Dark, Transparency = 0.4, Size = UDim2.new(1, -20, 0, 170), Position = UDim2.fromOffset(10, 10), Radius = 12, Clip = true })
	local dName = UI.Label(detail, { Text = "Select a pet", TextSize = 24, Font = BLACK, Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 184), Stroke = true })
	local dRarity = UI.Label(detail, { Text = "", TextSize = 17, Font = BLACK, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 214) })
	local dStats = UI.Label(detail, { Text = "", TextSize = 18, Size = UDim2.new(1, -16, 0, 50), Position = UDim2.fromOffset(8, 238), Wrap = true })
	local dOwned = UI.Label(detail, { Text = "", TextSize = 16, Color = C.Muted, Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 290) })
	local equipBtn = UI.Button(detail, {
		Text = "EQUIP", Color = C.Good, TextSize = 20, Size = UDim2.fromOffset(120, 48), Position = UDim2.fromOffset(10, 330), Radius = 12,
		OnClick = function()
			if selected then
				Net.Get("EquipPet"):FireServer(selected)
			end
		end,
	})
	local unequipBtn = UI.Button(detail, {
		Text = "UNEQUIP", Color = C.Bad, TextSize = 18, Size = UDim2.fromOffset(120, 48), Position = UDim2.new(1, -130, 0, 330), Radius = 12,
		OnClick = function()
			if selected then
				Net.Get("UnequipPet"):FireServer(selected)
			end
		end,
	})
	local dBoost = UI.Label(detail, { Text = "", TextSize = 13, Color = C.Muted, Size = UDim2.new(1, -16, 0, 18), Position = UDim2.new(0, 8, 1, -20) })
	local detailVP

	local function showDetail()
		if detailVP then
			detailVP:Destroy()
			detailVP = nil
		end
		local d = State.Data
		if not selected or not d then
			dName.Text, dRarity.Text, dStats.Text, dOwned.Text = "Select a pet", "", "", ""
			UI.SetEnabled(equipBtn, false)
			UI.SetEnabled(unequipBtn, false)
			return
		end
		local pet = PetData.Pets[selected]
		local rc = Config.Rarities[pet.RarityIndex].Color
		local vp, model = PetModels.Viewport(selected)
		vp.Size = UDim2.fromScale(1, 1)
		vp.Parent = vpHolder
		UI.Spin(model)
		detailVP = vp
		dName.Text = pet.Name
		dRarity.Text = "★ " .. pet.Rarity .. " ★"
		dRarity.TextColor3 = rc
		dStats.Text = string.format("💰 %s coins/s\n⚔ %s damage", Config.Format(pet.Income), Config.Format(pet.Damage * d.Derived.DamageMult))
		local owned = State.Owned(selected)
		local eq = State.EquippedCount(selected)
		dOwned.Text = string.format("Owned: %d   Equipped: %d", owned, eq)
		local slots = d.Derived.Slots
		UI.SetEnabled(equipBtn, eq < owned and #d.Equipped < slots)
		UI.SetEnabled(unequipBtn, eq > 0)
		dBoost.Text = string.format("Slots used: %d/%d", #d.Equipped, slots)
	end

	local function select(id)
		selected = id
		for cid, c in pairs(cards) do
			local stroke = c.card.Frame:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Thickness = (cid == id) and 5 or 2.5
			end
		end
		showDetail()
	end

	local function makeCard(id, count, eq)
		local c = UI.PetCard(scroll, id, {
			Size = UDim2.fromOffset(104, 126), Count = count, Equipped = eq > 0,
			OnClick = function()
				select(id)
			end,
		})
		return c
	end

	function InventoryPanel.Refresh()
		local d = State.Data
		if not d then
			return
		end
		local ids = {}
		for key, n in pairs(d.Pets) do
			local id = tonumber(key)
			if id and n > 0 and PetData.Pets[id] then
				table.insert(ids, id)
			end
		end
		local seen = {}
		for _, id in ipairs(ids) do
			seen[id] = true
			local count, eq = State.Owned(id), State.EquippedCount(id)
			local c = cards[id]
			if not c or c.count ~= count or c.equipped ~= eq then
				if c then
					c.card.Frame:Destroy()
				end
				c = { card = makeCard(id, count, eq), count = count, equipped = eq }
				cards[id] = c
			end
		end
		for id, c in pairs(cards) do
			if not seen[id] then
				c.card.Frame:Destroy()
				cards[id] = nil
			end
		end
		table.sort(ids, function(a, b)
			local ka, kb = sortKey(a), sortKey(b)
			if ka ~= kb then
				return ka > kb
			end
			return a < b
		end)
		for i, id in ipairs(ids) do
			cards[id].card.Frame.LayoutOrder = i
		end
		empty.Visible = #ids == 0
		slotsLabel.Text = string.format("Equipped %d/%d", #d.Equipped, d.Derived.Slots)
		if selected and not seen[selected] then
			selected = nil
		end
		if not selected and ids[1] then
			select(ids[1])
		else
			select(selected)
		end
	end

	State.OnChanged(function()
		if panel.IsOpen then
			InventoryPanel.Refresh()
		end
	end)
	panel.OnOpen = InventoryPanel.Refresh
	return panel
end

return InventoryPanel
end

----------------------------------------------------------------------
-- module: IndexPanel
----------------------------------------------------------------------
Defs.IndexPanel = function()
-- Pet Index: every pet in the game (discovered ones in colour, undiscovered as silhouettes) plus milestone rewards.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = Mod("Config")
local PetData = Mod("PetData")
local Net = Mod("Net")
local UI = Mod("UI")
local State = Mod("State")

local IndexPanel = {}
local C = UI.C
local BLACK = Enum.Font.GothamBlack
local LEFT = Enum.TextXAlignment.Left

local tab = 1 -- 1..8 rarity, 9 = rewards

local function rewardText(r)
	local parts = {}
	if r.Coins then
		table.insert(parts, "🪙 " .. Config.Format(r.Coins))
	end
	for _, m in ipairs(Config.MaterialOrder) do
		if r[m] then
			table.insert(parts, Config.Materials[m].Icon .. " " .. r[m])
		end
	end
	if r.Potions then
		for _, k in ipairs(Config.PotionOrder) do
			if r.Potions[k] then
				table.insert(parts, Config.Potions[k].Icon .. " x" .. r.Potions[k])
			end
		end
	end
	return table.concat(parts, "   ")
end

function IndexPanel.Init()
	local panel = UI.Panel("Index", "📖  Pet Index", UDim2.fromOffset(920, 510))
	local body = panel.Body
	IndexPanel.Panel = panel

	local progress = UI.Label(body, { Text = "", TextSize = 18, Font = BLACK, Color = C.Gold, XAlign = LEFT, Size = UDim2.fromOffset(300, 28), Position = UDim2.fromOffset(18, 4) })
	local barBack = UI.Frame(body, { Color = C.Dark, Size = UDim2.fromOffset(560, 18), Position = UDim2.fromOffset(330, 9), Radius = 9, Clip = true })
	local barFill = UI.Frame(barBack, { Color = C.Good, Size = UDim2.fromScale(0, 1), Radius = 9 })

	-- tabs
	local tabButtons = {}
	local function styleTabs()
		for i, b in pairs(tabButtons) do
			local col = (i == 9) and C.Gold or Config.Rarities[i].Color
			b.BackgroundColor3 = (i == tab) and col or col:Lerp(Color3.fromRGB(30, 26, 52), 0.7)
			b:SetAttribute("Base", b.BackgroundColor3)
			b.TextColor3 = (i == tab) and Color3.fromRGB(20, 14, 36) or Color3.new(1, 1, 1)
		end
	end
	for i = 1, 9 do
		local name = (i == 9) and "🎁 Rewards" or Config.Rarities[i].Name
		tabButtons[i] = UI.Button(body, {
			Text = name, TextSize = 13, Size = UDim2.fromOffset(i == 9 and 104 or 92, 32), Position = UDim2.fromOffset(14 + (i - 1) * 96 + (i == 9 and 0 or 0), 38), Radius = 9,
			OnClick = function()
				tab = i
				IndexPanel.Refresh()
			end,
		})
	end

	local area = UI.Frame(body, { Color = C.Dark, Transparency = 0.35, Size = UDim2.fromOffset(892, 330), Position = UDim2.fromOffset(14, 76), Radius = 12, Clip = true })
	local scroll = UI.Scroll(area, { Size = UDim2.new(1, -8, 1, -10), Position = UDim2.fromOffset(4, 5) })
	local info = UI.Label(body, { Text = "Tap a pet to see its details.", TextSize = 16, Color = C.Text, Size = UDim2.fromOffset(892, 40), Position = UDim2.fromOffset(14, 412), Wrap = true })

	local built = {} -- instances created for the current tab

	local function clearBuilt()
		for _, i in ipairs(built) do
			i:Destroy()
		end
		table.clear(built)
		for _, c in ipairs(scroll:GetChildren()) do
			if not c:IsA("UIGridLayout") and not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
				c:Destroy()
			end
		end
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("UIGridLayout") or c:IsA("UIListLayout") then
				c:Destroy()
			end
		end
	end

	local function buildPets()
		local rarity = Config.Rarities[tab]
		local gl = Instance.new("UIGridLayout")
		gl.CellSize = UDim2.fromOffset(104, 126)
		gl.CellPadding = UDim2.fromOffset(7, 7)
		gl.SortOrder = Enum.SortOrder.LayoutOrder
		gl.Parent = scroll
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft, pad.PaddingTop = UDim.new(0, 6), UDim.new(0, 6)
		pad.Parent = scroll
		table.insert(built, pad)
		for i, id in ipairs(PetData.ByRarity[rarity.Name]) do
			local found = State.Discovered(id)
			local pet = PetData.Pets[id]
			local card = UI.PetCard(scroll, id, {
				Size = UDim2.fromOffset(104, 126), Locked = not found, Count = found and State.Owned(id) or nil,
				Hint = found and nil or (pet.Boss and "BOSS DROP" or "Undiscovered"),
				OnClick = function()
					if found then
						info.Text = string.format("%s  (%s)    💰 %s/s    ⚔ %s    Owned: %d", pet.Name, pet.Rarity, Config.Format(pet.Income), Config.Format(pet.Damage), State.Owned(id))
						info.TextColor3 = rarity.Color
					elseif pet.Boss then
						info.Text = "??? - " .. (PetData.BossHint[pet.Boss] or "Dropped by a boss")
						info.TextColor3 = C.Gold
					else
						info.Text = "??? - Roll the machine to discover this " .. pet.Rarity .. " pet!"
						info.TextColor3 = C.Muted
					end
				end,
			})
			card.Frame.LayoutOrder = i
		end
	end

	local function rewardRow(order, title, sub, rewardStr, key, ready)
		local d = State.Data
		local claimed = d.IndexClaimed[key] == true
		local row = UI.Frame(scroll, { Name = "Row", Color = C.Bg2, Transparency = 0.2, Size = UDim2.new(1, -14, 0, 58), Radius = 10, Stroke = claimed and C.Good or (ready and C.Gold or Color3.fromRGB(70, 64, 110)) })
		row.LayoutOrder = order
		UI.Label(row, { Text = title, TextSize = 18, Font = BLACK, XAlign = LEFT, Size = UDim2.new(0.5, 0, 0, 26), Position = UDim2.fromOffset(14, 4) })
		UI.Label(row, { Text = sub, TextSize = 13, Color = C.Muted, XAlign = LEFT, Size = UDim2.new(0.5, 0, 0, 20), Position = UDim2.fromOffset(14, 32) })
		UI.Label(row, { Text = rewardStr, TextSize = 15, Color = C.Gold, XAlign = LEFT, Size = UDim2.new(0.34, 0, 1, 0), Position = UDim2.fromScale(0.46, 0), Wrap = true })
		local b = UI.Button(row, {
			Text = claimed and "CLAIMED ✔" or (ready and "CLAIM" or "LOCKED"), Color = C.Good, TextSize = 16, Size = UDim2.fromOffset(112, 38), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Radius = 10,
			OnClick = function()
				Net.Get("ClaimIndex"):FireServer(key)
			end,
		})
		UI.SetEnabled(b, ready and not claimed)
		if claimed then
			b.TextTransparency = 0
			b.BackgroundColor3 = Color3.fromRGB(50, 110, 75)
		end
	end

	local function buildRewards()
		local d = State.Data
		local ll = Instance.new("UIListLayout")
		ll.Padding = UDim.new(0, 6)
		ll.SortOrder = Enum.SortOrder.LayoutOrder
		ll.Parent = scroll
		local order = 0
		local function header(text)
			order += 1
			local l = UI.Label(scroll, { Text = text, TextSize = 20, Font = BLACK, Color = C.Gold, XAlign = LEFT, Size = UDim2.new(1, -14, 0, 28), Stroke = true })
			l.LayoutOrder = order
		end
		header("  Discovery milestones")
		local found = State.DiscoveredCount()
		for _, m in ipairs(Config.IndexMilestones) do
			order += 1
			rewardRow(order, m.Need .. " pets discovered", string.format("%d / %d", math.min(found, m.Need), m.Need), rewardText(m.Reward), "m:" .. m.Need, found >= m.Need)
		end
		header("  Rarity collections")
		for _, r in ipairs(Config.Rarities) do
			order += 1
			local list = PetData.ByRarity[r.Name]
			local have = 0
			for _, id in ipairs(list) do
				if State.Discovered(id) then
					have += 1
				end
			end
			rewardRow(order, "All " .. r.Name .. " pets", string.format("%d / %d", have, #list), rewardText(Config.RarityRewards[r.Name]), "r:" .. r.Name, have >= #list)
		end
	end

	function IndexPanel.Refresh()
		local d = State.Data
		if not d then
			return
		end
		local n = State.DiscoveredCount()
		progress.Text = string.format("Discovered %d / %d", n, PetData.Count)
		UI.Tween(barFill, 0.3, { Size = UDim2.fromScale(n / PetData.Count, 1) })
		for i = 1, 8 do
			local list = PetData.ByRarity[Config.Rarities[i].Name]
			local have = 0
			for _, id in ipairs(list) do
				if State.Discovered(id) then
					have += 1
				end
			end
			tabButtons[i].Text = string.format("%s %d/%d", Config.Rarities[i].Name, have, #list)
			tabButtons[i].TextSize = 11
		end
		styleTabs()
		local keep = scroll.CanvasPosition
		clearBuilt()
		if tab == 9 then
			buildRewards()
			info.Text = "Discover pets to unlock rewards. Boss-exclusive pets only drop from boss waves!"
			info.TextColor3 = C.Muted
		else
			buildPets()
		end
		scroll.CanvasPosition = keep
	end

	State.OnChanged(function()
		if panel.IsOpen then
			IndexPanel.Refresh()
		end
	end)
	panel.OnOpen = IndexPanel.Refresh
	return panel
end

return IndexPanel
end

----------------------------------------------------------------------
-- module: ShopPanel
----------------------------------------------------------------------
Defs.ShopPanel = function()
-- Shop with three tabs: permanent Upgrades (coins), Potions (use them) and Crafting (materials -> potions / coins).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = Mod("Config")
local Net = Mod("Net")
local UI = Mod("UI")
local State = Mod("State")

local ShopPanel = {}
local C = UI.C
local BLACK = Enum.Font.GothamBlack
local LEFT = Enum.TextXAlignment.Left

local tab = 1
local TABS = { "⬆ Upgrades", "🧪 Potions", "⚒ Crafting" }

local function mmss(s)
	s = math.max(0, math.floor(s))
	return string.format("%d:%02d", s // 60, s % 60)
end

function ShopPanel.Init()
	local panel = UI.Panel("Shop", "🛒  Shop", UDim2.fromOffset(800, 500))
	local body = panel.Body
	ShopPanel.Panel = panel

	local tabButtons = {}
	local function styleTabs()
		for i, b in ipairs(tabButtons) do
			b.BackgroundColor3 = (i == tab) and C.Accent or Color3.fromRGB(70, 66, 110)
			b:SetAttribute("Base", b.BackgroundColor3)
		end
	end
	for i, name in ipairs(TABS) do
		tabButtons[i] = UI.Button(body, {
			Text = name, TextSize = 17, Size = UDim2.fromOffset(150, 38), Position = UDim2.fromOffset(16 + (i - 1) * 156, 6), Radius = 10,
			OnClick = function()
				tab = i
				ShopPanel.Refresh()
			end,
		})
	end
	local coinLabel = UI.Label(body, { Text = "", TextSize = 20, Font = BLACK, Color = C.Gold, XAlign = Enum.TextXAlignment.Right, Size = UDim2.fromOffset(300, 38), Position = UDim2.new(1, -316, 0, 6) })

	local area = UI.Frame(body, { Color = C.Dark, Transparency = 0.35, Size = UDim2.fromOffset(768, 392), Position = UDim2.fromOffset(16, 52), Radius = 12, Clip = true })
	local scroll = UI.Scroll(area, { Size = UDim2.new(1, -8, 1, -10), Position = UDim2.fromOffset(4, 5) })
	local ll = Instance.new("UIListLayout")
	ll.Padding = UDim.new(0, 6)
	ll.SortOrder = Enum.SortOrder.LayoutOrder
	ll.Parent = scroll
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft, pad.PaddingTop = UDim.new(0, 4), UDim.new(0, 4)
	pad.Parent = scroll

	local timerLabels = {} -- [potionKey] = {label, button}

	local function clear()
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		table.clear(timerLabels)
	end

	local function row(order, icon, title, desc, accent)
		local f = UI.Frame(scroll, { Name = "Row", Color = C.Bg2, Transparency = 0.2, Size = UDim2.new(1, -14, 0, 64), Radius = 10, Stroke = accent or Color3.fromRGB(70, 64, 110) })
		f.LayoutOrder = order
		UI.Label(f, { Text = icon, TextSize = 34, Size = UDim2.fromOffset(56, 64) })
		UI.Label(f, { Text = title, TextSize = 19, Font = BLACK, XAlign = LEFT, Size = UDim2.new(0.5, 0, 0, 28), Position = UDim2.fromOffset(60, 6) })
		local sub = UI.Label(f, { Text = desc, TextSize = 14, Color = C.Muted, XAlign = LEFT, Size = UDim2.new(0.55, 0, 0, 22), Position = UDim2.fromOffset(60, 34) })
		return f, sub
	end

	local function actionButton(parent, text, color, enabled, fn)
		local b = UI.Button(parent, {
			Text = text, Color = color, TextSize = 16, Size = UDim2.fromOffset(150, 44), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Radius = 10, OnClick = fn,
		})
		UI.SetEnabled(b, enabled)
		return b
	end

	local function buildUpgrades(d)
		for i, u in ipairs(Config.Upgrades) do
			local level = d.Upgrades[u.Key]
			local cost = Config.UpgradeCost(u.Key, level)
			local f, sub = row(i, u.Icon, string.format("%s   Lv %d/%d", u.Name, level, u.Max), u.Desc, (u.Key == "Slots") and C.Gold or nil)
			if u.Key == "Slots" then
				sub.Text = string.format("%s  (%d / %d slots)", u.Desc, d.Derived.Slots, Config.MaxSlots)
			end
			if cost then
				actionButton(f, "🪙 " .. Config.Format(cost), C.Good, d.Coins >= cost, function()
					Net.Get("BuyUpgrade"):FireServer(u.Key)
				end)
			else
				local b = actionButton(f, "MAXED ✔", Color3.fromRGB(70, 130, 95), false, nil)
				b.TextTransparency = 0
			end
		end
	end

	local function buildPotions(d)
		for i, k in ipairs(Config.PotionOrder) do
			local p = Config.Potions[k]
			local f, sub = row(i, p.Icon, string.format("%s   x%d", p.Name, d.Potions[k]), p.Desc .. " for " .. mmss(Config.PotionDuration) .. " (stacks time)", p.Color)
			local b = actionButton(f, "USE", C.Accent, d.Potions[k] > 0, function()
				Net.Get("UsePotion"):FireServer(k)
			end)
			timerLabels[k] = { Label = sub, Button = b, Desc = p.Desc .. " for " .. mmss(Config.PotionDuration) .. " (stacks time)" }
		end
		local tip = UI.Label(scroll, { Text = "Get potions from fights, daily rewards, the Pet Index and crafting.", TextSize = 15, Color = C.Muted, Size = UDim2.new(1, -14, 0, 28) })
		tip.LayoutOrder = 99
	end

	local function costText(cost)
		local parts = {}
		for _, m in ipairs(Config.MaterialOrder) do
			if cost[m] then
				table.insert(parts, Config.Materials[m].Icon .. " " .. cost[m])
			end
		end
		return table.concat(parts, "  ")
	end

	local function buildCraft(d)
		for i, r in ipairs(Config.Craft) do
			local can = true
			for mat, n in pairs(r.Cost) do
				if d.Materials[mat] < n then
					can = false
				end
			end
			local desc = "Needs " .. costText(r.Cost)
			if r.Give.CoinsFromIncome then
				desc = desc .. "  -  coins equal to ~15 min of your income"
			elseif r.Give.Potions then
				local n = 0
				for _, v in pairs(r.Give.Potions) do
					n += v
				end
				desc = desc .. string.format("  -  gives %d potion%s", n, n > 1 and "s" or "")
			end
			local f = row(i, r.Icon, r.Name, desc)
			actionButton(f, "CRAFT", C.Good, can, function()
				Net.Get("Craft"):FireServer(r.Key)
			end)
		end
	end

	function ShopPanel.Refresh()
		local d = State.Data
		if not d then
			return
		end
		styleTabs()
		coinLabel.Text = "🪙 " .. Config.Format(d.Coins)
		local keep = scroll.CanvasPosition
		clear()
		if tab == 1 then
			buildUpgrades(d)
		elseif tab == 2 then
			buildPotions(d)
		else
			buildCraft(d)
		end
		scroll.CanvasPosition = keep
	end

	-- live potion timers
	task.spawn(function()
		while true do
			task.wait(1)
			if panel.IsOpen and tab == 2 then
				for k, t in pairs(timerLabels) do
					if t.Label.Parent then
						local left = State.PotionLeft(k)
						t.Label.Text = left > 0 and ("ACTIVE  " .. mmss(left) .. " left") or t.Desc
						t.Label.TextColor3 = left > 0 and C.Good or C.Muted
					end
				end
			end
		end
	end)

	State.OnChanged(function()
		if panel.IsOpen then
			ShopPanel.Refresh()
		end
	end)
	panel.OnOpen = ShopPanel.Refresh
	return panel
end

return ShopPanel
end

----------------------------------------------------------------------
-- module: Tutorial
----------------------------------------------------------------------
Defs.Tutorial = function()
-- Short interactive tutorial (always skippable). It watches what you do, so each step completes when you actually do it.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = Mod("Net")
local UI = Mod("UI")
local State = Mod("State")
local Hud = Mod("Hud")

local Tutorial = { Running = false }
local C = UI.C
local BLACK = Enum.Font.GothamBlack

function Tutorial.Start(panels)
	if Tutorial.Running then
		return
	end
	Tutorial.Running = true
	local R = Hud.Refs
	local finished = false
	local skipped = false

	-- UI ------------------------------------------------------------------
	local box = UI.Frame(UI.Overlay, { Name = "Tutorial", Color = C.Bg, Size = UDim2.fromOffset(330, 190), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 14, 0.5, 0), Radius = 16, Stroke = C.Gold, StrokeThickness = 3 })
	box.ZIndex = 30
	local title = UI.Label(box, { Text = "", TextSize = 21, Font = BLACK, Color = C.Gold, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 6), ZIndex = 31, Stroke = true })
	local text = UI.Label(box, { Text = "", TextSize = 17, Wrap = true, XAlign = Enum.TextXAlignment.Left, YAlign = Enum.TextYAlignment.Top, Size = UDim2.new(1, -24, 0, 90), Position = UDim2.fromOffset(12, 40), ZIndex = 31 })
	local stepLabel = UI.Label(box, { Text = "", TextSize = 13, Color = C.Muted, XAlign = Enum.TextXAlignment.Left, Size = UDim2.fromOffset(80, 24), Position = UDim2.new(0, 12, 1, -30), ZIndex = 31 })
	local nextBtn = UI.Button(box, { Text = "NEXT ▶", Color = C.Good, TextSize = 17, Size = UDim2.fromOffset(110, 36), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -10, 1, -10), Radius = 10, ZIndex = 32 })
	local skipBtn = UI.Button(box, { Text = "Skip", Color = Color3.fromRGB(100, 94, 140), TextSize = 15, Size = UDim2.fromOffset(70, 30), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -130, 1, -13), Radius = 9, ZIndex = 32 })
	local sc = Instance.new("UIScale")
	sc.Scale = 0.6
	sc.Parent = box
	UI.Tween(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)

	local hl = Instance.new("Frame")
	hl.Name = "TutorialHighlight"
	hl.BackgroundTransparency = 1
	hl.AnchorPoint = Vector2.new(0.5, 0.5)
	hl.ZIndex = 29
	hl.Visible = false
	hl.Parent = UI.Overlay
	UI.Corner(hl, 16)
	local hlStroke = UI.Stroke(hl, C.Gold, 5, 0)
	local arrow = UI.Label(hl, { Text = "👇", TextSize = 36, Size = UDim2.fromOffset(40, 40), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -4), ZIndex = 29 })

	local target = nil
	local conn = RunService.RenderStepped:Connect(function()
		if target and target.Parent and target.Visible and target.AbsoluteSize.X > 0 then
			local s = UI.ScaleValue or 1
			local p, z = target.AbsolutePosition, target.AbsoluteSize
			hl.Visible = true
			local pulse = 1 + math.sin(os.clock() * 6) * 0.05
			hl.Position = UDim2.fromOffset((p.X + z.X / 2) / s, (p.Y + z.Y / 2) / s)
			hl.Size = UDim2.fromOffset((z.X / s + 14) * pulse, (z.Y / s + 14) * pulse)
			hlStroke.Transparency = 0.1 + (math.sin(os.clock() * 6) + 1) * 0.15
			arrow.Position = UDim2.new(0.5, 0, 0, -4 + math.sin(os.clock() * 8) * 5)
		else
			hl.Visible = false
		end
	end)

	local function finish(wasSkipped)
		if finished then
			return
		end
		finished = true
		skipped = wasSkipped
		conn:Disconnect()
		Net.Get("TutorialDone"):FireServer()
		UI.Tween(sc, 0.2, { Scale = 0.1 })
		task.delay(0.22, function()
			box:Destroy()
			hl:Destroy()
		end)
		Tutorial.Running = false
		if not wasSkipped then
			UI.Toast("🎉 Tutorial complete - have fun!", "good")
		end
	end
	skipBtn.Activated:Connect(function()
		finish(true)
	end)

	-- step runner -------------------------------------------------------------
	local function show(i, total, t, msg, hlTarget, needNext)
		stepLabel.Text = string.format("Step %d/%d", i, total)
		title.Text = t
		text.Text = msg
		target = hlTarget
		nextBtn.Visible = needNext
	end

	local function waitFor(cond)
		while not finished and not cond() do
			task.wait(0.15)
		end
	end

	local function waitNext()
		local pressed = false
		local c = nextBtn.Activated:Connect(function()
			pressed = true
		end)
		waitFor(function()
			return pressed
		end)
		c:Disconnect()
	end

	task.spawn(function()
		local TOTAL = 8
		local d0 = State.Data
		local rolls0 = d0 and d0.Stats.Rolls or 0

		show(1, TOTAL, "👋 Welcome!", "Roll pets, equip them to earn coins, then fight waves of monsters! This quick tour takes about a minute. You can skip any time.", nil, true)
		waitNext()
		if finished then
			return
		end

		show(2, TOTAL, "🎲 Open the Roller", "Tap the ROLL button on the right side of your screen.", R.BtnRoll, false)
		waitFor(function()
			return panels.Roll.IsOpen
		end)
		if finished then
			return
		end

		show(3, TOTAL, "🪙 Roll a pet!", "You start with some coins. Press ROLL x1 to open a capsule. Better rarities are rarer!", nil, false)
		local rb = panels.Roll.Body:FindFirstChild("Roll1", true)
		target = rb
		waitFor(function()
			return State.Data and State.Data.Stats.Rolls > rolls0
		end)
		if finished then
			return
		end
		-- let the reveal animation play out
		local RollPanel = Mod("RollPanel")
		waitFor(function()
			return not RollPanel.IsBusy()
		end)
		if finished then
			return
		end
		panels.Roll:Close()

		show(4, TOTAL, "🐾 Equip your pet", "Open PETS, pick a pet and press EQUIP (or EQUIP BEST). Equipped pets follow you and earn coins!", R.BtnPets, false)
		waitFor(function()
			return State.Data and #State.Data.Equipped > 0
		end)
		if finished then
			return
		end
		task.wait(0.8)
		panels.Inventory:Close()

		show(5, TOTAL, "💰 Passive income", "Every few seconds your equipped pets pay out coins - even while you explore! Spend them on rolls and upgrades in the SHOP.", R.Coins, true)
		waitNext()
		if finished then
			return
		end

		show(6, TOTAL, "⚔ The Fight Portal", "Ready for battle? Tap FIGHT (or walk into the glowing portal at the end of the hub). Your pets fight for you!", R.BtnFight, false)
		waitFor(function()
			return State.Run.Active
		end)
		if finished then
			return
		end

		show(7, TOTAL, "🌊 Waves & bosses", "Enemies come in waves. Your pets attack automatically, and every 5th wave is a BOSS that can drop exclusive pets. Don't let your HP hit zero!", R.HP, true)
		waitNext()
		if finished then
			return
		end

		show(8, TOTAL, "🏁 END RUN", "Press END RUN any time to stop new waves, let your pets finish the fight and collect your rewards. You keep your rewards even if you lose!", R.EndRun, false)
		waitFor(function()
			return not State.Run.Active
		end)
		finish(false)
	end)
end

return Tutorial
end

----------------------------------------------------------------------
-- main
----------------------------------------------------------------------
-- Boots the whole client: UI, panels, effects, pet following, server events, prompts and the tutorial.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local player = Players.LocalPlayer

local Config = Mod("Config")
local Net = Mod("Net")
local UI = Mod("UI")
local State = Mod("State")
local Effects = Mod("Effects")
local PetFollow = Mod("PetFollow")
local Hud = Mod("Hud")
local RollPanel = Mod("RollPanel")
local InventoryPanel = Mod("InventoryPanel")
local IndexPanel = Mod("IndexPanel")
local ShopPanel = Mod("ShopPanel")
local Popups = Mod("Popups")
local Tutorial = Mod("Tutorial")

local C = UI.C

-- build everything --------------------------------------------------------------
UI.Init()
Effects.Init()
PetFollow.Init()

local panels = {
	Roll = RollPanel.Init(),
	Inventory = InventoryPanel.Init(),
	Index = IndexPanel.Init(),
	Shop = ShopPanel.Init(),
	Daily = Popups.InitDaily(),
}
Hud.Init(panels)

-- server events -----------------------------------------------------------------------
local tutorialStarted = false
Net.Get("Data").OnClientEvent:Connect(function(snapshot)
	State.Set(snapshot)
	if not tutorialStarted and not snapshot.Tutorial then
		tutorialStarted = true
		task.delay(1.5, function()
			Tutorial.Start(panels)
		end)
	end
end)

Net.Get("Income").OnClientEvent:Connect(function(amount)
	Hud.Income(amount)
end)

Net.Get("Toast").OnClientEvent:Connect(function(text, kind)
	UI.Toast(text, kind)
end)

Net.Get("RunStart").OnClientEvent:Connect(function(info)
	local run = State.Run
	run.Active = true
	run.Wave = 0
	run.HP = info.MaxHP
	run.MaxHP = info.MaxHP
	run.Left = 0
	run.Total = 0
	run.Coins = 0
	run.Kills = 0
	run.Ending = false
	run.Grace = 0
	Hud.SetCombat(true)
	Hud.UpdateRun()
	Hud.Banner("FIGHT!", Color3.fromRGB(255, 110, 90), "Your pets will fight for you", 2.2)
end)

Net.Get("WaveStart").OnClientEvent:Connect(function(wave, isBoss, total, bossName)
	State.Run.Wave = wave
	State.Run.Total = total
	State.Run.Left = total
	Hud.UpdateRun()
	if isBoss then
		Hud.Banner("⚠ BOSS WAVE " .. wave, Color3.fromRGB(255, 70, 70), bossName and (bossName .. " appears!") or nil, 2.6)
		Effects.Shake(0.8, 0.6)
		Effects.Flash(Color3.fromRGB(255, 40, 40), 0.8, 0.6)
	else
		Hud.Banner("WAVE " .. wave, C.Gold, total .. " enemies incoming", 1.6)
	end
end)

Net.Get("WaveClear").OnClientEvent:Connect(function(wave, bonus)
	Hud.Banner("WAVE " .. wave .. " CLEARED!", C.Good, "+" .. Config.Format(bonus) .. " 🪙 bonus   •   +30% HP", 1.8)
end)

Net.Get("RunStatus").OnClientEvent:Connect(function(t)
	local run = State.Run
	for k, v in pairs(t) do
		run[k] = v
	end
	if run.Active then
		Hud.UpdateRun()
	end
end)

Net.Get("RunEnd").OnClientEvent:Connect(function(summary)
	local run = State.Run
	run.Active = false
	run.Ending = false
	Hud.SetCombat(false)
	Hud.UpdateRun()
	Popups.ShowSummary(summary)
end)

Net.Get("PetHit").OnClientEvent:Connect(function(slotIndex, enemyRoot, dmg, crit)
	if not enemyRoot or not enemyRoot.Parent then
		return
	end
	PetFollow.Attack(player, slotIndex, enemyRoot)
	local pos = enemyRoot.Position + Vector3.new(0, 3, 0)
	Effects.Damage(pos, dmg, crit)
	Effects.Burst(pos, crit and Color3.fromRGB(255, 215, 70) or Color3.fromRGB(255, 255, 255), crit and 14 or 6, 14)
end)

Net.Get("EnemyDied").OnClientEvent:Connect(function(pos, isBoss, coins)
	Effects.Burst(pos, isBoss and Color3.fromRGB(255, 120, 60) or Color3.fromRGB(255, 220, 120), isBoss and 60 or 20, isBoss and 38 or 22)
	Effects.FloatText(pos + Vector3.new(0, 2, 0), "+" .. Config.Format(coins) .. " 🪙", C.Gold, isBoss and 38 or 26, 5)
	if isBoss then
		Effects.Shake(1.0, 0.5)
	end
end)

Net.Get("Hurt").OnClientEvent:Connect(function()
	Hud.Hurt()
end)

-- hub interaction prompts ---------------------------------------------------------------------
ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
	if who ~= player then
		return
	end
	local action = prompt:GetAttribute("Action")
	if action == "Roll" then
		panels.Roll:Open()
	elseif action == "Shop" then
		panels.Shop:Open()
	elseif action == "Daily" then
		panels.Daily:Open()
	elseif action == "Inventory" then
		panels.Inventory:Open()
	elseif action == "Index" then
		panels.Index:Open()
	end
end)

-- everything is connected: ask the server for our data
Net.Get("Ready"):FireServer()
]]></ProtectedString></Properties>
</Item>
</Item>
