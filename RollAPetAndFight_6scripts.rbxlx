<Item class="ServerStorage" referent="RBX7"><Properties><string name="Name">ServerStorage</string></Properties>
<Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">ServerLogic</string><ProtectedString name="Source"><![CDATA[-- ModuleScript named "ServerLogic"
-- Location: ServerStorage > ServerLogic
-- Data saving, rolling, shop, enemies, arenas, combat, leaderboard.

local Defs, Cache = {}, {}
local Finders = {
	function() return require(game:GetService("ReplicatedStorage"):WaitForChild("GameShared")) end,
	function() return require(game:GetService("ReplicatedStorage"):WaitForChild("GameSharedArt")) end,
}

local function Mod(name)
	local c = Cache[name]
	if c == nil then
		local f = Defs[name]
		if f then
			c = f()
		else
			for _, find in ipairs(Finders) do
				local b = find()
				if b.Has(name) then
					c = b.Get(name)
					break
				end
			end
		end
		if c == nil then
			error("Unknown module: " .. tostring(name))
		end
		Cache[name] = c
	end
	return c
end

----------------------------------------------------------------------
-- module: Stats
----------------------------------------------------------------------
Defs.Stats = function()
-- Derived values (income, damage, luck ...) computed from a player's saved data. Server only.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = Mod("Config")
local PetData = Mod("PetData")

local Stats = {}

function Stats.PotionActive(d, kind)
	local e = d.Active[kind]
	return e ~= nil and e > os.time()
end

function Stats.Slots(d)
	return math.min(Config.MaxSlots, Config.BaseSlots + d.Upgrades.Slots)
end

function Stats.IncomeMult(d)
	local m = 1 + Config.UpgradeByKey.Income.Per * d.Upgrades.Income
	if Stats.PotionActive(d, "Income") then
		m *= 2
	end
	return m
end

function Stats.DamageMult(d)
	local m = 1 + Config.UpgradeByKey.Damage.Per * d.Upgrades.Damage
	if Stats.PotionActive(d, "Damage") then
		m *= 2
	end
	return m
end

function Stats.LuckMult(d)
	local m = 1 + Config.UpgradeByKey.Luck.Per * d.Upgrades.Luck
	if Stats.PotionActive(d, "Luck") then
		m *= 2
	end
	return math.clamp(m, 1, Config.MaxLuck)
end

function Stats.CoinMult(d)
	local m = 1 + Config.UpgradeByKey.Reward.Per * d.Upgrades.Reward
	if Stats.PotionActive(d, "Coin") then
		m *= 2
	end
	return m
end

function Stats.DropMult(d)
	return 1 + Config.UpgradeByKey.Drops.Per * d.Upgrades.Drops
end

function Stats.MaxHealth(d)
	return Config.Combat.PlayerHealth + Config.UpgradeByKey.Health.Per * d.Upgrades.Health
end

-- coins per second from equipped pets (with multipliers)
function Stats.IncomePerSecond(d)
	local sum = 0
	for _, id in ipairs(d.Equipped) do
		local p = PetData.Pets[id]
		if p then
			sum += p.Income
		end
	end
	return sum * Stats.IncomeMult(d)
end

function Stats.BaseDamage(d)
	local sum = 0
	for _, id in ipairs(d.Equipped) do
		local p = PetData.Pets[id]
		if p then
			sum += p.Damage
		end
	end
	return sum
end

function Stats.Discovered(d)
	local n = 0
	for _ in pairs(d.Discovered) do
		n += 1
	end
	return n
end

function Stats.OwnedCount(d)
	local n = 0
	for _, c in pairs(d.Pets) do
		n += c
	end
	return n
end

-- how many of this pet are currently equipped
function Stats.EquippedCount(d, id)
	local n = 0
	for _, e in ipairs(d.Equipped) do
		if e == id then
			n += 1
		end
	end
	return n
end

-- Table sent to the client (must be remote-safe: string keys only for dictionaries)
function Stats.Snapshot(d)
	return {
		Coins = d.Coins,
		Pets = d.Pets,
		Equipped = d.Equipped,
		Discovered = d.Discovered,
		Upgrades = d.Upgrades,
		Potions = d.Potions,
		Active = d.Active,
		Materials = d.Materials,
		Tutorial = d.Tutorial,
		IndexClaimed = d.IndexClaimed,
		Daily = d.Daily,
		Stats = d.Stats,
		Derived = {
			Slots = Stats.Slots(d),
			IncomePS = Stats.IncomePerSecond(d),
			DamageMult = Stats.DamageMult(d),
			LuckMult = Stats.LuckMult(d),
			CoinMult = Stats.CoinMult(d),
			MaxHealth = Stats.MaxHealth(d),
			ServerTime = os.time(),
		},
	}
end

return Stats
end

----------------------------------------------------------------------
-- module: DataService
----------------------------------------------------------------------
Defs.DataService = function()
-- Loads / saves player data with DataStores (autosave, retries, safe loading) and replicates it to clients.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = Mod("Config")
local Net = Mod("Net")
local Stats = Mod("Stats")

local DataService = {}

local store = DataStoreService:GetDataStore(Config.DataStoreName)
local sessions = {} -- [player] = data
local noSave = {} -- players whose data could not be loaded in Studio (never overwrite real data)
local saving = {}
local pushQueued = {}

local function deepCopy(t)
	local c = {}
	for k, v in pairs(t) do
		c[k] = type(v) == "table" and deepCopy(v) or v
	end
	return c
end

local function template()
	return {
		Version = 1,
		Coins = Config.StartCoins,
		Pets = {}, -- ["petId"] = count
		Equipped = {}, -- array of petIds
		Discovered = {}, -- ["petId"] = true
		Upgrades = { Income = 0, Luck = 0, Damage = 0, Health = 0, Reward = 0, Drops = 0, Slots = 0 },
		Potions = { Coin = 0, Damage = 0, Luck = 0, Income = 0 },
		Active = { Coin = 0, Damage = 0, Luck = 0, Income = 0 }, -- expiry (os.time)
		Materials = { Shards = 0, Crystals = 0, Tokens = 0 },
		Tutorial = false,
		IndexClaimed = {},
		Daily = { Last = 0, Streak = 0 },
		Stats = { BestWave = 0, Rolls = 0, Kills = 0, Bosses = 0, Runs = 0, TotalCoins = 0 },
	}
end

local function reconcile(target, tmpl)
	for k, v in pairs(tmpl) do
		if target[k] == nil then
			target[k] = type(v) == "table" and deepCopy(v) or v
		elseif type(v) == "table" and type(target[k]) == "table" then
			reconcile(target[k], v)
		end
	end
end

function DataService.Get(player)
	return sessions[player]
end

----------------------------------------------------------------- replication
local function ensureLeaderstats(player, d)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		ls.Parent = player
		local c = Instance.new("StringValue")
		c.Name = "Coins"
		c.Parent = ls
		local w = Instance.new("IntValue")
		w.Name = "Best Wave"
		w.Parent = ls
		local p = Instance.new("IntValue")
		p.Name = "Pets"
		p.Parent = ls
	end
	ls.Coins.Value = Config.Format(math.floor(d.Coins))
	ls["Best Wave"].Value = d.Stats.BestWave
	ls.Pets.Value = Stats.Discovered(d)
end

function DataService.PushNow(player)
	local d = sessions[player]
	if not d or player.Parent ~= Players then
		return
	end
	player:SetAttribute("EquippedPets", table.concat(d.Equipped, ","))
	ensureLeaderstats(player, d)
	Net.Get("Data"):FireClient(player, Stats.Snapshot(d))
end

-- debounced replication
function DataService.Push(player)
	if pushQueued[player] then
		return
	end
	pushQueued[player] = true
	task.delay(0.1, function()
		pushQueued[player] = nil
		DataService.PushNow(player)
	end)
end

----------------------------------------------------------------- rewards
function DataService.AddCoins(d, amount)
	amount = math.floor(amount)
	if amount <= 0 then
		return 0
	end
	d.Coins += amount
	d.Stats.TotalCoins += amount
	return amount
end

-- bundle = { Coins=, Shards=, Crystals=, Tokens=, Potions={Coin=1,...} }
function DataService.Give(d, bundle)
	if bundle.Coins then
		DataService.AddCoins(d, bundle.Coins)
	end
	for _, m in ipairs(Config.MaterialOrder) do
		if bundle[m] then
			d.Materials[m] += bundle[m]
		end
	end
	if bundle.Potions then
		for k, n in pairs(bundle.Potions) do
			if d.Potions[k] ~= nil then
				d.Potions[k] += n
			end
		end
	end
end

----------------------------------------------------------------- load / save
function DataService.Load(player)
	local key = "P_" .. player.UserId
	local data, err
	for attempt = 1, 3 do
		local ok, res = pcall(function()
			return store:GetAsync(key)
		end)
		if ok then
			data, err = res, nil
			break
		end
		err = res
		task.wait(1.5 * attempt)
	end
	if player.Parent ~= Players then
		return nil
	end
	if err then
		if RunService:IsStudio() then
			warn("[DataService] Could not load data in Studio (enable API Services in Game Settings > Security). Progress will NOT be saved this session. " .. tostring(err))
			noSave[player] = true
			data = nil
		else
			warn("[DataService] Load failed for " .. player.Name .. ": " .. tostring(err))
			player:Kick("Your save data could not be loaded. Please rejoin in a minute. (Your progress is safe.)")
			return nil
		end
	end
	data = data or template()
	reconcile(data, template())
	sessions[player] = data
	return data
end

function DataService.Save(player)
	local d = sessions[player]
	if not d or noSave[player] then
		return true
	end
	while saving[player] do
		task.wait(0.2)
	end
	saving[player] = true
	local ok, err
	for attempt = 1, 3 do
		ok, err = pcall(function()
			store:SetAsync("P_" .. player.UserId, d)
		end)
		if ok then
			break
		end
		warn("[DataService] Save attempt " .. attempt .. " failed: " .. tostring(err))
		task.wait(2 * attempt)
	end
	saving[player] = nil
	return ok
end

function DataService.Release(player)
	DataService.Save(player)
	sessions[player] = nil
	noSave[player] = nil
	pushQueued[player] = nil
end

function DataService.Init()
	-- (GameServer calls DataService.Release when a player leaves, after finishing any active run)

	-- autosave
	task.spawn(function()
		while true do
			task.wait(Config.AutoSaveInterval)
			for _, player in ipairs(Players:GetPlayers()) do
				if sessions[player] then
					task.spawn(DataService.Save, player)
					task.wait(0.5)
				end
			end
		end
	end)

	-- shutdown save
	game:BindToClose(function()
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			if sessions[player] then
				pending += 1
				task.spawn(function()
					DataService.Save(player)
					pending -= 1
				end)
			end
		end
		local t = os.clock()
		while pending > 0 and os.clock() - t < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
end

----------------------------------------------------------------------
-- module: PetService
----------------------------------------------------------------------
Defs.PetService = function()
-- Rolling, granting, equipping pets and the passive income loop. All server authoritative.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = Mod("Config")
local PetData = Mod("PetData")
local Net = Mod("Net")
local Stats = Mod("Stats")
local DataService = Mod("DataService")

local PetService = {}
local rng = Random.new()

-- Adds pets to the inventory. Returns isNew, shardsFromDuplicates
function PetService.Grant(d, petId, count)
	count = count or 1
	local pet = PetData.Pets[petId]
	local key = tostring(petId)
	local had = (d.Pets[key] or 0) > 0
	d.Pets[key] = (d.Pets[key] or 0) + count
	d.Discovered[key] = true
	local shards = 0
	if had then
		shards = Config.Rarities[pet.RarityIndex].DupShards * count
		d.Materials.Shards += shards
	end
	return not had, shards
end

local function inArena(player)
	return player:GetAttribute("InArena") == true
end

function PetService.Roll(player, count, mode)
	local d = DataService.Get(player)
	if not d then
		return { ok = false, err = "Loading..." }
	end
	if not Net.Throttle(player, "Roll", 0.35) then
		return { ok = false, err = "Slow down!" }
	end
	if type(count) ~= "number" or not table.find(Config.RollCounts, count) then
		return { ok = false, err = "Invalid roll." }
	end
	mode = (mode == "boss") and "boss" or "coins"
	local cost
	if mode == "boss" then
		cost = Config.BossRollCost * count
		if d.Materials.Tokens < cost then
			return { ok = false, err = "Not enough Boss Tokens!" }
		end
		d.Materials.Tokens -= cost
	else
		cost = Config.RollPrice(d.Stats.Rolls, count)
		if d.Coins < cost then
			return { ok = false, err = "Not enough coins!" }
		end
		d.Coins -= cost
		d.Stats.Rolls += count
	end
	local luck = Stats.LuckMult(d)
	local results = {}
	for i = 1, count do
		local id = PetData.Roll(rng, luck, mode)
		local isNew, shards = PetService.Grant(d, id, 1)
		results[i] = { Id = id, New = isNew, Shards = shards }
	end
	DataService.Push(player)
	return { ok = true, Results = results, Cost = cost, Mode = mode }
end

function PetService.Equip(player, id)
	local d = DataService.Get(player)
	if not d or type(id) ~= "number" or not PetData.Pets[id] then
		return
	end
	if not Net.Throttle(player, "Equip", 0.1) then
		return
	end
	if inArena(player) then
		return Net.Toast(player, "You can't change pets during a run!", "error")
	end
	local owned = d.Pets[tostring(id)] or 0
	if owned <= Stats.EquippedCount(d, id) then
		return
	end
	if #d.Equipped >= Stats.Slots(d) then
		return Net.Toast(player, "All pet slots are full!", "error")
	end
	table.insert(d.Equipped, id)
	DataService.Push(player)
end

function PetService.Unequip(player, id)
	local d = DataService.Get(player)
	if not d or type(id) ~= "number" then
		return
	end
	if not Net.Throttle(player, "Equip", 0.1) then
		return
	end
	if inArena(player) then
		return Net.Toast(player, "You can't change pets during a run!", "error")
	end
	local i = table.find(d.Equipped, id)
	if i then
		table.remove(d.Equipped, i)
		DataService.Push(player)
	end
end

function PetService.UnequipAll(player)
	local d = DataService.Get(player)
	if not d or inArena(player) or not Net.Throttle(player, "Equip", 0.1) then
		return
	end
	table.clear(d.Equipped)
	DataService.Push(player)
end

function PetService.EquipBest(player)
	local d = DataService.Get(player)
	if not d or not Net.Throttle(player, "Equip", 0.1) then
		return
	end
	if inArena(player) then
		return Net.Toast(player, "You can't change pets during a run!", "error")
	end
	local ids = {}
	for key, n in pairs(d.Pets) do
		local id = tonumber(key)
		if id and n > 0 then
			table.insert(ids, id)
		end
	end
	table.sort(ids, function(a, b)
		return PetData.Score(a) > PetData.Score(b)
	end)
	table.clear(d.Equipped)
	local slots = Stats.Slots(d)
	for _, id in ipairs(ids) do
		local n = d.Pets[tostring(id)]
		for _ = 1, n do
			if #d.Equipped >= slots then
				break
			end
			table.insert(d.Equipped, id)
		end
		if #d.Equipped >= slots then
			break
		end
	end
	DataService.Push(player)
end

function PetService.Init()
	Net.Get("Roll").OnServerInvoke = function(player, count, mode)
		return PetService.Roll(player, count, mode)
	end
	Net.Get("EquipPet").OnServerEvent:Connect(PetService.Equip)
	Net.Get("UnequipPet").OnServerEvent:Connect(PetService.Unequip)
	Net.Get("EquipBest").OnServerEvent:Connect(PetService.EquipBest)
	Net.Get("UnequipAll").OnServerEvent:Connect(PetService.UnequipAll)

	-- passive income: equipped pets pay out every few seconds
	task.spawn(function()
		while true do
			task.wait(Config.IncomeInterval)
			for _, player in ipairs(Players:GetPlayers()) do
				local d = DataService.Get(player)
				if d and #d.Equipped > 0 then
					local amount = Stats.IncomePerSecond(d) * Config.IncomeInterval
					amount = DataService.AddCoins(d, amount)
					if amount > 0 then
						Net.Get("Income"):FireClient(player, amount)
						DataService.Push(player)
					end
				end
			end
		end
	end)
end

return PetService
end

----------------------------------------------------------------------
-- module: EnemyFactory
----------------------------------------------------------------------
Defs.EnemyFactory = function()
-- Builds every arena enemy (6 regular kinds + 4 bosses) out of simple parts, plus the floating health bars.
-- Enemies are ANCHORED and moved with Model:PivotTo by CombatService. Front of every enemy faces -Z.

local EnemyFactory = {}

local V3, CF = Vector3.new, CFrame.new
local rad = math.rad
local SMOOTH, NEON, METAL, SLATE = Enum.Material.SmoothPlastic, Enum.Material.Neon, Enum.Material.Metal, Enum.Material.Slate
local EYE = Color3.fromRGB(25, 25, 35)
local WHITE = Color3.fromRGB(255, 255, 255)
local BONE = Color3.fromRGB(236, 230, 212)

EnemyFactory.Kinds = { "Slime", "Imp", "Skeleton", "Golem", "Ghost", "Spider" }
EnemyFactory.Bosses = { "Slime King", "Bone Colossus", "Inferno Drake", "Void Titan" }

local BASE = {
	Slime = Color3.fromRGB(90, 220, 120),
	Imp = Color3.fromRGB(230, 70, 70),
	Skeleton = Color3.fromRGB(255, 120, 60),
	Golem = Color3.fromRGB(130, 140, 150),
	Ghost = Color3.fromRGB(190, 200, 255),
	Spider = Color3.fromRGB(80, 60, 110),
}

local function lighten(c, a)
	return c:Lerp(WHITE, a)
end
local function darken(c, a)
	return c:Lerp(Color3.new(0, 0, 0), a)
end

local function rotCF(r)
	if not r then
		return CFrame.new()
	end
	return CFrame.Angles(rad(r.X), rad(r.Y), rad(r.Z))
end

----------------------------------------------------------------------- builder
local B = {}
B.__index = B

local function newBuilder(name, scale)
	local self = setmetatable({}, B)
	self.s = scale
	local model = Instance.new("Model")
	model.Name = name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = V3(1, 1, 1)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CastShadow = false
	root.CFrame = CF(0, 0, 0)
	root.Parent = model
	model.PrimaryPart = root
	self.model, self.root = model, root
	return self
end

function B:part(shape, size, cf, color, mat, trans)
	local s = self.s
	local p = Instance.new("Part")
	p.Shape = shape
	p.Size = V3(math.max(size.X * s, 0.05), math.max(size.Y * s, 0.05), math.max(size.Z * s, 0.05))
	p.CFrame = CF(cf.Position * s) * cf.Rotation
	p.Color = color
	p.Material = mat or SMOOTH
	p.Transparency = trans or 0
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = self.model
	return p
end

function B:ball(d, pos, color, mat, trans)
	return self:part(Enum.PartType.Ball, V3(d, d, d), CF(pos), color, mat, trans)
end

function B:box(size, pos, color, rot, mat, trans)
	return self:part(Enum.PartType.Block, size, CF(pos) * rotCF(rot), color, mat, trans)
end

function B:oval(size, pos, color, rot, mat, trans)
	local p = self:part(Enum.PartType.Block, size, CF(pos) * rotCF(rot), color, mat, trans)
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	return p
end

-- upright cylinder (axis = Y)
function B:cyl(h, d, pos, color, rot, mat, trans)
	return self:part(Enum.PartType.Cylinder, V3(h, d, d), CF(pos) * rotCF(rot) * CFrame.Angles(0, 0, math.pi / 2), color, mat, trans)
end

function B:eyes(y, z, x, d, color, pupil)
	for _, s in ipairs({ -1, 1 }) do
		self:ball(d, V3(s * x, y, z), color or WHITE, SMOOTH, 0)
		if pupil ~= false then
			self:ball(d * 0.5, V3(s * x, y, z - d * 0.4), EYE, SMOOTH, 0)
		end
	end
end

----------------------------------------------------------------------- regular kinds
local K = {}

K.Slime = function(b, c)
	b:oval(V3(2.4, 1.9, 2.4), V3(0, 0.95, 0), c, nil, SMOOTH, 0.2)
	b:ball(0.9, V3(0, 0.9, 0.1), lighten(c, 0.45), NEON, 0.3)
	b:oval(V3(0.5, 0.25, 0.2), V3(-0.6, 1.65, -0.7), WHITE, V3(0, 20, 20), SMOOTH, 0.3)
	b:eyes(1.25, -1.0, 0.5, 0.5)
	b:box(V3(0.5, 0.08, 0.08), V3(0, 0.75, -1.12), EYE)
	return 2.0
end

K.Imp = function(b, c)
	local dark = darken(c, 0.4)
	b:oval(V3(1.5, 1.7, 1.2), V3(0, 1.4, 0), c)
	b:oval(V3(1.0, 1.2, 0.5), V3(0, 1.3, -0.45), lighten(c, 0.45))
	b:ball(1.4, V3(0, 2.7, 0), c)
	for _, s in ipairs({ -1, 1 }) do
		b:box(V3(0.2, 0.75, 0.2), V3(s * 0.5, 3.4, 0), EYE, V3(0, 0, -s * 22))
		b:ball(0.3, V3(s * 0.3, 2.75, -0.6), Color3.fromRGB(255, 230, 60), NEON, 0)
		b:cyl(0.8, 0.4, V3(s * 0.4, 0.4, 0), dark)
		b:box(V3(0.3, 1.1, 0.3), V3(s * 1.0, 1.6, -0.15), c, V3(-20, 0, -s * 15))
		b:oval(V3(1.6, 0.1, 1.2), V3(s * 1.15, 2.0, 0.6), Color3.fromRGB(110, 50, 150), V3(0, 0, s * 30))
	end
	b:box(V3(0.5, 0.12, 0.1), V3(0, 2.35, -0.66), EYE)
	b:cyl(1.2, 0.14, V3(0, 1.0, 0.85), c, V3(70, 0, 0))
	return 3.6
end

K.Skeleton = function(b, c)
	for _, s in ipairs({ -1, 1 }) do
		b:cyl(1.3, 0.28, V3(s * 0.35, 0.65, 0), BONE)
		b:cyl(1.3, 0.2, V3(s * 0.9, 2.1, 0), BONE, V3(0, 0, -s * 12))
		b:ball(0.32, V3(s * 0.28, 3.25, -0.45), EYE)
		b:ball(0.14, V3(s * 0.28, 3.25, -0.55), c, NEON)
	end
	b:box(V3(1.1, 0.3, 0.5), V3(0, 1.4, 0), BONE)
	for i = 0, 2 do
		b:box(V3(1.3 - i * 0.1, 0.18, 0.6), V3(0, 1.8 + i * 0.3, 0), BONE)
	end
	b:box(V3(0.18, 1.3, 0.18), V3(0, 2.1, 0.15), BONE)
	b:ball(1.1, V3(0, 3.2, 0), BONE)
	b:box(V3(0.7, 0.25, 0.7), V3(0, 2.75, -0.05), BONE)
	b:box(V3(0.15, 1.7, 0.15), V3(1.2, 1.7, -0.5), Color3.fromRGB(190, 200, 215), V3(35, 0, 0), METAL)
	b:box(V3(0.5, 0.12, 0.12), V3(1.2, 1.0, -0.15), darken(c, 0.4), V3(35, 0, 0))
	return 3.9
end

K.Golem = function(b, c)
	local dark = darken(c, 0.25)
	for _, s in ipairs({ -1, 1 }) do
		b:box(V3(0.8, 1.2, 0.8), V3(s * 0.6, 0.6, 0), dark, nil, SLATE)
		b:box(V3(0.7, 1.8, 0.7), V3(s * 1.5, 1.9, 0), c, nil, SLATE)
		b:box(V3(0.95, 0.95, 0.95), V3(s * 1.5, 0.8, 0), dark, nil, SLATE)
		b:ball(0.9, V3(s * 1.4, 2.8, 0), c, SLATE)
	end
	b:box(V3(2.2, 1.8, 1.4), V3(0, 2.1, 0), c, nil, SLATE)
	b:box(V3(1.0, 0.9, 0.9), V3(0, 3.55, 0), dark, nil, SLATE)
	b:box(V3(0.8, 0.15, 0.1), V3(0, 3.6, -0.46), Color3.fromRGB(255, 160, 40), nil, NEON)
	b:box(V3(0.1, 1.0, 0.05), V3(0.3, 2.1, -0.72), Color3.fromRGB(255, 160, 40), V3(0, 0, 20), NEON)
	b:oval(V3(1.0, 0.25, 0.8), V3(-1.4, 3.25, 0), Color3.fromRGB(90, 160, 80), nil, Enum.Material.Grass)
	return 4.1
end

K.Ghost = function(b, c)
	b:ball(1.9, V3(0, 2.3, 0), c, SMOOTH, 0.3)
	b:cyl(1.4, 1.9, V3(0, 1.4, 0), c, nil, SMOOTH, 0.3)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		b:ball(0.8, V3(math.cos(a) * 0.6, 0.5, math.sin(a) * 0.6), c, SMOOTH, 0.3)
	end
	for _, s in ipairs({ -1, 1 }) do
		b:oval(V3(0.4, 0.55, 0.2), V3(s * 0.4, 2.45, -0.85), EYE)
		b:oval(V3(0.4, 1.0, 0.4), V3(s * 1.1, 1.6, -0.2), c, V3(0, 0, s * 35), SMOOTH, 0.3)
	end
	b:oval(V3(0.45, 0.55, 0.15), V3(0, 1.75, -0.9), EYE)
	return 3.3
end

K.Spider = function(b, c)
	local dark = darken(c, 0.3)
	b:ball(1.8, V3(0, 1.2, 0.9), c)
	b:oval(V3(0.4, 0.15, 0.7), V3(0, 2.05, 0.9), Color3.fromRGB(255, 60, 60), nil, NEON)
	b:ball(1.1, V3(0, 1.1, -0.5), dark)
	for _, v in ipairs({ V3(0.25, 1.35, -1.0), V3(-0.25, 1.35, -1.0), V3(0.5, 1.15, -0.95), V3(-0.5, 1.15, -0.95) }) do
		b:ball(0.2, v, Color3.fromRGB(255, 60, 60), NEON)
	end
	for _, s in ipairs({ -1, 1 }) do
		b:box(V3(0.14, 0.4, 0.14), V3(s * 0.2, 0.7, -1.0), WHITE, V3(-15, 0, 0))
		for i = 0, 3 do
			local z = -0.7 + i * 0.5
			b:cyl(1.5, 0.15, V3(s * 1.15, 1.2, z), dark, V3(0, 0, -s * 50))
			b:cyl(1.3, 0.12, V3(s * 2.0, 0.55, z), dark, V3(0, 0, s * 20))
		end
	end
	return 2.4
end

----------------------------------------------------------------------- bosses
local BOSS = {}

BOSS["Slime King"] = function(b)
	local c = Color3.fromRGB(80, 220, 130)
	K.Slime(b, c)
	b:ball(0.8, V3(0, 1.0, 0), Color3.fromRGB(255, 230, 90), NEON, 0.15)
	local gold = Color3.fromRGB(255, 205, 70)
	b:cyl(0.3, 1.5, V3(0, 2.05, 0), gold, nil, METAL)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		b:box(V3(0.25, 0.6, 0.25), V3(math.cos(a) * 0.6, 2.4, math.sin(a) * 0.6), gold, nil, METAL)
		b:ball(0.18, V3(math.cos(a) * 0.6, 2.75, math.sin(a) * 0.6), Color3.fromRGB(255, 70, 110), NEON)
	end
	return 3.0
end

BOSS["Bone Colossus"] = function(b)
	K.Skeleton(b, Color3.fromRGB(255, 60, 60))
	for _, s in ipairs({ -1, 1 }) do
		b:box(V3(0.25, 1.0, 0.25), V3(s * 0.55, 4.05, 0), Color3.fromRGB(200, 195, 180), V3(0, 0, -s * 28))
		b:ball(0.7, V3(s * 0.95, 2.65, 0), Color3.fromRGB(120, 125, 140), METAL)
	end
	b:box(V3(1.6, 0.35, 0.8), V3(0, 2.55, 0.35), Color3.fromRGB(150, 40, 40), V3(10, 0, 0))
	return 4.5
end

BOSS["Inferno Drake"] = function(b)
	local c = Color3.fromRGB(150, 40, 30)
	local lava = Color3.fromRGB(255, 120, 30)
	b:oval(V3(2.4, 2.0, 4.0), V3(0, 2.0, 0), c)
	b:oval(V3(1.6, 1.0, 2.8), V3(0, 1.6, -0.2), Color3.fromRGB(255, 170, 70))
	b:oval(V3(1.0, 1.8, 1.0), V3(0, 3.0, -1.9), c, V3(-30, 0, 0))
	b:oval(V3(1.4, 1.1, 1.8), V3(0, 3.9, -2.7), c)
	b:oval(V3(0.9, 0.7, 1.2), V3(0, 3.7, -3.6), darken(c, 0.2))
	for _, s in ipairs({ -1, 1 }) do
		b:ball(0.3, V3(s * 0.45, 4.25, -2.9), Color3.fromRGB(255, 240, 80), NEON)
		b:box(V3(0.2, 0.9, 0.2), V3(s * 0.5, 4.7, -2.3), EYE, V3(-25, 0, -s * 15))
		b:oval(V3(3.2, 0.12, 2.0), V3(s * 2.8, 3.3, 0.5), c, V3(0, 0, s * 22))
		b:oval(V3(2.6, 0.14, 1.5), V3(s * 2.8, 3.3, 0.55), lava, V3(0, 0, s * 22), NEON, 0.15)
		for _, z in ipairs({ -1.1, 1.2 }) do
			b:cyl(1.6, 0.7, V3(s * 0.95, 0.8, z), c)
		end
	end
	for i = 0, 5 do
		b:box(V3(0.25, 0.55, 0.25), V3(0, 3.1 - i * 0.12, -1.2 + i * 0.5), lava, V3(15, 0, 0), NEON)
	end
	for i = 1, 5 do
		b:ball(1.0 - i * 0.13, V3(0, 1.8 - i * 0.12, 2.0 + i * 0.7), c)
	end
	b:ball(0.6, V3(0, 1.6, 5.7), lava, NEON, 0.1)
	for _, v in ipairs({ V3(0.8, 2.8, 0.2), V3(-0.7, 2.9, 1.0), V3(0.5, 2.6, 1.3) }) do
		b:ball(0.35, v, lava, NEON)
	end
	return 5.3
end

BOSS["Void Titan"] = function(b)
	local c = Color3.fromRGB(28, 14, 48)
	local glow = Color3.fromRGB(180, 70, 255)
	b:ball(5.0, V3(0, 3.8, 0), glow, NEON, 0.88)
	for _, s in ipairs({ -1, 1 }) do
		b:box(V3(1.0, 2.0, 1.0), V3(s * 0.8, 1.0, 0), c)
		b:box(V3(0.9, 3.0, 0.9), V3(s * 2.0, 3.4, 0), c)
		b:ball(1.3, V3(s * 1.9, 4.9, 0), c)
		b:ball(1.1, V3(s * 2.0, 1.6, 0), glow, NEON, 0.1)
	end
	b:box(V3(2.6, 3.0, 1.6), V3(0, 3.5, 0), c)
	b:box(V3(1.8, 0.2, 0.1), V3(0, 3.6, -0.82), glow, nil, NEON)
	b:ball(1.6, V3(0, 5.7, 0), c)
	b:ball(0.9, V3(0, 5.7, -0.75), glow, NEON)
	b:ball(0.4, V3(0, 5.7, -1.1), WHITE, NEON)
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + 0.4
		b:ball(0.55, V3(math.cos(a) * 3.2, 5.0 + math.sin(a * 2) * 0.6, math.sin(a) * 3.2), glow, NEON)
	end
	return 7.2
end

----------------------------------------------------------------------- public
-- Builds an enemy. kind: one of Kinds or Bosses. tier (0-4) shifts the colour as waves get harder.
function EnemyFactory.Build(kind, scale, tier)
	scale = scale or 1
	local b = newBuilder(kind, scale)
	local height
	if BOSS[kind] then
		height = BOSS[kind](b)
	else
		local base = BASE[kind] or BASE.Slime
		local h, s, v = base:ToHSV()
		local c = Color3.fromHSV((h + (tier or 0) * 0.12) % 1, s, v)
		height = (K[kind] or K.Slime)(b, c)
	end
	b.model:SetAttribute("Kind", kind)
	b.model:SetAttribute("Height", height * scale)
	b.model:SetAttribute("Boss", BOSS[kind] ~= nil)
	return b.model
end

local bars = setmetatable({}, { __mode = "k" })

function EnemyFactory.AddBar(model, displayName, maxHp, isBoss)
	local height = model:GetAttribute("Height") or 3
	local gui = Instance.new("BillboardGui")
	gui.Name = "HealthBar"
	gui.Adornee = model.PrimaryPart
	gui.Size = UDim2.fromOffset(isBoss and 190 or 120, isBoss and 46 or 34)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height + 1.3, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 170
	gui.LightInfluence = 0
	gui.Parent = model.PrimaryPart

	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0.5, 0)
	name.Font = Enum.Font.GothamBlack
	name.TextScaled = true
	name.Text = displayName
	name.TextColor3 = isBoss and Color3.fromRGB(255, 205, 80) or WHITE
	name.TextStrokeTransparency = 0.3
	name.Parent = gui

	local back = Instance.new("Frame")
	back.Position = UDim2.new(0, 0, 0.55, 0)
	back.Size = UDim2.new(1, 0, 0.4, 0)
	back.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
	back.BorderSizePixel = 0
	back.Parent = gui
	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(0.5, 0)
	bc.Parent = back
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Thickness = 2
	stroke.Parent = back

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BackgroundColor3 = isBoss and Color3.fromRGB(190, 70, 255) or Color3.fromRGB(235, 70, 70)
	fill.BorderSizePixel = 0
	fill.Parent = back
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(0.5, 0)
	fc.Parent = fill

	bars[model] = { fill = fill }
end

function EnemyFactory.SetBar(model, hp, maxHp)
	local b = bars[model]
	if b and b.fill then
		b.fill.Size = UDim2.new(math.clamp(hp / maxHp, 0, 1), 0, 1, 0)
	end
end

-- Fades the enemy out then removes it
function EnemyFactory.Die(model)
	local TweenService = game:GetService("TweenService")
	local gui = model.PrimaryPart and model.PrimaryPart:FindFirstChild("HealthBar")
	if gui then
		gui:Destroy()
	end
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p ~= model.PrimaryPart then
			TweenService:Create(p, TweenInfo.new(0.45, Enum.EasingStyle.Quad), { Transparency = 1 }):Play()
		end
	end
	task.delay(0.5, function()
		model:Destroy()
	end)
end

return EnemyFactory
end

----------------------------------------------------------------------
-- module: ArenaBuilder
----------------------------------------------------------------------
Defs.ArenaBuilder = function()
-- Builds a private circular fighting arena for each run (far away from the hub) and removes it afterwards.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = Mod("Config")

local ArenaBuilder = {}
local arenas = {}

local V3, CF = Vector3.new, CFrame.new

local function part(parent, name, size, cf, color, mat, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

function ArenaBuilder.GetCenter(slot)
	local o = Config.Arena.Origin
	return CF(o.X, 0, o.Z + (slot - 1) * Config.Arena.Spacing)
end

function ArenaBuilder.Build(slot)
	if arenas[slot] then
		arenas[slot]:Destroy()
	end
	local R = Config.Arena.Radius
	local center = ArenaBuilder.GetCenter(slot)
	local model = Instance.new("Model")
	model.Name = "Arena_" .. slot

	-- floor (cylinder disc: its flat faces point along X so rotate it)
	local floor = part(model, "Floor", V3(2, R * 2, R * 2), center * CF(0, -1, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(60, 52, 78), Enum.Material.Slate, Enum.PartType.Cylinder)
	floor.TopSurface = Enum.SurfaceType.Smooth
	local inner = part(model, "Inner", V3(0.4, R * 1.2, R * 1.2), center * CF(0, 0.02, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(78, 68, 104), Enum.Material.Marble, Enum.PartType.Cylinder)
	inner.CanCollide = false
	local rune = part(model, "Rune", V3(0.2, R * 0.55, R * 0.55), center * CF(0, 0.2, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(150, 90, 255), Enum.Material.Neon, Enum.PartType.Cylinder)
	rune.Transparency = 0.8
	rune.CanCollide = false

	-- wall ring (solid) + glowing trim + pillars with torches
	local segs = 28
	local arc = 2 * math.pi * R / segs
	for i = 0, segs - 1 do
		local a = i / segs * math.pi * 2
		local pos = V3(math.cos(a) * (R + 1), 0, math.sin(a) * (R + 1))
		local cf = center * CF(pos) * CFrame.Angles(0, -a + math.pi / 2, 0)
		local w = part(model, "Wall", V3(arc + 0.6, 7, 2), cf * CF(0, 3.5, 0), Color3.fromRGB(70, 62, 92), Enum.Material.Slate)
		part(model, "Trim", V3(arc + 0.6, 0.5, 2.3), cf * CF(0, 7.2, 0), Color3.fromRGB(150, 90, 255), Enum.Material.Neon)
		local glass = part(model, "Barrier", V3(arc + 0.6, 40, 1), cf * CF(0, 27, 0), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic)
		glass.Transparency = 1
		if i % 4 == 0 then
			local pillar = part(model, "Pillar", V3(3.2, 11, 3.2), cf * CF(0, 5.5, 0.4), Color3.fromRGB(95, 85, 120), Enum.Material.Marble)
			local flame = part(model, "Torch", V3(1.6, 1.6, 1.6), cf * CF(0, 12, 0.4), Color3.fromRGB(255, 150, 50), Enum.Material.Neon, Enum.PartType.Ball)
			flame.CanCollide = false
			local fire = Instance.new("Fire")
			fire.Size = 6
			fire.Heat = 5
			fire.Color = Color3.fromRGB(255, 140, 40)
			fire.SecondaryColor = Color3.fromRGB(255, 60, 20)
			fire.Parent = flame
			local light = Instance.new("PointLight")
			light.Range = 26
			light.Brightness = 2
			light.Color = Color3.fromRGB(255, 160, 80)
			light.Parent = flame
		end
	end

	-- a few decorative crystals
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2 + 0.3
		local d = R * 0.82
		local c = part(model, "Crystal", V3(2, 6 + (i % 3) * 2, 2), center * CF(math.cos(a) * d, 3, math.sin(a) * d) * CFrame.Angles(math.rad(12), a, math.rad(10)), Color3.fromRGB(150, 90, 255), Enum.Material.Neon)
		c.Transparency = 0.2
		c.CanCollide = false
	end

	model.Parent = Workspace
	arenas[slot] = model
	return { Model = model, Center = center }
end

function ArenaBuilder.Destroy(slot)
	local m = arenas[slot]
	if m then
		arenas[slot] = nil
		m:Destroy()
	end
end

return ArenaBuilder
end

----------------------------------------------------------------------
-- module: Leaderboard
----------------------------------------------------------------------
Defs.Leaderboard = function()
-- Global "Best Wave" leaderboard (OrderedDataStore) shown on the big board in the hub.

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = Mod("Config")

local Leaderboard = {}

local store
do
	local ok, res = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
	end)
	if ok then
		store = res
	end
end

local rows = {}
local nameCache = {}

local function nameOf(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	name = ok and name or ("Player" .. userId)
	nameCache[userId] = name
	return name
end

-- Called when a run ends (only does something when the wave is a new personal best)
function Leaderboard.Submit(userId, wave)
	if not store or wave <= 0 then
		return
	end
	task.spawn(function()
		pcall(function()
			store:UpdateAsync(tostring(userId), function(old)
				if old and old >= wave then
					return nil
				end
				return wave
			end)
		end)
	end)
end

function Leaderboard.Refresh()
	if #rows == 0 then
		return
	end
	local entries
	if store then
		local ok, res = pcall(function()
			return store:GetSortedAsync(false, #rows):GetCurrentPage()
		end)
		if ok then
			entries = res
		end
	end
	for i, label in ipairs(rows) do
		local e = entries and entries[i]
		if e then
			label.Text = string.format("%d.  %s  -  Wave %d", i, nameOf(tonumber(e.key) or 0), e.value)
		elseif i == 1 and not entries then
			label.Text = "Leaderboard offline (enable API Services)"
		else
			label.Text = string.format("%d.  ---", i)
		end
	end
end

-- rowLabels: array of TextLabels created by HubBuilder
function Leaderboard.Init(rowLabels)
	rows = rowLabels or {}
	task.spawn(function()
		while true do
			Leaderboard.Refresh()
			task.wait(45)
		end
	end)
end

return Leaderboard
end

----------------------------------------------------------------------
-- module: CombatService
----------------------------------------------------------------------
Defs.CombatService = function()
-- Runs fighting arena runs: waves, enemy AI, pet damage, END RUN, rewards. 100% server authoritative.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = Mod("Config")
local PetData = Mod("PetData")
local Net = Mod("Net")
local Stats = Mod("Stats")
local DataService = Mod("DataService")
local PetService = Mod("PetService")
local EnemyFactory = Mod("EnemyFactory")
local ArenaBuilder = Mod("ArenaBuilder")
local Leaderboard = Mod("Leaderboard")

local C = Config.Combat
local V3, CF = Vector3.new, CFrame.new
local rng = Random.new()

local CombatService = {}
local runs = {} -- [player] = run
local slotsUsed = {}

local BOSS_SCALE = { ["Slime King"] = 2.2, ["Bone Colossus"] = 1.8, ["Inferno Drake"] = 1.5, ["Void Titan"] = 1.3 }

----------------------------------------------------------------- scaling helpers
local function waveHP(w)
	return C.WaveHPBase * C.WaveHPGrowth ^ (w - 1)
end
local function waveDamage(w)
	return C.EnemyDamageBase * C.EnemyDamageGrowth ^ (w - 1)
end
local function killCoins(w)
	return C.CoinBase * C.CoinGrowth ^ (w - 1)
end

local function allocSlot()
	for i = 1, Config.Arena.MaxSlots do
		if not slotsUsed[i] then
			slotsUsed[i] = true
			return i
		end
	end
	return nil
end

local function fire(player, name, ...)
	if player.Parent == Players then
		Net.Get(name):FireClient(player, ...)
	end
end

----------------------------------------------------------------- enemies
local function spawnWave(run)
	local wave = run.wave
	local boss = wave % C.BossEvery == 0
	local count = math.min(3 + math.floor(wave * 0.8), 14)
	local list = {}
	local tier = math.min(math.floor((wave - 1) / 10), 4)
	if boss then
		local idx = ((wave // C.BossEvery) - 1) % #EnemyFactory.Bosses + 1
		table.insert(list, { kind = EnemyFactory.Bosses[idx], boss = true })
		count = math.floor(count / 2)
	end
	for _ = 1, count do
		table.insert(list, { kind = EnemyFactory.Kinds[rng:NextInteger(1, #EnemyFactory.Kinds)], boss = false })
	end
	local R = Config.Arena.Radius
	local base = waveHP(wave)
	local n = #list
	local offset = rng:NextNumber() * math.pi * 2
	for i, info in ipairs(list) do
		local scale = info.boss and (BOSS_SCALE[info.kind] or 1.5) or (0.9 + rng:NextNumber() * 0.3)
		local model = EnemyFactory.Build(info.kind, scale, tier)
		local hp = base * (info.boss and 12 or 1)
		local ang = offset + (i / n) * math.pi * 2 + (rng:NextNumber() - 0.5) * 0.3
		local rad = info.boss and (R * 0.55) or (R - 9)
		local pos = V3(run.center.Position.X + math.cos(ang) * rad, 0, run.center.Position.Z + math.sin(ang) * rad)
		model:PivotTo(CF(pos))
		local height = model:GetAttribute("Height") or 3
		EnemyFactory.AddBar(model, info.boss and info.kind or (info.kind .. "  Lv." .. wave), hp, info.boss)
		model.Parent = run.arenaModel
		local e = {
			model = model,
			root = model.PrimaryPart,
			name = info.kind,
			hp = hp,
			maxhp = hp,
			dmg = waveDamage(wave) * (info.boss and 2.5 or 1),
			speed = info.boss and 6 or math.min(7 + wave * 0.15, 13),
			boss = info.boss,
			wave = wave,
			height = height,
			reach = 4 + height * 0.25,
			ring = rng:NextNumber() * math.pi * 2,
			phase = rng:NextNumber() * 6.28,
			pos = pos,
			nextAtk = os.clock() + 1.2 + rng:NextNumber() * 0.8,
			lunge = -10,
		}
		table.insert(run.enemies, e)
	end
	run.total = #list
	return boss, list[1] and list[1].kind or ""
end

local function killEnemy(run, e)
	if e.dead then
		return
	end
	e.dead = true
	local i = table.find(run.enemies, e)
	if i then
		table.remove(run.enemies, i)
	end
	local coins = killCoins(e.wave) * (e.boss and 5 or 1)
	run.coins.Kills += coins
	if e.boss then
		run.bosses += 1
		run.coins.Bosses += C.BossBonusBase * C.CoinGrowth ^ (e.wave - 1)
		local d = DataService.Get(run.player)
		local chance = math.min(0.10 * (d and Stats.DropMult(d) or 1), 0.6)
		local petId = PetData.BossPets[e.name]
		if petId and rng:NextNumber() < chance then
			table.insert(run.bossDrops, petId)
		end
	else
		run.kills += 1
	end
	EnemyFactory.Die(e.model)
	fire(run.player, "EnemyDied", e.pos + V3(0, e.height * 0.5, 0), e.boss, math.floor(coins))
end

local function damageEnemy(run, e, dmg, petIndex, crit)
	e.hp -= dmg
	EnemyFactory.SetBar(e.model, math.max(e.hp, 0), e.maxhp)
	fire(run.player, "PetHit", petIndex, e.root, dmg, crit)
	if e.hp <= 0 then
		killEnemy(run, e)
	end
end

----------------------------------------------------------------- per-frame step
local function stepRun(run, dt, now)
	local player = run.player
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local ppos = hrp and hrp.Position or run.center.Position
	local flat = V3(ppos.X, 0, ppos.Z)
	local cpos = V3(run.center.Position.X, 0, run.center.Position.Z)
	local maxR = Config.Arena.Radius - 4

	-- enemies move and attack
	for _, e in ipairs(run.enemies) do
		local to = flat - e.pos
		local dist = to.Magnitude
		if hrp and dist > e.reach then
			local stand = e.reach * 0.7
			local target = flat + V3(math.cos(e.ring) * stand, 0, math.sin(e.ring) * stand)
			local dir = target - e.pos
			local dm = dir.Magnitude
			if dm > 0.15 then
				e.pos += dir.Unit * math.min(e.speed * dt, dm)
			end
			local off = e.pos - cpos
			if off.Magnitude > maxR then
				e.pos = cpos + off.Unit * maxR
			end
		elseif hrp and now >= e.nextAtk then
			e.nextAtk = now + C.EnemyAttackInterval * (0.9 + rng:NextNumber() * 0.2)
			e.lunge = now
			run.hp -= e.dmg
			fire(player, "Hurt", e.dmg)
		end
		local bob = e.boss and 0 or math.sin(now * 6 + e.phase) * 0.25
		local face = flat - e.pos
		local at = e.pos + V3(0, bob, 0)
		local el = now - e.lunge
		if face.Magnitude > 0.05 then
			local fu = face.Unit
			if el < 0.25 then
				at += fu * (math.sin(math.pi * el / 0.25) * 1.4)
			end
			e.model:PivotTo(CFrame.lookAt(at, at + fu))
		else
			e.model:PivotTo(CF(at))
		end
	end

	-- death check
	if run.hp <= 0 then
		run.hp = 0
		run.defeated = true
		CombatService.Finish(run, "defeated")
		return
	end

	-- pets attack
	if #run.enemies > 0 and hrp then
		for i, pet in ipairs(run.pets) do
			if now >= pet.nextAtk and #run.enemies > 0 then
				pet.nextAtk = now + C.PetAttackInterval * (0.85 + rng:NextNumber() * 0.3)
				local best, bd
				for _, e in ipairs(run.enemies) do
					local dd = (e.pos - flat).Magnitude
					if not bd or dd < bd then
						best, bd = e, dd
					end
				end
				if best and bd <= C.PetRange then
					local d = DataService.Get(player)
					local dmg = pet.dmg * (d and Stats.DamageMult(d) or 1) * (0.92 + rng:NextNumber() * 0.16)
					local crit = rng:NextNumber() < 0.12
					if crit then
						dmg *= 2
					end
					damageEnemy(run, best, math.max(1, math.floor(dmg + 0.5)), i, crit)
					if run.finished then
						return
					end
				end
			end
		end
	end

	-- status for the HUD
	if now >= run.nextStatus then
		run.nextStatus = now + 0.25
		local c = run.coins
		fire(player, "RunStatus", {
			Wave = run.wave,
			HP = math.floor(run.hp),
			MaxHP = run.maxhp,
			Left = #run.enemies,
			Total = run.total,
			Coins = math.floor(c.Kills + c.Waves + c.Bosses),
			Kills = run.kills,
			Ending = run.ending,
			Grace = run.ending and math.max(0, math.ceil(run.endDeadline - now)) or 0,
		})
	end
end

----------------------------------------------------------------- rewards
local function buildSummary(run, d, outcome)
	local dropMult = d and Stats.DropMult(d) or 1
	local coinMult = d and Stats.CoinMult(d) or 1
	local c = run.coins
	local reach = run.wave > 0 and (C.ReachBase * run.wave ^ 1.8) or 0
	local subtotal = c.Kills + c.Waves + c.Bosses + reach
	local survivor = 0
	if outcome == "ended" and run.wave > 0 then
		survivor = subtotal * C.SurvivorBonus
	end
	local total = math.floor((subtotal + survivor) * coinMult)

	local shards = math.floor((run.kills * 0.4 + run.cleared * 2) * dropMult)
	local crystals = math.floor((run.bosses * 2 + run.cleared // 10) * dropMult)
	local tokens = run.bosses + run.cleared // 10
	local potions = {}
	for _ = 1, run.cleared // 3 do
		if rng:NextNumber() < 0.25 * dropMult then
			local kind = Config.PotionOrder[rng:NextInteger(1, #Config.PotionOrder)]
			potions[kind] = (potions[kind] or 0) + 1
		end
	end

	local summary = {
		Outcome = outcome,
		Wave = run.wave,
		Cleared = run.cleared,
		Kills = run.kills,
		Bosses = run.bosses,
		Time = math.floor(os.clock() - run.startTime),
		Coins = {
			Kills = math.floor(c.Kills),
			Waves = math.floor(c.Waves),
			Bosses = math.floor(c.Bosses),
			Reach = math.floor(reach),
			Survivor = math.floor(survivor),
			Mult = coinMult,
			Total = total,
		},
		Shards = shards,
		Crystals = crystals,
		Tokens = tokens,
		Potions = potions,
		Pets = {},
		NewBest = false,
		BestWave = 0,
	}

	if d then
		DataService.Give(d, { Coins = total, Shards = shards, Crystals = crystals, Tokens = tokens, Potions = potions })
		for _, petId in ipairs(run.bossDrops) do
			local isNew, sh = PetService.Grant(d, petId, 1)
			table.insert(summary.Pets, { Id = petId, New = isNew, Shards = sh })
		end
		d.Stats.Runs += 1
		d.Stats.Kills += run.kills
		d.Stats.Bosses += run.bosses
		if run.wave > d.Stats.BestWave then
			d.Stats.BestWave = run.wave
			summary.NewBest = true
		end
		summary.BestWave = d.Stats.BestWave
	end
	return summary
end

function CombatService.Finish(run, outcome)
	if run.finished then
		return
	end
	run.finished = true
	local player = run.player
	runs[player] = nil
	for _, e in ipairs(run.enemies) do
		e.model:Destroy()
	end
	table.clear(run.enemies)

	local d = DataService.Get(player)
	local summary = buildSummary(run, d, outcome)

	player:SetAttribute("InArena", false)
	local char = player.Character
	if char and char.Parent and player.Parent == Players then
		char:PivotTo(CF(Config.Hub.PortalFront + V3(rng:NextNumber() * 8 - 4, 2, 14)))
	end
	ArenaBuilder.Destroy(run.slot)
	slotsUsed[run.slot] = nil

	if player.Parent == Players then
		fire(player, "RunEnd", summary)
		DataService.Push(player)
	end
	if summary.NewBest then
		Leaderboard.Submit(player.UserId, summary.BestWave)
	end
end

----------------------------------------------------------------- wave loop
local function runLoop(run)
	local player = run.player
	local t0 = os.clock()
	while os.clock() - t0 < C.CountdownSeconds and not run.finished and not run.ending do
		task.wait(0.1)
	end
	while not run.finished do
		if run.ending then
			break
		end
		run.wave += 1
		local boss, bossName = spawnWave(run)
		fire(player, "WaveStart", run.wave, boss, run.total, boss and bossName or nil)
		while not run.finished and #run.enemies > 0 do
			if run.ending and os.clock() >= run.endDeadline then
				break
			end
			task.wait(0.1)
		end
		if run.finished then
			return
		end
		if #run.enemies > 0 then
			break -- ended with enemies left after the grace period
		end
		run.cleared += 1
		local bonus = C.WaveBonusBase * C.CoinGrowth ^ (run.wave - 1)
		run.coins.Waves += bonus
		run.hp = math.min(run.maxhp, run.hp + run.maxhp * C.HealOnClear)
		fire(player, "WaveClear", run.wave, math.floor(bonus))
		if run.ending then
			break
		end
		local t1 = os.clock()
		while os.clock() - t1 < C.IntermissionSeconds and not run.finished and not run.ending do
			task.wait(0.1)
		end
	end
	if not run.finished then
		CombatService.Finish(run, "ended")
	end
end

----------------------------------------------------------------- public API
function CombatService.GetRun(player)
	return runs[player]
end

function CombatService.PlaceInArena(player)
	local run = runs[player]
	local char = player.Character
	if run and char and char.Parent then
		char:PivotTo(run.center * CF(0, 5, 0))
	end
end

function CombatService.StartRun(player)
	if runs[player] then
		return false
	end
	if not Net.Throttle(player, "StartRun", 2) then
		return false
	end
	local d = DataService.Get(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not d or not hum or hum.Health <= 0 then
		return false
	end
	if #d.Equipped == 0 then
		Net.Toast(player, "Equip at least one pet before you fight!", "error")
		return false
	end
	local slot = allocSlot()
	if not slot then
		Net.Toast(player, "All arenas are busy, try again in a moment.", "error")
		return false
	end
	local arena = ArenaBuilder.Build(slot)
	local pets = {}
	for i, id in ipairs(d.Equipped) do
		local p = PetData.Pets[id]
		if p then
			table.insert(pets, { id = id, dmg = p.Damage, nextAtk = os.clock() + 1 + i * 0.25 })
		end
	end
	local maxhp = Stats.MaxHealth(d)
	local run = {
		player = player,
		slot = slot,
		center = arena.Center,
		arenaModel = arena.Model,
		pets = pets,
		hp = maxhp,
		maxhp = maxhp,
		wave = 0,
		cleared = 0,
		kills = 0,
		bosses = 0,
		total = 0,
		enemies = {},
		bossDrops = {},
		coins = { Kills = 0, Waves = 0, Bosses = 0 },
		ending = false,
		endDeadline = 0,
		finished = false,
		startTime = os.clock(),
		nextStatus = 0,
	}
	runs[player] = run
	player:SetAttribute("InArena", true)
	char:PivotTo(arena.Center * CF(0, 5, 0))
	fire(player, "RunStart", { Slot = slot, MaxHP = maxhp, Center = arena.Center.Position })
	task.spawn(runLoop, run)
	return true
end

-- END RUN button: stop spawning, let pets finish the current wave (short grace), then pay out
function CombatService.RequestEnd(player)
	local run = runs[player]
	if not run or run.ending or run.finished then
		return
	end
	run.ending = true
	run.endDeadline = os.clock() + C.EndRunGrace
	Net.Toast(player, "Run ending - your pets are finishing the fight...", "info")
end

-- player left the game: pay out immediately
function CombatService.ForceEnd(player)
	local run = runs[player]
	if run then
		CombatService.Finish(run, "left")
	end
end

function CombatService.Init()
	Net.Get("EndRun").OnServerEvent:Connect(function(player)
		CombatService.RequestEnd(player)
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.05 then
			return
		end
		local step = acc
		acc = 0
		local now = os.clock()
		for _, run in pairs(runs) do
			if not run.finished then
				stepRun(run, step, now)
			end
		end
	end)
end

return CombatService
end

----------------------------------------------------------------------
-- module: ShopService
----------------------------------------------------------------------
Defs.ShopService = function()
-- Upgrades, potions, crafting, daily rewards, pet index rewards and tutorial completion. Server authoritative.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = Mod("Config")
local PetData = Mod("PetData")
local Net = Mod("Net")
local Stats = Mod("Stats")
local DataService = Mod("DataService")

local ShopService = {}

local function describe(b)
	local parts = {}
	if b.Coins then
		table.insert(parts, "+" .. Config.Format(b.Coins) .. " coins")
	end
	for _, m in ipairs(Config.MaterialOrder) do
		if b[m] then
			table.insert(parts, "+" .. b[m] .. " " .. Config.Materials[m].Name)
		end
	end
	if b.Potions then
		for _, k in ipairs(Config.PotionOrder) do
			if b.Potions[k] then
				table.insert(parts, "+" .. b.Potions[k] .. " " .. Config.Potions[k].Name)
			end
		end
	end
	return table.concat(parts, ", ")
end

local function usePotion(player, kind)
	local d = DataService.Get(player)
	if not d or type(kind) ~= "string" or not Config.Potions[kind] then
		return
	end
	if not Net.Throttle(player, "Potion", 0.25) then
		return
	end
	if d.Potions[kind] <= 0 then
		return Net.Toast(player, "You don't have that potion!", "error")
	end
	d.Potions[kind] -= 1
	d.Active[kind] = math.max(d.Active[kind], os.time()) + Config.PotionDuration
	Net.Toast(player, Config.Potions[kind].Name .. " activated!", "good")
	DataService.Push(player)
end

local function buyUpgrade(player, key)
	local d = DataService.Get(player)
	if not d or type(key) ~= "string" or not Config.UpgradeByKey[key] then
		return
	end
	if not Net.Throttle(player, "Upgrade", 0.2) then
		return
	end
	local level = d.Upgrades[key]
	local cost = Config.UpgradeCost(key, level)
	if not cost then
		return Net.Toast(player, "Already at max level!", "error")
	end
	if d.Coins < cost then
		return Net.Toast(player, "Not enough coins!", "error")
	end
	d.Coins -= cost
	d.Upgrades[key] = level + 1
	Net.Toast(player, Config.UpgradeByKey[key].Name .. " upgraded to level " .. (level + 1) .. "!", "good")
	DataService.Push(player)
end

local function craft(player, key)
	local d = DataService.Get(player)
	if not d or type(key) ~= "string" then
		return
	end
	if not Net.Throttle(player, "Craft", 0.25) then
		return
	end
	local recipe
	for _, r in ipairs(Config.Craft) do
		if r.Key == key then
			recipe = r
		end
	end
	if not recipe then
		return
	end
	for mat, n in pairs(recipe.Cost) do
		if d.Materials[mat] < n then
			return Net.Toast(player, "Not enough " .. Config.Materials[mat].Name .. "!", "error")
		end
	end
	for mat, n in pairs(recipe.Cost) do
		d.Materials[mat] -= n
	end
	if recipe.Give.Potions then
		DataService.Give(d, { Potions = recipe.Give.Potions })
	end
	if recipe.Give.CoinsFromIncome then
		-- "CoinsFromIncome" = that many seconds of your current passive income (at least 1000 coins)
		local coins = math.max(1000, math.floor(Stats.IncomePerSecond(d) * recipe.Give.CoinsFromIncome))
		DataService.AddCoins(d, coins)
		Net.Toast(player, "Crafted " .. recipe.Name .. ": +" .. Config.Format(coins) .. " coins", "good")
	else
		Net.Toast(player, "Crafted " .. recipe.Name .. "!", "good")
	end
	DataService.Push(player)
end

local function claimDaily(player)
	local d = DataService.Get(player)
	if not d or not Net.Throttle(player, "Daily", 0.5) then
		return
	end
	local now = os.time()
	local last = d.Daily.Last
	if last ~= 0 and now - last < Config.DailyCooldown then
		return Net.Toast(player, "Your next daily reward isn't ready yet!", "error")
	end
	local streak
	if last == 0 or now - last > Config.DailyStreakWindow then
		streak = 1
	else
		streak = d.Daily.Streak + 1
	end
	local day = (streak - 1) % #Config.Daily + 1
	local reward = Config.Daily[day]
	DataService.Give(d, reward)
	d.Daily.Last = now
	d.Daily.Streak = streak
	Net.Toast(player, "Daily reward (day " .. day .. "): " .. describe(reward), "good")
	DataService.Push(player)
end

local function claimIndex(player, key)
	local d = DataService.Get(player)
	if not d or type(key) ~= "string" or #key > 20 then
		return
	end
	if not Net.Throttle(player, "Index", 0.3) then
		return
	end
	if d.IndexClaimed[key] then
		return Net.Toast(player, "Already claimed!", "error")
	end
	local kind, arg = string.sub(key, 1, 1), string.sub(key, 3)
	local reward, label
	if kind == "m" then
		local need = tonumber(arg)
		for _, m in ipairs(Config.IndexMilestones) do
			if m.Need == need then
				if Stats.Discovered(d) >= need then
					reward, label = m.Reward, need .. " pets discovered"
				else
					return Net.Toast(player, "Discover " .. need .. " pets first!", "error")
				end
			end
		end
	elseif kind == "r" then
		local list = PetData.ByRarity[arg]
		local r = Config.RarityRewards[arg]
		if list and r then
			for _, id in ipairs(list) do
				if not d.Discovered[tostring(id)] then
					return Net.Toast(player, "Discover every " .. arg .. " pet first!", "error")
				end
			end
			reward, label = r, arg .. " collection complete"
		end
	end
	if not reward then
		return
	end
	d.IndexClaimed[key] = true
	DataService.Give(d, reward)
	Net.Toast(player, label .. "! " .. describe(reward), "good")
	DataService.Push(player)
end

function ShopService.Init()
	Net.Get("UsePotion").OnServerEvent:Connect(usePotion)
	Net.Get("BuyUpgrade").OnServerEvent:Connect(buyUpgrade)
	Net.Get("Craft").OnServerEvent:Connect(craft)
	Net.Get("ClaimDaily").OnServerEvent:Connect(claimDaily)
	Net.Get("ClaimIndex").OnServerEvent:Connect(claimIndex)
	Net.Get("TutorialDone").OnServerEvent:Connect(function(player)
		local d = DataService.Get(player)
		if d and not d.Tutorial then
			d.Tutorial = true
			DataService.Push(player)
		end
	end)
end

return ShopService
end

return {
	Get = Mod,
	Has = function(n)
		return Defs[n] ~= nil
	end,
}
]]></ProtectedString></Properties>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX9"><Properties><string name="Name">ServerScriptService</string></Properties>
<Item class="Script" referent="RBX8"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- Script named "GameServer"
-- Location: ServerScriptService > GameServer
-- Hub builder and the server boot code.

local Defs, Cache = {}, {}
local Finders = {
	function() return require(game:GetService("ReplicatedStorage"):WaitForChild("GameShared")) end,
	function() return require(game:GetService("ReplicatedStorage"):WaitForChild("GameSharedArt")) end,
	function() return require(game:GetService("ServerStorage"):WaitForChild("ServerLogic")) end,
}

local function Mod(name)
	local c = Cache[name]
	if c == nil then
		local f = Defs[name]
		if f then
			c = f()
		else
			for _, find in ipairs(Finders) do
				local b = find()
				if b.Has(name) then
					c = b.Get(name)
					break
				end
			end
		end
		if c == nil then
			error("Unknown module: " .. tostring(name))
		end
		Cache[name] = c
	end
	return c
end

----------------------------------------------------------------------
-- module: HubBuilder
----------------------------------------------------------------------
Defs.HubBuilder = function()
-- Builds the whole main hub with code (no manual building needed): ground, paths, roll machine,
-- portal, shop, daily chest, pet house, pet index book, leaderboard, trees, lamps, lighting.

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = Mod("Config")

local HubBuilder = {}

local V3, CF = Vector3.new, CFrame.new
local rad = math.rad
local BLOCK, BALL, CYL = Enum.PartType.Block, Enum.PartType.Ball, Enum.PartType.Cylinder
local M = Enum.Material
local rng = Random.new(2026)

local function col(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local root -- folder holding everything

-- generic part: P(size, cf, color, material, shape, parent)
local function P(size, cf, color, mat, shape, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or M.SmoothPlastic
	p.Shape = shape or BLOCK
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent or root
	return p
end

-- upright cylinder helper (axis = Y)
local function Cyl(h, d, pos, color, mat, parent)
	return P(V3(h, d, d), CF(pos) * CFrame.Angles(0, 0, math.pi / 2), color, mat, CYL, parent)
end

local function Ball(d, pos, color, mat, parent)
	return P(V3(d, d, d), CF(pos), color, mat, BALL, parent)
end

local function noCollide(p)
	p.CanCollide = false
	return p
end

-- text floating above a station
local function sign(parent, text, pos, w, h, color)
	local anchor = P(V3(0.5, 0.5, 0.5), CF(pos), col(255, 255, 255), M.SmoothPlastic, BLOCK, parent)
	anchor.Transparency = 1
	anchor.CanCollide = false
	anchor.CanQuery = false
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(w or 16, h or 4)
	gui.MaxDistance = 190
	gui.LightInfluence = 0
	gui.Parent = anchor
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamBlack
	lbl.TextScaled = true
	lbl.Text = text
	lbl.TextColor3 = color or col(255, 255, 255)
	lbl.TextStrokeTransparency = 0
	lbl.TextStrokeColor3 = col(20, 20, 40)
	lbl.Parent = gui
	return anchor
end

-- invisible anchor with a ProximityPrompt (client opens the matching menu)
local function prompt(parent, pos, action, actionText, objectText, dist)
	local a = P(V3(1, 1, 1), CF(pos), col(255, 255, 255), M.SmoothPlastic, BLOCK, parent)
	a.Transparency = 1
	a.CanCollide = false
	a.CanQuery = false
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = actionText
	pp.ObjectText = objectText
	pp.HoldDuration = 0
	pp.MaxActivationDistance = dist or 16
	pp.RequiresLineOfSight = false
	pp:SetAttribute("Action", action)
	pp.Parent = a
	return pp
end

-- models tagged "Spin" are rotated smoothly on every client (see Effects.lua)
local function spin(model, speed, axis)
	CollectionService:AddTag(model, "Spin")
	model:SetAttribute("SpinSpeed", speed)
	model:SetAttribute("SpinAxis", axis or "Y")
end

local function newModel(name, parent, pivotPos)
	local m = Instance.new("Model")
	m.Name = name
	local pv = P(V3(0.2, 0.2, 0.2), CF(pivotPos), col(255, 255, 255), M.SmoothPlastic, BLOCK, m)
	pv.Name = "Pivot"
	pv.Transparency = 1
	pv.CanCollide = false
	pv.CanQuery = false
	m.PrimaryPart = pv
	m.Parent = parent or root
	return m
end

----------------------------------------------------------------------------- lighting
local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.6
	Lighting.Ambient = col(110, 115, 140)
	Lighting.OutdoorAmbient = col(130, 135, 160)
	Lighting.ColorShift_Top = col(255, 240, 210)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4
	for _, c in ipairs(Lighting:GetChildren()) do
		if c:IsA("Atmosphere") or c:IsA("BloomEffect") or c:IsA("ColorCorrectionEffect") or c:IsA("SunRaysEffect") then
			c:Destroy()
		end
	end
	local atm = Instance.new("Atmosphere")
	atm.Density = 0.28
	atm.Offset = 0.12
	atm.Color = col(190, 215, 255)
	atm.Decay = col(255, 220, 190)
	atm.Glare = 0.2
	atm.Haze = 1.2
	atm.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.35
	bloom.Size = 22
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.18
	cc.Contrast = 0.08
	cc.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.08
	rays.Spread = 0.6
	rays.Parent = Lighting
end

----------------------------------------------------------------------------- ground and paths
local function buildGround()
	local g = P(V3(380, 2, 380), CF(0, -1, 0), col(96, 190, 98), M.Grass)
	g.Name = "Ground"
	-- lighter grass patches
	for i = 1, 26 do
		local d = rng:NextNumber(14, 34)
		local patch = Cyl(0.1, d, V3(rng:NextNumber(-170, 170), 0.05, rng:NextNumber(-170, 170)), col(110, 205, 108), M.Grass)
		patch.CanCollide = false
	end
	-- border wall (visible) + invisible barrier
	for _, s in ipairs({ -1, 1 }) do
		P(V3(380, 5, 3), CF(0, 2.5, s * 190), col(120, 120, 140), M.Cobblestone)
		P(V3(3, 5, 380), CF(s * 190, 2.5, 0), col(120, 120, 140), M.Cobblestone)
		local b1 = P(V3(380, 90, 2), CF(0, 45, s * 190), col(255, 255, 255))
		b1.Transparency = 1
		local b2 = P(V3(2, 90, 380), CF(s * 190, 45, 0), col(255, 255, 255))
		b2.Transparency = 1
	end

	local stone = col(206, 198, 184)
	local dark = col(176, 168, 156)
	-- plaza and main road
	Cyl(0.4, 64, V3(0, 0.2, 0), stone, M.Cobblestone).Name = "Plaza"
	Cyl(0.45, 44, V3(0, 0.22, 0), dark, M.Cobblestone)
	P(V3(15, 0.4, 200), CF(0, 0.2, -16), stone, M.Cobblestone)
	-- cross paths to the stations
	P(V3(130, 0.4, 10), CF(0, 0.2, -24), stone, M.Cobblestone)
	P(V3(130, 0.4, 10), CF(0, 0.2, 30), stone, M.Cobblestone)
	-- station plazas
	local stations = { { -62, -24, col(255, 205, 90) }, { 62, -24, col(255, 140, 190) }, { -62, 30, col(120, 190, 255) }, { 62, 30, col(190, 150, 255) } }
	for _, s in ipairs(stations) do
		Cyl(0.4, 34, V3(s[1], 0.2, s[2]), stone, M.Cobblestone)
		local ring = Cyl(0.5, 30, V3(s[1], 0.24, s[2]), s[3], M.SmoothPlastic)
		ring.Transparency = 0.45
	end
	-- portal courtyard
	P(V3(60, 0.4, 36), CF(0, 0.2, -122), col(70, 60, 96), M.Slate)
	P(V3(54, 0.45, 30), CF(0, 0.22, -122), col(88, 76, 120), M.Marble)
	-- spawn pad
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "HubSpawn"
	spawn.Anchored = true
	spawn.Size = V3(12, 0.5, 12)
	spawn.CFrame = CF(Config.Hub.SpawnPosition.X, 0.45, Config.Hub.SpawnPosition.Z)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Color = col(255, 215, 90)
	spawn.Material = M.Neon
	spawn.Transparency = 0.55
	spawn.Parent = root
end

----------------------------------------------------------------------------- roll machine
local function buildRollMachine()
	local m = Instance.new("Model")
	m.Name = "RollMachine"
	m.Parent = root
	local metal = col(52, 48, 78)
	local purple = col(150, 90, 255)
	Cyl(1.6, 16, V3(0, 1.0, 0), metal, M.Metal, m)
	Cyl(0.5, 17.5, V3(0, 0.4, 0), col(255, 205, 80), M.Metal, m)
	Cyl(5, 11, V3(0, 4.3, 0), col(120, 70, 210), M.SmoothPlastic, m)
	Cyl(0.7, 12, V3(0, 7.0, 0), col(255, 205, 80), M.Metal, m)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		Ball(1.1, V3(math.cos(a) * 5.6, 4.3, math.sin(a) * 5.6), purple, M.Neon, m)
	end
	local dome = Ball(14, V3(0, 12.5, 0), col(200, 230, 255), M.Glass, m)
	dome.Transparency = 0.55
	dome.CanCollide = false
	Cyl(0.6, 14.5, V3(0, 7.6, 0), col(255, 205, 80), M.Metal, m)
	-- spinning gumballs inside the dome
	local balls = newModel("MachineBalls", m, V3(0, 12.5, 0))
	local palette = { col(255, 90, 90), col(255, 190, 60), col(90, 220, 120), col(80, 170, 255), col(190, 100, 255), col(255, 120, 200), col(255, 255, 255) }
	for i = 1, 22 do
		local dir = V3(rng:NextNumber(-1, 1), rng:NextNumber(-0.7, 1), rng:NextNumber(-1, 1))
		if dir.Magnitude < 0.1 then
			dir = V3(1, 0, 0)
		end
		local pos = V3(0, 12.5, 0) + dir.Unit * rng:NextNumber(0, 4.4)
		local b = Ball(rng:NextNumber(1.6, 2.4), pos, palette[rng:NextInteger(1, #palette)], M.Neon, balls)
		b.CanCollide = false
		b.Transparency = 0.1
	end
	spin(balls, 40, "Y")
	local core = Ball(3.2, V3(0, 12.5, 0), col(255, 255, 255), M.Neon, m)
	core.Transparency = 0.35
	core.CanCollide = false
	local light = Instance.new("PointLight")
	light.Range = 40
	light.Brightness = 2.5
	light.Color = purple
	light.Parent = core
	-- coin dispenser
	P(V3(5, 3, 3), CF(0, 2.6, -7.2), col(255, 205, 80), M.Metal, BLOCK, m)
	P(V3(3.2, 1.6, 0.4), CF(0, 2.6, -8.8), col(20, 20, 30), M.SmoothPlastic, BLOCK, m)
	local sp = Instance.new("ParticleEmitter")
	sp.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sp.Rate = 14
	sp.Lifetime = NumberRange.new(1.2, 2.2)
	sp.Speed = NumberRange.new(2, 5)
	sp.SpreadAngle = Vector2.new(180, 180)
	sp.LightEmission = 1
	sp.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	sp.Color = ColorSequence.new(purple, col(255, 205, 80))
	sp.Parent = core
	sign(m, "🎲 ROLL PETS", V3(0, 24, 0), 22, 5, col(255, 235, 140))
	prompt(m, V3(0, 3, -9), "Roll", "Roll Pets", "Pet Machine", 20)
end

----------------------------------------------------------------------------- stations
local function buildShop(cx, cz)
	local m = Instance.new("Model")
	m.Name = "Shop"
	m.Parent = root
	local wood = col(150, 100, 60)
	P(V3(16, 4, 4), CF(cx, 2, cz), wood, M.Wood, BLOCK, m)
	P(V3(17, 0.6, 5), CF(cx, 4.2, cz), col(235, 205, 150), M.Wood, BLOCK, m)
	for _, s in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -1, 1 }) do
			P(V3(0.8, 12, 0.8), CF(cx + s * 8, 6, cz + z * 3.5), wood, M.Wood, BLOCK, m)
		end
	end
	for i = 0, 7 do
		local c = (i % 2 == 0) and col(235, 70, 80) or col(250, 245, 240)
		P(V3(2.2, 0.6, 9.5), CF(cx - 7.7 + i * 2.2, 12.4, cz - 0.2) * CFrame.Angles(rad(-14), 0, 0), c, M.Fabric, BLOCK, m)
	end
	-- goods on the counter
	for i = 0, 3 do
		local cols = { col(255, 90, 90), col(90, 220, 120), col(90, 170, 255), col(255, 200, 70) }
		Cyl(1.4, 1.6, V3(cx - 5 + i * 3.4, 5.3, cz - 0.4), cols[i + 1], M.Glass, m)
		Ball(0.9, V3(cx - 5 + i * 3.4, 6.4, cz - 0.4), cols[i + 1], M.Neon, m)
	end
	sign(m, "🛒 UPGRADE SHOP", V3(cx, 17, cz), 18, 4.2, col(255, 200, 200))
	prompt(m, V3(cx, 3, cz - 5), "Shop", "Open Shop", "Upgrades", 16)
end

local function buildDaily(cx, cz)
	local m = Instance.new("Model")
	m.Name = "DailyChest"
	m.Parent = root
	local gold = col(255, 205, 70)
	P(V3(9, 4.5, 6), CF(cx, 2.25, cz), col(140, 85, 50), M.Wood, BLOCK, m)
	P(V3(9.4, 1, 6.4), CF(cx, 4.6, cz), gold, M.Metal, BLOCK, m)
	P(V3(6.2, 4.4, 4.4), CF(cx, 5.2, cz) * CFrame.Angles(0, math.pi / 2, 0), col(160, 100, 60), M.Wood, CYL, m)
	for _, x in ipairs({ -3.4, 0, 3.4 }) do
		P(V3(0.9, 4.8, 6.6), CF(cx + x, 2.4, cz), gold, M.Metal, BLOCK, m)
	end
	P(V3(1.4, 1.8, 0.5), CF(cx, 3.6, cz - 3.3), col(255, 255, 255), M.Metal, BLOCK, m)
	local glow = Ball(4, V3(cx, 8.5, cz), col(255, 240, 150), M.Neon, m)
	glow.Transparency = 0.5
	glow.CanCollide = false
	local em = Instance.new("ParticleEmitter")
	em.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	em.Rate = 18
	em.Lifetime = NumberRange.new(1, 2)
	em.Speed = NumberRange.new(3, 6)
	em.SpreadAngle = Vector2.new(30, 30)
	em.EmissionDirection = Enum.NormalId.Top
	em.LightEmission = 1
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	em.Color = ColorSequence.new(gold)
	em.Parent = glow
	for i = 1, 3 do
		local a = i / 3 * math.pi * 2
		Ball(1.6, V3(cx + math.cos(a) * 7, 1, cz + math.sin(a) * 7), gold, M.Metal, m)
	end
	sign(m, "🎁 DAILY REWARDS", V3(cx, 14, cz), 19, 4.2, col(255, 235, 150))
	prompt(m, V3(cx, 3, cz - 5), "Daily", "Claim Reward", "Daily Chest", 16)
end

local function buildPetHouse(cx, cz)
	local m = Instance.new("Model")
	m.Name = "PetHouse"
	m.Parent = root
	P(V3(15, 9, 12), CF(cx, 4.5, cz), col(250, 225, 190), M.SmoothPlastic, BLOCK, m)
	for _, s in ipairs({ -1, 1 }) do
		P(V3(9.4, 0.8, 14), CF(cx + s * 3.9, 11, cz) * CFrame.Angles(0, 0, rad(-s * 35)), col(90, 150, 230), M.SmoothPlastic, BLOCK, m)
	end
	P(V3(4, 6.5, 0.5), CF(cx, 3.3, cz - 6.1), col(130, 80, 50), M.Wood, BLOCK, m)
	Ball(0.5, V3(cx + 1.3, 3.3, cz - 6.5), col(255, 205, 70), M.Metal, m)
	for _, s in ipairs({ -1, 1 }) do
		P(V3(3.4, 3.4, 0.4), CF(cx + s * 5, 5.6, cz - 6.1), col(160, 215, 255), M.Glass, BLOCK, m)
		P(V3(3.8, 0.5, 0.7), CF(cx + s * 5, 3.7, cz - 6.2), col(130, 80, 50), M.Wood, BLOCK, m)
	end
	-- paw print on the roof
	Ball(2.2, V3(cx, 13.2, cz - 2.2), col(255, 255, 255), M.SmoothPlastic, m)
	for i = -1, 1 do
		Ball(0.9, V3(cx + i * 1.4, 14.4, cz - 2.6), col(255, 255, 255), M.SmoothPlastic, m)
	end
	sign(m, "🐾 MY PETS", V3(cx, 19, cz), 15, 4.2, col(190, 230, 255))
	prompt(m, V3(cx, 3, cz - 9), "Inventory", "Open Pets", "Pet House", 16)
end

local function buildIndexPodium(cx, cz)
	local m = Instance.new("Model")
	m.Name = "PetIndex"
	m.Parent = root
	Cyl(1.2, 12, V3(cx, 0.8, cz), col(88, 70, 130), M.Marble, m)
	Cyl(5, 4, V3(cx, 3.5, cz), col(120, 98, 170), M.Marble, m)
	local book = newModel("BookSpin", m, V3(cx, 9, cz))
	P(V3(7.5, 0.7, 5.5), CF(cx - 1.9, 9, cz) * CFrame.Angles(0, 0, rad(12)), col(130, 60, 200), M.SmoothPlastic, BLOCK, book)
	P(V3(7.5, 0.7, 5.5), CF(cx + 1.9, 9, cz) * CFrame.Angles(0, 0, rad(-12)), col(130, 60, 200), M.SmoothPlastic, BLOCK, book)
	P(V3(6.9, 0.4, 5), CF(cx - 1.9, 9.45, cz) * CFrame.Angles(0, 0, rad(12)), col(250, 245, 230), M.SmoothPlastic, BLOCK, book)
	P(V3(6.9, 0.4, 5), CF(cx + 1.9, 9.45, cz) * CFrame.Angles(0, 0, rad(-12)), col(250, 245, 230), M.SmoothPlastic, BLOCK, book)
	Ball(1.6, V3(cx, 11.4, cz), col(255, 205, 70), M.Neon, book)
	spin(book, 25, "Y")
	local em = Instance.new("ParticleEmitter")
	em.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	em.Rate = 10
	em.Lifetime = NumberRange.new(1, 2)
	em.Speed = NumberRange.new(2, 4)
	em.SpreadAngle = Vector2.new(180, 180)
	em.LightEmission = 1
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
	em.Color = ColorSequence.new(col(255, 205, 70), col(200, 140, 255))
	em.Parent = book.PrimaryPart
	sign(m, "📖 PET INDEX", V3(cx, 16, cz), 15, 4.2, col(225, 200, 255))
	prompt(m, V3(cx, 3, cz - 6), "Index", "Open Pet Index", "Collection Book", 16)
end

----------------------------------------------------------------------------- portal
local function buildPortal(onTouched)
	local m = Instance.new("Model")
	m.Name = "FightPortal"
	m.Parent = root
	local z = Config.Hub.PortalPosition.Z
	local stone = col(70, 60, 100)
	local glow = col(180, 90, 255)
	for _, s in ipairs({ -1, 1 }) do
		P(V3(7, 36, 7), CF(s * 17.5, 18, z), stone, M.Slate, BLOCK, m)
		P(V3(9, 3, 9), CF(s * 17.5, 1.5, z), col(52, 46, 78), M.Slate, BLOCK, m)
		P(V3(9, 3, 9), CF(s * 17.5, 37, z), col(52, 46, 78), M.Slate, BLOCK, m)
		for i = 0, 4 do
			P(V3(0.5, 3, 0.5), CF(s * 17.5 - s * 3.7, 6 + i * 6, z), glow, M.Neon, BLOCK, m)
		end
		Ball(3, V3(s * 17.5, 41, z), glow, M.Neon, m)
		local l = Instance.new("PointLight")
		l.Range = 36
		l.Brightness = 3
		l.Color = glow
		l.Parent = m:FindFirstChildWhichIsA("BasePart")
	end
	P(V3(46, 6, 8), CF(0, 39, z), stone, M.Slate, BLOCK, m)
	P(V3(30, 3, 8.4), CF(0, 36, z), col(52, 46, 78), M.Slate, BLOCK, m)
	for i = -3, 3 do
		P(V3(2, 6 - math.abs(i) * 0.8, 2), CF(i * 6, 45 + (3 - math.abs(i)) * 0.8, z), glow, M.Neon, BLOCK, m).Transparency = 0.1
	end
	-- swirling gate
	local swirl = newModel("Swirl", m, V3(0, 17, z))
	local layers = { { 30, col(110, 40, 200), 0.25 }, { 25, col(170, 80, 255), 0.35 }, { 19, col(230, 130, 255), 0.4 }, { 13, col(255, 190, 255), 0.45 }, { 7, col(255, 255, 255), 0.5 } }
	for _, l in ipairs(layers) do
		local d = P(V3(0.6, l[1], l[1]), CF(0, 17, z) * CFrame.Angles(0, math.pi / 2, 0), l[2], M.Neon, CYL, swirl)
		d.Transparency = l[3]
		d.CanCollide = false
	end
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local arm = P(V3(1.2, 11, 0.5), CF(math.cos(a) * 7, 17 + math.sin(a) * 7, z + 0.4) * CFrame.Angles(0, 0, a + 0.6), col(255, 255, 255), M.Neon, BLOCK, swirl)
		arm.Transparency = 0.35
		arm.CanCollide = false
	end
	spin(swirl, 60, "Z")
	local sp = Instance.new("ParticleEmitter")
	sp.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sp.Rate = 30
	sp.Lifetime = NumberRange.new(1.5, 2.5)
	sp.Speed = NumberRange.new(4, 9)
	sp.SpreadAngle = Vector2.new(60, 60)
	sp.EmissionDirection = Enum.NormalId.Front
	sp.LightEmission = 1
	sp.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
	sp.Color = ColorSequence.new(col(230, 130, 255), col(130, 200, 255))
	sp.Parent = swirl.PrimaryPart
	-- trigger zone
	local trig = P(V3(26, 30, 6), CF(0, 15, z + 1), col(255, 255, 255), M.SmoothPlastic, BLOCK, m)
	trig.Name = "PortalTrigger"
	trig.Transparency = 1
	trig.CanCollide = false
	trig.CanQuery = false
	trig.Touched:Connect(function(hit)
		local plr = Players:GetPlayerFromCharacter(hit.Parent)
		if plr then
			onTouched(plr)
		end
	end)
	sign(m, "⚔️ FIGHT PORTAL", V3(0, 52, z), 28, 6, col(255, 190, 255))
	local pp = prompt(m, V3(0, 3, z + 14), "Portal", "Enter Portal", "Fight Arena", 18)
	pp.Triggered:Connect(onTouched)
	-- crystals in the courtyard
	for i = 1, 8 do
		local s = (i % 2 == 0) and 1 or -1
		local x = s * (26 + (i % 4) * 6)
		local c = P(V3(2.5, 8 + (i % 3) * 3, 2.5), CF(x, 4, z + 6 + (i % 3) * 5) * CFrame.Angles(rad(8), rad(i * 40), rad(12)), col(170, 100, 255), M.Neon, BLOCK, m)
		c.Transparency = 0.15
		c.CanCollide = false
	end
end

----------------------------------------------------------------------------- leaderboard
local function buildLeaderboard(cx, cz)
	local m = Instance.new("Model")
	m.Name = "Leaderboard"
	m.Parent = root
	local face = V3(cx + 40, 11, cz - 30)
	local board = P(V3(26, 20, 1.2), CFrame.lookAt(V3(cx, 12, cz), face), col(28, 26, 48), M.SmoothPlastic, BLOCK, m)
	board.Name = "Board"
	for _, s in ipairs({ -1, 1 }) do
		local pp = board.Position + board.CFrame.RightVector * (s * 11)
		P(V3(1.6, 20, 1.6), CF(pp.X, 10, pp.Z) + board.CFrame.LookVector * 0.9, col(70, 60, 96), M.Metal, BLOCK, m)
	end
	local trim = P(V3(27.4, 21.4, 0.8), board.CFrame * CF(0, 0, 0.3), col(255, 205, 80), M.Metal, BLOCK, m)
	trim.CanCollide = false
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	sg.CanvasSize = Vector2.new(520, 400)
	sg.LightInfluence = 0
	sg.Parent = board
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 54)
	title.BackgroundColor3 = col(60, 40, 110)
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.Text = "🏆 BEST WAVE - TOP 10"
	title.TextColor3 = col(255, 225, 120)
	title.Parent = sg
	local rows = {}
	for i = 1, 10 do
		local r = Instance.new("TextLabel")
		r.Position = UDim2.new(0, 14, 0, 58 + (i - 1) * 33)
		r.Size = UDim2.new(1, -28, 0, 31)
		r.BackgroundTransparency = (i % 2 == 0) and 0.8 or 1
		r.BackgroundColor3 = col(255, 255, 255)
		r.Font = Enum.Font.GothamBold
		r.TextScaled = true
		r.TextXAlignment = Enum.TextXAlignment.Left
		r.TextColor3 = i == 1 and col(255, 215, 80) or (i == 2 and col(220, 225, 235) or (i == 3 and col(235, 160, 100) or col(255, 255, 255)))
		r.Text = i .. ".  ..."
		r.Parent = sg
		rows[i] = r
	end
	return rows
end

----------------------------------------------------------------------------- decoration
local function nearStation(x, z)
	local pts = { { 0, 0, 40 }, { -62, -24, 24 }, { 62, -24, 24 }, { -62, 30, 24 }, { 62, 30, 24 }, { -30, 62, 24 }, { 0, -128, 52 } }
	for _, p in ipairs(pts) do
		if (x - p[1]) ^ 2 + (z - p[2]) ^ 2 < p[3] ^ 2 then
			return true
		end
	end
	return false
end

local function onPath(x, z)
	if math.abs(x) < 12 and z > -110 and z < 90 then
		return true
	end
	if math.abs(z + 24) < 9 and math.abs(x) < 90 then
		return true
	end
	if math.abs(z - 30) < 9 and math.abs(x) < 90 then
		return true
	end
	return false
end

local function tree(x, z, big)
	local m = Instance.new("Model")
	m.Name = "Tree"
	m.Parent = root
	local h = big and rng:NextNumber(9, 12) or rng:NextNumber(6, 8)
	Cyl(h, 1.8, V3(x, h / 2, z), col(120, 80, 50), M.Wood, m)
	local greens = { col(70, 170, 80), col(86, 190, 90), col(60, 150, 90), col(120, 200, 80) }
	local g = greens[rng:NextInteger(1, #greens)]
	local s = big and 1.35 or 1
	noCollide(Ball(9 * s, V3(x, h + 3 * s, z), g, M.Grass, m))
	noCollide(Ball(7 * s, V3(x + 1.5, h + 6.5 * s, z - 1), g:Lerp(col(255, 255, 255), 0.1), M.Grass, m))
	noCollide(Ball(5.5 * s, V3(x - 2, h + 8.5 * s, z + 1), g:Lerp(col(255, 255, 255), 0.2), M.Grass, m))
end

local function buildDecor()
	-- trees
	local placed = 0
	local tries = 0
	while placed < 46 and tries < 600 do
		tries += 1
		local x, z = rng:NextNumber(-175, 175), rng:NextNumber(-175, 85)
		if not onPath(x, z) and not nearStation(x, z) and not (z < -100 and math.abs(x) < 40) then
			tree(x, z, placed % 4 == 0)
			placed += 1
		end
	end
	-- flowers
	local fcols = { col(255, 110, 150), col(255, 220, 90), col(255, 255, 255), col(160, 130, 255), col(255, 150, 80) }
	for _ = 1, 140 do
		local x, z = rng:NextNumber(-175, 175), rng:NextNumber(-175, 90)
		if not onPath(x, z) and not nearStation(x, z) then
			noCollide(Ball(rng:NextNumber(0.8, 1.3), V3(x, 0.45, z), fcols[rng:NextInteger(1, #fcols)], M.SmoothPlastic))
			noCollide(Cyl(0.5, 0.18, V3(x, 0.15, z), col(70, 150, 70), M.SmoothPlastic))
		end
	end
	-- lamp posts along the main road and cross paths
	local function lamp(x, z)
		Cyl(10, 0.6, V3(x, 5, z), col(50, 50, 70), M.Metal)
		local bulb = Ball(2.2, V3(x, 10.6, z), col(255, 235, 150), M.Neon)
		bulb.Transparency = 0.1
		local l = Instance.new("PointLight")
		l.Range = 30
		l.Brightness = 1.4
		l.Color = col(255, 220, 150)
		l.Parent = bulb
	end
	for z = 70, -100, -30 do
		lamp(-9.5, z)
		lamp(9.5, z)
	end
	for x = -80, 80, 32 do
		if math.abs(x) > 12 then
			lamp(x, -30)
			lamp(x, 36)
		end
	end
	-- welcome arch near spawn
	for _, s in ipairs({ -1, 1 }) do
		P(V3(3, 26, 3), CF(s * 14, 13, 46), col(120, 80, 190), M.SmoothPlastic)
		Ball(3.4, V3(s * 14, 27, 46), col(255, 205, 80), M.Neon)
	end
	P(V3(31, 10, 2), CF(0, 24, 46), col(40, 30, 80), M.SmoothPlastic)
	sign(root, "ROLL A PET AND FIGHT!", V3(0, 24, 44.5), 30, 8, col(255, 225, 120))
	-- floating clouds
	for _ = 1, 14 do
		local cx, cy, cz = rng:NextNumber(-260, 260), rng:NextNumber(90, 140), rng:NextNumber(-260, 260)
		for k = 1, 4 do
			local c = Ball(rng:NextNumber(16, 28), V3(cx + k * 12, cy + rng:NextNumber(-3, 3), cz + rng:NextNumber(-6, 6)), col(255, 255, 255), M.SmoothPlastic)
			c.Transparency = 0.2
			c.CanCollide = false
			c.CastShadow = false
		end
	end
	-- benches
	for _, b in ipairs({ { -20, 14 }, { 20, 14 }, { -20, -50 }, { 20, -50 } }) do
		P(V3(6, 0.6, 2), CF(b[1], 1.6, b[2]), col(150, 100, 60), M.Wood)
		P(V3(6, 2, 0.4), CF(b[1], 2.8, b[2] + 1), col(150, 100, 60), M.Wood)
		for _, s in ipairs({ -1, 1 }) do
			P(V3(0.5, 1.6, 1.6), CF(b[1] + s * 2.5, 0.8, b[2]), col(60, 60, 80), M.Metal)
		end
	end
end

----------------------------------------------------------------------------- public
-- onPortal(player) is called when someone touches the portal / uses its prompt.
-- Returns { LeaderboardRows = {TextLabel x10} }
function HubBuilder.Build(onPortal)
	local old = Workspace:FindFirstChild("Hub")
	if old then
		old:Destroy()
	end
	root = Instance.new("Folder")
	root.Name = "Hub"
	root.Parent = Workspace

	setupLighting()
	buildGround()
	buildRollMachine()
	buildShop(-62, -24)
	buildDaily(62, -24)
	buildPetHouse(-62, 30)
	buildIndexPodium(62, 30)
	buildPortal(onPortal)
	local rows = buildLeaderboard(-30, 62)
	buildDecor()
	return { LeaderboardRows = rows }
end

return HubBuilder
end

----------------------------------------------------------------------
-- main
----------------------------------------------------------------------
-- Boots every server system, loads/saves players and wires the hub together.

local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = Mod("Config")
local Net = Mod("Net") -- creates the RemoteEvents

local DataService = Mod("DataService")
local PetService = Mod("PetService")
local ShopService = Mod("ShopService")
local CombatService = Mod("CombatService")
local HubBuilder = Mod("HubBuilder")
local Leaderboard = Mod("Leaderboard")

-- 1. world
local hub = HubBuilder.Build(function(player)
	CombatService.StartRun(player)
end)
Leaderboard.Init(hub.LeaderboardRows)

-- 2. systems
DataService.Init()
PetService.Init()
ShopService.Init()
CombatService.Init()

-- 3. remotes that belong to the hub itself
Net.Get("Ready").OnServerEvent:Connect(function(player)
	DataService.PushNow(player)
end)

Net.Get("WarpToPortal").OnServerEvent:Connect(function(player)
	if player:GetAttribute("InArena") or not Net.Throttle(player, "Warp", 1.5) then
		return
	end
	local char = player.Character
	if char and char.Parent then
		char:PivotTo(CFrame.new(Config.Hub.PortalFront + Vector3.new(math.random(-4, 4), 2, 10)))
	end
end)

-- 4. players
local function onCharacterAdded(player, char)
	if CombatService.GetRun(player) then
		task.wait(0.2)
		CombatService.PlaceInArena(player)
	end
end

local function onPlayerAdded(player)
	player.CharacterAdded:Connect(function(char)
		onCharacterAdded(player, char)
	end)
	local data = DataService.Load(player)
	if not data then
		return
	end
	DataService.PushNow(player)
end

local function onPlayerRemoving(player)
	CombatService.ForceEnd(player) -- pays out an unfinished run before saving
	DataService.Release(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

-- server shutdown: pay out running fights first, then save again (DataService also saves on close)
game:BindToClose(function()
	for _, p in ipairs(Players:GetPlayers()) do
		CombatService.ForceEnd(p)
		task.spawn(DataService.Save, p)
	end
	task.wait(2)
end)
]]></ProtectedString></Properties>
